local function position(instance)
    if not instance or not instance.Parent then return nil end
    if instance:IsA("Attachment") then return instance.WorldPosition end
    if instance:IsA("BasePart") then return instance.Position end
    if instance:IsA("Model") then
        local part = instance.PrimaryPart or instance:FindFirstChildWhichIsA("BasePart", true)
        return part and part.Position
    end
    return nil
end

local function plotBounds(plot)
    if not plot or not plot:IsDescendantOf(Workspace) then return nil end
    local cached = boundsCache[plot]
    if cached and os.clock() - cached.time < 4 then return cached.cf, cached.size end
    if plot:IsA("Model") then
        local ok, cf, size = pcall(function() return plot:GetBoundingBox() end)
        if ok and size.Magnitude > 0 then
            boundsCache[plot] = { cf = cf, size = size, time = os.clock() }
            return cf, size
        end
    end
    -- The live scan uses Folders for restaurants. Compute their streamed AABB.
    local low, high
    for _, part in ipairs(plot:GetDescendants()) do
        if part:IsA("BasePart") then
            local cf, half = part.CFrame, part.Size * 0.5
            local right, up, forward = cf.RightVector, cf.UpVector, cf.LookVector
            local extent = Vector3.new(
                math.abs(right.X) * half.X + math.abs(up.X) * half.Y + math.abs(forward.X) * half.Z,
                math.abs(right.Y) * half.X + math.abs(up.Y) * half.Y + math.abs(forward.Y) * half.Z,
                math.abs(right.Z) * half.X + math.abs(up.Z) * half.Y + math.abs(forward.Z) * half.Z)
            local a, b = part.Position - extent, part.Position + extent
            low = low and Vector3.new(math.min(low.X, a.X), math.min(low.Y, a.Y), math.min(low.Z, a.Z)) or a
            high = high and Vector3.new(math.max(high.X, b.X), math.max(high.Y, b.Y), math.max(high.Z, b.Z)) or b
        end
    end
    if low then
        local cf, size = CFrame.new((low + high) * 0.5), high - low
        boundsCache[plot] = { cf = cf, size = size, time = os.clock() }
        return cf, size
    end
    return nil
end

local function plotDistance(plot, point)
    local cf, size = plotBounds(plot)
    if not cf then return math.huge, math.huge end
    local offset = cf:PointToObjectSpace(point)
    local outside = Vector3.new(math.max(0, math.abs(offset.X) - size.X / 2),
        math.max(0, math.abs(offset.Y) - size.Y / 2), math.max(0, math.abs(offset.Z) - size.Z / 2))
    return outside.Magnitude, (point - cf.Position).Magnitude
end

local function nearestPlot(point)
    local best, bestOutside, bestCenter = nil, math.huge, math.huge
    for _, plot in ipairs(plots) do
        local outside, center = plotDistance(plot, point)
        if outside < bestOutside or (outside == bestOutside and center < bestCenter) then
            best, bestOutside, bestCenter = plot, outside, center
        end
    end
    return best, bestOutside
end

local function npcOf(instance)
    local folder = Workspace:FindFirstChild("ClientNPCs")
    if not folder then return nil end
    return Features.resolveNPC(instance, folder)
end

local function ownershipMatches(npc)
    for _, key in ipairs({ "OwnerUserId", "PlayerUserId" }) do
        local owner = npc:GetAttribute(key)
        if owner ~= nil and tostring(owner) ~= tostring(player.UserId) then return false end
    end
    for _, key in ipairs({ "RestaurantName", "PlotName" }) do
        local name = npc:GetAttribute(key)
        if name ~= nil and (not selectedPlot or tostring(name) ~= selectedPlot.Name) then return false end
    end
    return true
end

local function npcInPlot(npc)
    if not selectedPlot or not ownershipMatches(npc) then return false end
    local target = position(npc)
    if not target then return false end
    local nearest, outside = nearestPlot(target)
    return nearest == selectedPlot and outside <= CONFIG.NPCBoundaryPadding
end

local function inScope(prompt)
    if not selectedPlot or not selectedPlot:IsDescendantOf(Workspace) then return false end
    if prompt:IsDescendantOf(selectedPlot) then return true end
    local npc = npcOf(prompt)
    return npc ~= nil and npcInPlot(npc)
end

local function fingerprint(prompt)
    local state = prompts[prompt]
    return prompt.ActionText .. "\0" .. prompt.ObjectText .. "\0" .. tostring(prompt.Enabled)
        .. "\0" .. tostring(state and state.generation or 0)
end

local function classify(prompt)
    local context, ancestor = {}, prompt.Parent
    for _ = 1, 5 do
        if not ancestor or ancestor == Workspace or ancestor == selectedPlot then break end
        table.insert(context, ancestor.Name)
        ancestor = ancestor.Parent
    end
    local contextText = table.concat(context, " ")
    if npcOf(prompt) then contextText ..= " customer" end
    local category, reason = Policy.classify(prompt.ActionText, prompt.ObjectText, contextText, CONFIG.PromptOverrides)
    local text = " " .. Policy.normalize(prompt.ActionText .. " " .. prompt.ObjectText .. " " .. contextText) .. " "
    if category == "clean" and (text:find(" trash ", 1, true) or text:find(" garbage ", 1, true)) then return "trash", reason end
    return category, reason
end

local function eligiblePrompt(prompt)
    local category = classify(prompt)
    if not category or not categories[category] then return false end
    if operations then
        local text = " " .. Policy.normalize(prompt.ActionText .. " " .. prompt.ObjectText) .. " "
        if (text:find(" ihaw ", 1, true) or text:find(" grill ", 1, true)) and not operations.Settings.autoIhaw then return false end
        if (text:find(" drink ", 1, true) or text:find(" softdrink ", 1, true)) and not operations.Settings.autoDrinks then return false end
        if category == "trash" then
            local count = player:GetAttribute("TrashCount")
            if type(count) == "number" and count >= 0 then trashTrip = count end
            local disposal = text:find(" throw ", 1, true) or text:find(" dispose ", 1, true) or text:find(" empty ", 1, true) or text:find(" drop ", 1, true)
            if not disposal and trashTrip >= operations.Settings.trashPerTrip then return false end
        end
    end
    if category == "trash" and not inScope(prompt) then
        local inTrashFolder = false
        for _, name in ipairs({ "TrashOutside", "GlobalTrashSpawner" }) do
            local folder = Workspace:FindFirstChild(name)
            if folder and prompt:IsDescendantOf(folder) then inTrashFolder = true; break end
        end
        local _, root = character()
        local target = position(prompt.Parent)
        if not inTrashFolder or not root or not target or (target - root.Position).Magnitude > CONFIG.TrashRadius then return false end
    elseif not inScope(prompt) then return false end
    if category == "accept" then
        local npc = npcOf(prompt)
        if npc and operations and operations.Settings.rejectMissing and
            (npc:GetAttribute("MissingIngredients") == true or npc:GetAttribute("IngredientsMissing") == true or npc:GetAttribute("HasIngredients") == false) then return false end
        local rarity = npc and Features.rarity(npc)
        if rarity then observedRarities[rarity] = true end
        return Features.rarityAllowed(rarity, filterEnabled, allowedRarities, allowUnknown)
    end
    return true
end

local function index(instance)
    if instance:IsA("ProximityPrompt") then
        if not prompts[instance] then
            local state = RetryState.new(os.clock())
            state.connections = {}
            prompts[instance] = state
            for _, property in ipairs({ "Enabled", "ActionText", "ObjectText", "HoldDuration" }) do
                table.insert(state.connections, instance:GetPropertyChangedSignal(property):Connect(function()
                    -- Observe transitions even while navigation or prompt input is yielding.
                    RetryState.changed(state, os.clock())
                end))
            end
        end
    elseif (instance:IsA("Model") or instance:IsA("Folder"))
        and instance.Name:lower():match("^kar[ie]nderya%d*$") then
        if not table.find(plots, instance) then table.insert(plots, instance) end
    end
end

local function unindex(instance)
    local state = prompts[instance]
    if state then
        for _, connection in ipairs(state.connections) do connection:Disconnect() end
        prompts[instance] = nil
    end
end

local function selectPlot(plot)
    api:Stop()
    table.clear(trackedNPCs)
    table.clear(runaways)
    selectedPlot = plot
    log(plot and ("Selected " .. plot.Name .. ". Check the plot, then Start.") or "No plot found. Walk into your restaurant and Rescan.")
end

function api:SelectPlot(name)
    for _, plot in ipairs(plots) do
        if plot.Name == name and plot:IsDescendantOf(Workspace) then selectPlot(plot); return true end
    end
    log("Plot not found: " .. tostring(name))
    return false
end

function api:SelectNearestPlot()
    local _, root = character()
    if root then selectPlot(nearestPlot(root.Position)) end
end

function api:Rescan()
    self:Stop()
    for instance in pairs(prompts) do
        if not instance:IsDescendantOf(Workspace) then unindex(instance) end
    end
    plots = {}
    for i, instance in ipairs(Workspace:GetDescendants()) do
        if not alive then return end
        index(instance)
        if i % 600 == 0 then task.wait() end
    end
    table.sort(plots, function(a, b) return a.Name < b.Name end)
    for _, state in pairs(prompts) do RetryState.changed(state, os.clock()) end
    if CONFIG.RestaurantName ~= "" and self:SelectPlot(CONFIG.RestaurantName) then return end
    if selectedPlot and selectedPlot:IsDescendantOf(Workspace) then selectPlot(selectedPlot); return end
    local _, root = character()
    selectPlot(root and nearestPlot(root.Position) or nil)
end

local function current(token, prompt, signature, guard)
    return alive and running and revision == token and prompt:IsDescendantOf(Workspace)
        and prompt.Enabled and fingerprint(prompt) == signature and (guard and guard() or (not guard and eligiblePrompt(prompt)))
end

local function inRange(prompt, root)
    local target = position(prompt.Parent)
    local distance = utilities and utilities:ActivationDistance(prompt) or prompt.MaxActivationDistance
    return target and (target - root.Position).Magnitude <= math.max(0, distance - 0.5)
end

local function sight(prompt, model, root)
    if not prompt.RequiresLineOfSight then return true end
    local target = position(prompt.Parent)
    if not target then return false end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local owner = prompt.Parent
    if owner:IsA("Attachment") then owner = owner.Parent end
    params.FilterDescendantsInstances = { model, owner }
    local camera = Workspace.CurrentCamera
    local origin = camera and camera.CFrame.Position or root.Position
    local hit = Workspace:Raycast(origin, target - origin, params)
    return not hit
end

local function moveToPrompt(prompt, token, signature, guard)
    local model, root, humanoid = character()
    if not root or humanoid.Sit then return false, "Character is unavailable or seated" end
    local target = position(prompt.Parent)
    if not target then return false, "Prompt has no world position" end
    if (target - root.Position).Magnitude > CONFIG.MaxTravel then return false, "Target exceeds travel limit" end
    local deadline = os.clock() + CONFIG.MoveTimeout
    for _ = 1, 2 do
        if not current(token, prompt, signature, guard) or player.Character ~= model then return false, "Cancelled" end
        if inRange(prompt, root) and sight(prompt, model, root) then return true end
        target = position(prompt.Parent)
        if not target then return false, "Target disappeared" end
        local toward = Vector3.new(root.Position.X - target.X, 0, root.Position.Z - target.Z)
        if toward.Magnitude < 0.1 then toward = Vector3.new(1, 0, 0) end
        local activationDistance = utilities and utilities:ActivationDistance(prompt) or prompt.MaxActivationDistance
        local stopDistance = math.clamp(activationDistance * 0.55, 1, 5)
        local approach = target + toward.Unit * stopDistance
        local groundParams = RaycastParams.new()
        groundParams.FilterType = Enum.RaycastFilterType.Exclude
        groundParams.FilterDescendantsInstances = { model, prompt.Parent }
        local ground = Workspace:Raycast(approach + Vector3.new(0, 6, 0), Vector3.new(0, -24, 0), groundParams)
        local destination = ground and ground.Position or Vector3.new(approach.X, root.Position.Y - 2, approach.Z)
        local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
        local computed = pcall(function() path:ComputeAsync(root.Position, destination) end)
        if not current(token, prompt, signature, guard) or os.clock() > deadline then return false, "Cancelled or path timed out" end
        if not computed or path.Status ~= Enum.PathStatus.Success then return false, "No walkable path" end
        local blocked, waypointIndex = false, 1
        local blockedConnection = path.Blocked:Connect(function(indexAt) if indexAt >= waypointIndex then blocked = true end end)
        for i, waypoint in ipairs(path:GetWaypoints()) do
            waypointIndex = i
            if not current(token, prompt, signature, guard) or player.Character ~= model or humanoid.Health <= 0 then break end
            if inRange(prompt, root) and sight(prompt, model, root) then break end
            if waypoint.Action == Enum.PathWaypointAction.Jump then humanoid.Jump = true end
            humanoid:MoveTo(waypoint.Position)
            local stepDeadline = math.min(deadline, os.clock() + 3)
            repeat
                task.wait(0.08)
            until blocked or not current(token, prompt, signature, guard) or player.Character ~= model
                or humanoid.Health <= 0 or os.clock() >= stepDeadline
                or (root.Position - waypoint.Position).Magnitude < 3
                or (inRange(prompt, root) and sight(prompt, model, root))
            if blocked or os.clock() >= stepDeadline or player.Character ~= model or humanoid.Health <= 0 then break end
        end
        blockedConnection:Disconnect()
        if current(token, prompt, signature, guard) and player.Character == model and humanoid.Health > 0
            and inRange(prompt, root) and sight(prompt, model, root) then
            humanoid:MoveTo(root.Position)
            return true
        end
        if os.clock() >= deadline then break end
    end
    return false, "Could not reach prompt"
end

local function trigger(prompt, token, signature, guard, beforeInput)
    local model, root, humanoid = character()
    if not root or not current(token, prompt, signature, guard) or not inRange(prompt, root)
        or not sight(prompt, model, root) then return false, "Prompt is no longer reachable" end
    if prompt.HoldDuration > CONFIG.HoldTimeout then return false, "Hold exceeds time limit" end
    if beforeInput and not beforeInput() then return false, "Action changed before input" end
    heldPrompt = prompt
    local ok, err = pcall(function() prompt:InputHoldBegin() end)
    if not ok then release(); return false, tostring(err) end
    attempted += 1
    local untilTime = os.clock() + math.max(0.12, prompt.HoldDuration + 0.15)
    repeat
        task.wait(0.05)
        if not current(token, prompt, signature, guard) or player.Character ~= model or humanoid.Health <= 0
            or not inRange(prompt, root) or not sight(prompt, model, root) then break end
    until os.clock() >= untilTime
    if heldPrompt == prompt then
        heldPrompt = nil
        pcall(function() prompt:InputHoldEnd() end)
    end
    -- An input attempt is not a server acknowledgment. Only report attempts.
    return true
end

local function nextPrompt()
    local _, root = character()
    if not root then return nil, 0 end
    local best, bestScore, eligible = nil, -math.huge, 0
    local now = os.clock()
    for prompt, state in pairs(prompts) do
        if not prompt:IsDescendantOf(Workspace) then
            unindex(prompt)
        elseif prompt.Enabled and eligiblePrompt(prompt) then
            local category = classify(prompt)
            local target = position(prompt.Parent)
            if category and categories[category] and target then
                local distance = (target - root.Position).Magnitude
                if distance <= CONFIG.MaxTravel then
                    eligible += 1
                    if state.nextAt <= now and state.tries < CONFIG.MaxUnchangedAttempts then
                        local score = Policy.score(category == "trash" and "clean" or category, distance, now - state.seenAt)
                        if score > bestScore then best, bestScore = prompt, score end
                    end
                end
            end
        end
    end
    return best, eligible
end

