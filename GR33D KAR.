    return true
end
function api:Stop()
    if not alive then return end
    local wasRunning = running; running = false
    -- Drain each producer separately so their combined stop-time burst cannot
    -- evict still-pending records from another producer in a healthy journal.
    journal:Flush(128)
    capture:Stop(); journal:Flush(128)
    motion:Stop(); journal:Flush(128)
    objectObserver:Stop(); disconnectErrors()
    if wasRunning then
        record("info", "session.stop", "Observation stopped; saving pending log entries",
            { remoteCapture = capture:Stats(), motion = motion:State(), serverAcceptance = "Not observable", antiCheatStatus = "Not observable" })
    end
    journal:Flush(128)
end
function api:Rescan()
    if alive then objectObserver:Rescan() end
end
function api:SetOption(key, value)
    if type(value) ~= "boolean" or options[key] == nil then return false end
    options[key] = value
    record("info", "option.changed", key .. " = " .. tostring(value))
    if key == "incoming" or key == "outgoing" then configureCapture()
    elseif key == "errors" then connectErrors()
    elseif key == "movement" or key == "interactions" then motion:Reconfigure(); objectObserver:Reconfigure()
    else objectObserver:Reconfigure() end
    return true
end
function api:SetFilter(value)
    if type(value) ~= "string" then return false end
    filter = value:sub(1, 160)
    -- This is a display filter. Hidden rows/events continue to be recorded.
    return true
end
function api:Mark(value)
    record("info", "marker", type(value) == "string" and value:sub(1, 256) or "Manual marker",
        { running = running, meaning = "User-supplied timing marker; not source attribution" })
end
function api:ClearView() journal:ClearView() end
function api:Save()
    journal:Flush(128)
    capture:Flush(64)
    local ok, reason = journal:Flush(128)
    status = ok and "Pending events saved; earlier files retained" or tostring(reason)
    return ok and journal:ShowFile() or status
end
function api:ShowFiles()
    local text = journal:ShowFile()
    if #sourceExports > 0 then text ..= "\nSource exports:\n" .. table.concat(sourceExports, "\n") end
    local clipboard = env.setclipboard or setclipboard
    if type(clipboard) == "function" then pcall(clipboard, text) end
    status = text
    return text
end
function api:InspectSelected(id)
    local result, reason = objectObserver:Inspect(id)
    if result then selected = result
    else selected = nil; record("warning", "object.inspect", tostring(reason)) end
    return result ~= nil
end
function api:ExportSource(id)
    local source, path = objectObserver:Source(id)
    if not source then record("warning", "source.export", path); return false end
    local writer = env.writefile or writefile
    if type(writer) ~= "function" then record("error", "source.export", "Source export unavailable: writefile is missing"); return false end
    sourceSequence += 1
    local filename = "universal-inspector-" .. session .. string.format("-source%04d.luau", sourceSequence)
    local ok, result = pcall(writer, filename, source)
    if not ok or result == false then record("error", "source.export", "Could not write the selected source file"); return false end
    table.insert(sourceExports, filename)
    if #sourceExports > 16 then table.remove(sourceExports, 1) end
    record("info", "source.export", filename, { scriptPath = path, bytes = #source, source = "Readable Source property; unchanged text" })
    return true
end
function api:GetState()
    local state = journal:State()
    local events = {}
