local function containers() local out = {} if Me.Character then table.insert(out, Me.Character) end local bp = Me:FindFirstChild("Backpack") if bp then table.insert(out, bp) end return out end
local function charParts() local char = Me.Character local hrp = char and char:FindFirstChild("HumanoidRootPart") local hum = char and char:FindFirstChildOfClass("Humanoid") if hrp and hum and hum.Health > 0 then return char, hrp, hum end return nil, nil, nil end

local MOVE = { owner = nil, saved = nil }
local function freezeWalk() local _, _, hum = charParts() if hum and not MOVE.saved then MOVE.saved = { hum.WalkSpeed, hum.JumpPower, hum.JumpHeight } hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0 end end
local function thawWalk() local hum = Me.Character and Me.Character:FindFirstChildOfClass("Humanoid") if MOVE.saved and hum then hum.WalkSpeed = MOVE.saved[1] > 0 and MOVE.saved[1] or 16 hum.JumpPower = MOVE.saved[2] > 0 and MOVE.saved[2] or 50 hum.JumpHeight = MOVE.saved[3] > 0 and MOVE.saved[3] or 7.2 end MOVE.saved = nil end

local PRIO = { runaway = false, want = {} }
local PRIO_ORDER = { runaway = 1, drink = 2, serve = 3, collect = 4, ihaw = 5, trash = 6, angpao = 7, decor = 8 }
local function wants(owner) PRIO.want[owner] = os.clock() end
local function isRunawayActive() return PRIO.runaway end

local function gateOK(owner)
    if PRIO.runaway and owner ~= "runaway" then return false, "runaway" end
    local rank, now = PRIO_ORDER[owner] or 99, os.clock()
    for o, t in pairs(PRIO.want) do
        local r = PRIO_ORDER[o]
        if o ~= owner and r and r < rank and now - t < 1.5 then return false, o end
    end
    return true
end

local function withMove(owner, fn)
    local allowed, blocker = gateOK(owner)
    if not allowed then return false, "waiting: " .. tostring(blocker) end
    if MOVE.owner and MOVE.owner ~= owner then return false, "busy: " .. MOVE.owner end
    MOVE.owner = owner freezeWalk() local ok, x, y = pcall(fn) thawWalk() MOVE.owner = nil
    if not ok then error(x, 0) end return true, x, y
end

local function pressPromptFast(prompt, isServing)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local oldDist = prompt.MaxActivationDistance
    pcall(function() prompt.MaxActivationDistance = isServing and 1000 or 50 end)
    local time = math.max((prompt.HoldDuration or 0) + 0.05, 0.1)
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(time)
    pcall(function() prompt:InputHoldEnd() end)
    task.wait(0.1)
    pcall(function() prompt.MaxActivationDistance = oldDist end)
    return true
end

local function floorUnder(x, z, fromY)
    local ex = {}
    if Me.Character then table.insert(ex, Me.Character) end
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = ex
    local from = Vector3.new(x, fromY, z)
    for _ = 1, 5 do
        local r = Workspace:Raycast(from, Vector3.new(0, -80, 0), p)
        if not r then return nil end
        if r.Instance.CanCollide then return r.Position.Y end
        table.insert(ex, r.Instance)
        p.FilterDescendantsInstances = ex
    end
    return nil
end

local function standNear(pos, dist)
    local _, hrp, hum = charParts()
    if not hrp or not pos or not finite(pos) then return nil end
    dist = dist or 1.5
    local v = Vector3.new(hrp.Position.X - pos.X, 0, hrp.Position.Z - pos.Z)
    local dir = v.Magnitude > 0.1 and v.Unit or Vector3.new(0, 0, 1)
    local x, z = pos.X + dir.X * dist, pos.Z + dir.Z * dist
    local rootH = math.max(3, ((hum and hum.HipHeight) or 2) + hrp.Size.Y / 2)
    local fy = floorUnder(x, z, pos.Y + 3)
    local y = (fy and math.abs(fy - pos.Y) <= 8) and (fy + rootH) or hrp.Position.Y
    local sp = Vector3.new(x, y, z)
    return CFrame.lookAt(sp, Vector3.new(pos.X, y, pos.Z))
end

-- STRICT SINGLE-SNAP: Sets CFrame exactly ONCE. No bunny-hop, no intermediate steps.
local function safeTeleportCF(cf)
    local _, hrp = charParts()
    if not hrp then return false, "no character" end
    hrp.CFrame = cf
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
    task.wait(0.15) -- let server register the snap
    return true
end

local function safeTeleport(pos, maxRange)
    local _, hrp = charParts()
    if not hrp or not pos then return false, "no position" end
    local maxR = (maxRange and maxRange > 0) and maxRange or 10
    local reach = maxR - 1.5
    
    if (hrp.Position - pos).Magnitude <= reach then return true end
    
    local cf = standNear(pos, CFG.STAND_DIST)
    if not cf then return false, "no floor spot" end
    return safeTeleportCF(cf)
end

local function press(prompt) return pressPromptFast(prompt, false) end
local function fire(prompt) if fireproximityprompt then pcall(fireproximityprompt, prompt) end end

local function inReach(prompt)
    local _, hrp = charParts()
    local pos = promptAnchor(prompt)
    if not hrp or not pos then return false end
    local maxR = prompt.MaxActivationDistance
    if maxR <= 0 then maxR = 10 end
    return (hrp.Position - pos).Magnitude <= math.max(maxR - 1.5, 1.5)
end

local function goToPrompt(prompt)
    local pos = promptAnchor(prompt)
    if not pos then return false, "no position" end
    if not inReach(prompt) then
        local maxR = prompt.MaxActivationDistance
        if maxR <= 0 then maxR = 10 end
        local ok = safeTeleport(pos, maxR)
        if not ok then return false, "teleport failed" end
    end
    return true
end

