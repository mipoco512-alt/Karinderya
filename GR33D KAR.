-- AUTO HIRE (Dishwasher + Server only)
--==========================================================================
local HIRE = { seen = setmetatable({}, { __mode = "k" }), cache = {}, cacheAt = -math.huge, fullFail = {} }
local function openRoles() local out = {} for _, r in ipairs(ROLES) do if not H.filled[r] then table.insert(out, r) end end return out end
local function rolesText() local parts = {} for _, r in ipairs(ROLES) do table.insert(parts, r:sub(1, 1) .. (H.filled[r] and "+" or "-")) end return table.concat(parts, " ") end
local function canRoll()
    local now = os.clock() local keep = {} for _, t in ipairs(H.rolls) do if now - t < 60 then table.insert(keep, t) end end H.rolls = keep local last = keep[#keep] or -math.huge return #keep < CFG.ROLL_PER_MIN and now - last >= CFG.ROLL_COOLDOWN
end
local function rejectWorker(name)
    if remote("RejectWorker") then fireRemote("RejectWorker", name) end
    if remote("FireNpcWorker") then fireRemote("FireNpcWorker", name) end
    if remote("FireStaff") then fireRemote("FireStaff", name) end
    log("hire", "rejected " .. name, THEME.red)
end
local function scanWorkers()
    if os.clock() - HIRE.cacheAt < 0.8 then
        local keep = {}
        for _, w in ipairs(HIRE.cache) do if w.model:IsDescendantOf(Workspace) then table.insert(keep, w) end end
        HIRE.cache = keep
        return keep
    end
    HIRE.cacheAt = os.clock()
    local out = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and (obj.Name:find("WorkerSpawn", 1, true) or obj.Name:find("_Worker", 1, true)) then
            local base = obj.Name:match("^([^_]+)_")
            local rar = rarityOf(base)
            if rar then
                table.insert(out, { model = obj, name = obj.Name, base = base, rarity = rar })
            elseif base and not H.unknown[base] then
                H.unknown[base] = true
                log("hire", "unknown worker '" .. base .. "' - add it to RARITY", THEME.orange)
            end
        end
    end
    HIRE.cache = out
    return out
end
local function targetsFor()
    local now, out = os.clock(), {}
    for _, w in ipairs(scanWorkers()) do
        if not HIRE.seen[w.model] then HIRE.seen[w.model] = now end
        if REJECT_LIST[w.rarity] then
            if not H.rejected[w.name] then
                H.rejected[w.name] = true
                rejectWorker(w.name)
            end
        elseif (H.targetRarity == "Any" or w.rarity == H.targetRarity)
            and not H.hired[w.name] and (H.blocked[w.name] or 0) <= now then
            table.insert(out, w)
        end
    end
    return out
end
local function hireWith(w, role)
    local reply = "no answer"
    for _ = 1, 3 do
        if not w.model:IsDescendantOf(Workspace) then return true end
        local ok, res = invoke("HireWorker", w.name, role)
        reply = ok and summarize(res) or ("error: " .. tostring(res))
        if res == true or (type(res) == "table" and (res.Success or res.success or res.Hired)) then return true end
        if waitFor(function() return not w.model:IsDescendantOf(Workspace) end, 0.4) then return true end
    end
    return false, reply
end
local function hireTick()
    H.staffSource = "workspace (v6.3 method)"
    if #openRoles() == 0 then
        M.hire.status = "all roles filled (" .. rolesText() .. ")"
        return 3
    end
    local now = os.clock()
    local targets = targetsFor()
    H.waiting = #targets
    if #targets == 0 then
        if canRoll() then
            table.insert(H.rolls, now)
            H.lastRoll = now
            local ok, res = invoke("RollWorker", "Roll")
            local reply = ok and summarize(res) or ("error: " .. tostring(res))
            if reply ~= H.lastRollReply then log("hire", "RollWorker -> " .. reply, THEME.gold) end
            H.lastRollReply = reply
            M.hire.status = "rolled " .. H.targetRarity .. ", looking for it"
            waitFor(function() return #targetsFor() > 0 end, 1.5)
            return 0.1
        end
        M.hire.status = "watching for " .. H.targetRarity .. " (roll budget)"
        return 0.8
    end
    table.sort(targets, function(a, b) return (RANK[a.rarity] or 9) < (RANK[b.rarity] or 9) end)
    local w = targets[1]
    local age = now - (HIRE.seen[w.model] or now)
    if age < 0.3 then task.wait(0.3 - age) end
    for _, role in ipairs(openRoles()) do
        M.hire.status = "hiring " .. w.base .. " as " .. role
        local ok, why = hireWith(w, role)
        if ok then
            H.filled[role] = true
            H.hired[w.name] = true
            HIRE.fullFail[w.name] = nil
            log("hire", string.format("hired %s (%s) as %s", w.base, w.rarity, role), THEME.green)
            M.hire.status = "hired " .. w.base .. " as " .. role
            return 0.1
        end
        log("hire", string.format("%s as %s not accepted: %s", w.base, role, tostring(why)), THEME.orange)
    end
    HIRE.fullFail[w.name] = (HIRE.fullFail[w.name] or 0) + 1
    if HIRE.fullFail[w.name] >= 3 then
        HIRE.fullFail[w.name] = nil
        H.blocked[w.name] = now + 30
        log("hire", w.base .. " refused on every open role - skipped, rolling again", THEME.orange)
    else
        task.wait(0.4)
    end
    M.hire.status = "no role accepted " .. w.base
    return 0.1
end

