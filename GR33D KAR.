local function release()
    if activeTween then activeTween:Cancel(); activeTween = nil end
    if activeTool then pcall(function() activeTool:Deactivate() end); activeTool = nil end
    if activeHumanoid then
        pcall(function() activeHumanoid.AutoRotate = savedAutoRotate end)
        activeHumanoid, savedAutoRotate = nil, nil
    end
    if weaponRestore then
