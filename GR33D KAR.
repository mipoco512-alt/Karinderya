local function normName(s) return (tostring(s):lower():gsub("[^%w]", "")) end
local function trim(s) return (s:gsub("^%s+", ""):gsub("%s+$", "")) end
local function finite(v) return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e5 end
local function hasWord(s, words) for _, w in ipairs(words) do if s:find(w, 1, true) then return true end end return false end
local function waitFor(fn, timeout) local t0 = os.clock() repeat local v = fn() if v then return v end task.wait(0.05) until os.clock() - t0 >= timeout return nil end
local function countKeys(t) local n = 0 for _ in pairs(t) do n += 1 end return n end
local function summarize(v, depth) depth = depth or 0 local t = typeof(v) if t == "Instance" then return v.ClassName .. ":" .. v.Name end if t ~= "table" then return tostring(v) end if depth >= 2 then return "{...}" end local parts, n = {}, 0 for k, val in pairs(v) do n += 1 if n > 8 then table.insert(parts, "...") break end table.insert(parts, tostring(k) .. "=" .. summarize(val, depth + 1)) end return "{" .. table.concat(parts, ", ") .. "}" end

local function anchorOf(inst)
    if not inst then return nil end
    if inst:IsA("Attachment") then return inst.WorldPosition end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then local ok, cf = pcall(function() return inst:GetBoundingBox() end) if ok and cf then return cf.Position end end
    local part = inst:FindFirstChildWhichIsA("BasePart", true)
    return part and part.Position or nil
end

local function promptAnchor(prompt)
    local p = prompt and prompt.Parent
    if not p then return nil end
    if p:IsA("Attachment") then return p.WorldPosition end
    if p:IsA("BasePart") then return p.Position end
    local spotPart, foodPart, first
    for _, d in ipairs(p:GetDescendants()) do
        if d:IsA("BasePart") then
            local n = normName(d.Name)
            if n:find("spot", 1, true) or n:find("anchor", 1, true) or n:find("place", 1, true) then
                spotPart = spotPart or d
            elseif n:find("food", 1, true) or n:find("dish", 1, true) or n:find("cooked", 1, true) or n:find("meal", 1, true) then
                foodPart = foodPart or d
            end
            first = first or d
        end
    end
    if spotPart then return spotPart.Position end
    if foodPart then return foodPart.Position end
    if first then return first.Position end
    return anchorOf(p)
end

local function parseAny(v, out, depth, seen)
    if v == nil or depth > 5 then return end
    local t = typeof(v)
    if t == "Instance" then local pos = anchorOf(v) if pos and finite(pos) then table.insert(out, { pos = pos, inst = v }) end
    elseif t == "Vector3" then if finite(v) then table.insert(out, { pos = v }) end
    elseif t == "CFrame" then if finite(v.Position) then table.insert(out, { pos = v.Position }) end
    elseif t == "table" then if seen[v] then return end seen[v] = true for _, val in pairs(v) do parseAny(val, out, depth + 1, seen) end end
end
local function parseReply(v) local out = {} parseAny(v, out, 0, {}) return out end

local function nearestOf(list)
    local char = Me.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local best, bestD
    for _, p in ipairs(list) do
        local pos = promptAnchor(p)
        if pos then local d = hrp and (hrp.Position - pos).Magnitude or 0 if not bestD or d < bestD then best, bestD = p, d end end
    end
    return best
end

