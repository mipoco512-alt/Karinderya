-- Universal Roblox Runtime Inspector v1.0. Read INSPECTOR.md.

local createInspectorJournal = (function()
-- Bounded, local inspection journal. Record/State never touch the filesystem.
-- Tick/Flush/Close save small batches; this module installs no hooks or network calls.
local function createInspectorJournal(ctx)
    local diagnostics = {}
    local env = type(ctx.Env) == "table" and ctx.Env or {}
    local writer = rawget(env, "writefile") or ctx.writefile or writefile
    local appender = rawget(env, "appendfile") or ctx.appendfile or appendfile
    local clock = ctx.now or os.clock
    local enabled, notifications, autosave = ctx.enabled ~= false, ctx.notifications ~= false, ctx.autosave ~= false
    local queue, history, recentFiles, taskStates, taskOrder = {}, {}, {}, {}, {}
    local sequence, saved, dropped, filesCount, dropSummaries = 0, 0, 0, 0, 0
    local pendingDrop, inFlight, inFlightDrop, busy, closed, closeRequested = nil, {}, nil, false, false, false
    local errorMessage, failed, lastFile, lastAttemptedFile, lastSave, nextSave = nil, false, nil, nil, nil, 0
    local counts = { total = 0, info = 0, warning = 0, error = 0, success = 0, debug = 0, transitions = 0 }
    local fileIndex, fileBytes, fileRows, baseWritten = 0, 0, 0, false
    local function finite(value) return type(value) == "number" and value == value and value > -math.huge and value < math.huge end
    local function limit(value, fallback, minimum, maximum)
        return finite(value) and math.clamp(math.floor(value), minimum, maximum) or fallback
    end
    local capacity = limit(ctx.maxPending, 128, 1, 128)
    local lineLimit = limit(ctx.maxLineBytes, 32768, 1024, 32768)
    local maxFileBytes = limit(ctx.maxFileBytes, 256 * 1024, lineLimit + 2048, 256 * 1024)
    local maxFileEvents = limit(ctx.maxFileEvents, 512, 1, 512)
    local function time()
        local ok, value = pcall(clock)
        return ok and finite(value) and math.max(0, value) or 0
    end
    local function sensitive(key)
        local normalized = key:lower():gsub("[^%w]", "")
        for _, word in ipairs({ "token", "secret", "password", "webhook", "cookie", "authorization", "apikey", "credential" }) do
            if normalized:find(word, 1, true) then return true end
        end
        return normalized == "key" or normalized == "auth"
    end
    local function utf8Prefix(value, maximum)
        local pieces, at, bytes = {}, 1, 0
        while at <= #value and bytes < maximum do
            local first = value:byte(at)
            local width = first < 128 and 1 or first >= 194 and first <= 223 and 2
                or first >= 224 and first <= 239 and 3 or first >= 240 and first <= 244 and 4 or 0
            local valid = width > 0 and at + width - 1 <= #value
            if valid and width > 1 then
                for offset = 1, width - 1 do
                    local byte = value:byte(at + offset)
                    if byte < 128 or byte > 191 then valid = false; break end
                end
                local second = value:byte(at + 1)
                if (first == 224 and second < 160) or (first == 237 and second > 159)
                    or (first == 240 and second < 144) or (first == 244 and second > 143) then valid = false end
            end
            if not valid then table.insert(pieces, "?"); at += 1; bytes += 1
            elseif bytes + width > maximum then break
            else
                local piece = value:sub(at, at + width - 1)
                if width == 1 and first < 32 and first ~= 9 and first ~= 10 and first ~= 13 then piece = " " end
                table.insert(pieces, piece); at += width; bytes += width
            end
        end
        return table.concat(pieces)
    end
    local function redactText(value)
        value = value:gsub("[Hh][Tt][Tt][Pp][Ss]?://%S+", "[URL removed]")
        value = value:gsub("[Bb][Ee][Aa][Rr][Ee][Rr]%s+[%w%._%-]+", "Bearer [redacted]")
        return (value:gsub("([%w_%-]+)(%s*[:=]%s*)([^%s,;]+)", function(key, separator, item)
            return key .. separator .. (sensitive(key) and "[redacted]" or item)
        end))
    end
    local function safeText(value, maximum)
        if type(value) ~= "string" then
            if finite(value) or type(value) == "boolean" then value = tostring(value) else return "[" .. type(value) .. "]" end
        end
        local originalSize = #value
        value = utf8Prefix(value:sub(1, maximum * 4), maximum * 4)
        value = redactText(value)
        local clipped = utf8Prefix(value, maximum)
        if #value > #clipped or originalSize > maximum * 4 then
            local suffix = maximum >= 14 and " [truncated]" or "<cut>"
            clipped = utf8Prefix(utf8Prefix(clipped, math.max(0, maximum - #suffix)) .. suffix, maximum)
        end
        return clipped
    end
    local function timestamp()
        local ok, value
        if type(ctx.utcNow) == "function" then ok, value = pcall(ctx.utcNow) end
        if ok and type(value) == "string" then return safeText(value, 64) end
        local formatted, result = pcall(os.date, "!%Y-%m-%dT%H:%M:%SZ", ok and finite(value) and value or os.time())
        return formatted and result or "UTC unavailable"
    end
    local function serializedKey(value)
        if type(value) == "string" then return value end
        if type(value) ~= "table" or rawget(value, "type") ~= "string" then return nil end
        local text = rawget(value, "value")
        if type(text) ~= "string" then return nil end
        if rawget(value, "encoding") ~= "hex" then return text end
        if #text > 512 or #text % 2 ~= 0 or text:find("[^%x]") then return nil end
        return (text:gsub("%x%x", function(pair) return string.char(tonumber(pair, 16)) end))
    end
    local function snapshot(value)
        local remaining, strings, seen = 512, 12288, {}
        local function visit(item, depth)
            remaining -= 1
            if remaining < 0 then return "[node limit]" end
            local kind = type(item)
            if kind == "nil" or kind == "boolean" then return item end
            if kind == "number" then return finite(item) and item or "[non-finite number]" end
            if kind == "string" then
                local maximum = math.min(2048, strings)
                if maximum <= 0 then return "[string limit]" end
                local result = safeText(item, maximum); strings -= #result; return result
            end
            if kind ~= "table" then return "[" .. kind .. "]" end
            if seen[item] then return "[circular]" end
            if depth >= 12 then return "[depth limit]" end
            seen[item] = true
            -- Encoders represent invalid UTF-8 or long strings as hex. Inspect
            -- that bounded byte payload for URLs/credentials before preserving
            -- the encoding, otherwise an encoded URL could evade redaction.
            local encodedString, hexValue, hexTruncated
            if rawget(item, "type") == "string" and rawget(item, "encoding") == "hex" then
                local hex = rawget(item, "value")
                if type(hex) == "string" then
                    local prefix = hex:sub(1, 8192)
                    if #prefix % 2 == 0 and not prefix:find("[^%x]") then
                        local decoded = prefix:gsub("%x%x", function(pair) return string.char(tonumber(pair, 16)) end)
                        local redacted = redactText(decoded)
                        if redacted ~= decoded then
                            encodedString = redacted:gsub(".", function(byte) return string.format("%02x", byte:byte()) end)
                        end
                        hexValue, hexTruncated = encodedString or prefix, #hex > #prefix
                    end
                end
            end
            -- Inspect only a bounded prefix. Array indices remain numeric so the
            -- recorder's args.values and typed table.entries stay JSON arrays.
            local sampled, array, highest = {}, true, 0
            local key, nested = next(item)
            while key ~= nil and #sampled < 33 do
                table.insert(sampled, { key, nested })
                if type(key) ~= "number" or key % 1 ~= 0 or key < 1 or key > 33 then array = false
                else highest = math.max(highest, key) end
                key, nested = next(item, key)
            end
            array = array and #sampled > 0 and highest == #sampled
            local output = {}
            if array then
                local count = math.min(32, #sampled)
                for index = 1, count do
                    if remaining <= 0 then
                        table.insert(output, { type = "truncated", reason = "node limit" }); break
                    end
                    output[index] = visit(rawget(item, index), depth + 1)
                end
                if #sampled > 32 and remaining > 0 then
                    output[32] = { type = "truncated", reason = "entry limit", omittedFrom = 32 }
                end
            else
                local keyName = serializedKey(rawget(item, "key"))
                local serializedEntry = rawget(item, "key") ~= nil and rawget(item, "value") ~= nil
                for index, pair in ipairs(sampled) do
                    if index > 32 or remaining <= 0 then output.__truncated = true; break end
                    local originalKey, value = pair[1], pair[2]
                    local keyType = type(originalKey)
                    local name = keyType == "string" and safeText(originalKey, 128)
                        or keyType == "number" and finite(originalKey) and tostring(originalKey) or "unsupported_key_" .. index
                    local redact = keyType == "string" and sensitive(originalKey)
                    -- `key` is structural in the typed {key=...,value=...}
                    -- format. Redact the associated value, not its field name.
                    if serializedEntry and originalKey == "key" then redact = false end
                    if serializedEntry and originalKey == "value" and keyName and sensitive(keyName) then redact = true end
                    if hexValue and originalKey == "value" then
                        local maximum = math.floor(math.min(4096, strings) / 2) * 2
                        output[name] = hexValue:sub(1, maximum)
                        strings -= #output[name]; remaining -= 1
                        if #hexValue > maximum then hexTruncated = true end
                    else
                        output[name] = redact and "[redacted]" or visit(value, depth + 1)
                    end
                end
                if encodedString then output.redacted = true end
                if hexTruncated then output.truncated = true end
            end
            seen[item] = nil
            return output
        end
        return visit(value, 0)
    end
    local function copy(value)
        if type(value) ~= "table" then return value end
        local result = {}; for key, item in pairs(value) do result[key] = copy(item) end; return result
    end
    local sessionId = type(ctx.sessionId) == "string" and ctx.sessionId or (tostring(os.time()) .. "-" .. tostring(math.floor(time() * 1000000)))
    sessionId = sessionId:gsub("[^%w_%-]", ""):sub(1, 80)
    if sessionId == "" then sessionId = "session-" .. tostring(os.time()) end
    local stem = "universal-inspector-" .. sessionId
    local baseFile, partsPattern = stem .. ".log", stem .. "-part*.log"
    local mode = type(writer) ~= "function" and "memory" or type(appender) == "function" and "append" or "parts"
    if mode == "memory" then errorMessage = "File logging unavailable: writefile is missing; diagnostics remain in memory." end
    local createdAt = timestamp()
    local function entry(level, action, message, details)
        return { kind = "diagnostic", timestamp = timestamp(), elapsed = time(), level = level,
            action = safeText(action or "inspection", 80), message = safeText(message or "", 1024),
            details = details ~= nil and snapshot(details) or nil, sessionId = sessionId }
    end
    local function remember(value)
        table.insert(history, value)
        if #history > 40 then table.remove(history, 1) end
    end
    local function mergeDrops(older, newer)
        if not older then return newer end
        if not newer then return older end
        return { count = older.count + newer.count, first = math.min(older.first, newer.first), last = math.max(older.last, newer.last) }
    end
    function diagnostics:Record(level, action, message, details)
        if closed or not enabled then return nil end
        level = type(level) == "string" and level:lower() or "info"
        if level == "warn" then level = "warning" end
        if counts[level] == nil or level == "total" or level == "transitions" then level = "info" end
        sequence += 1
        local value = entry(level, action, message, details); value.sequence = sequence
        counts.total += 1; counts[level] += 1
        if #queue + #inFlight >= capacity then
            local evicted = table.remove(queue, 1)
            if evicted then
                dropped += 1
                pendingDrop = mergeDrops(pendingDrop, { count = 1, first = evicted.sequence, last = evicted.sequence })
            else
                dropped += 1
                pendingDrop = mergeDrops(pendingDrop, { count = 1, first = value.sequence, last = value.sequence })
                remember(value); return copy(value)
            end
        end
        table.insert(queue, value); remember(value)
        return copy(value)
    end
    function diagnostics:ObserveTasks(taskMap, enabledMap)
        if closed or not enabled or type(taskMap) ~= "table" then return end
        local count = 0
        for key, value in next, taskMap do
            count += 1; if count > 128 then break end
            if type(key) == "string" and #key <= 512 then
                local action = safeText(key, 80)
                local reason = type(value) == "table" and rawget(value, "status") or value
                if type(reason) == "string" then
                    reason = safeText(reason, 1024)
                    local active
                    if type(enabledMap) == "table" then active = rawget(enabledMap, key) end
                    if type(active) ~= "boolean" then active = nil end
                    local signature = tostring(active) .. "\0" .. reason
                    local previous = taskStates[key]
                    if not previous or previous.signature ~= signature then
                        if not previous then
                            table.insert(taskOrder, key)
                            if #taskOrder > 128 then taskStates[table.remove(taskOrder, 1)] = nil end
                        end
                        taskStates[key] = { signature = signature, reason = reason }
                        local lower = reason:lower()
                        if active == true then
                            local blocked = lower:find("needs recording", 1, true) or lower:find("blocked", 1, true)
                                or lower:find("missing", 1, true) or lower:find("unavailable", 1, true) or lower:find("limit", 1, true)
                                or lower:find("no supported", 1, true) or lower:find("data needed", 1, true) or lower:find("unmapped", 1, true)
                            self:Record(blocked and "warning" or "info", "task:" .. action, reason,
                                { enabled = active, status = reason, previous = previous and previous.reason or nil })
                            counts.transitions += 1
                        end
                    end
                end
            end
        end
    end
    local function encode(value)
        local ok, result = pcall(function()
            if type(ctx.encode) == "function" then return ctx.encode(value) end
            return ctx.HttpService:JSONEncode(value)
        end)
        if not ok or type(result) ~= "string" or result:find("[\r\n]") then return nil end
        return result
    end
    local function line(value)
        local result = encode(value)
        if result and #result + 1 > lineLimit then
            local compact = copy(value)
            compact.details = { truncated = true, reason = "Encoded diagnostic exceeded the line limit" }
            compact.message = safeText(compact.message, math.max(64, math.floor(lineLimit / 8)))
            result = encode(compact)
        end
        if not result or #result + 1 > lineLimit then return nil end
        return result .. "\n"
    end
    local function header(part)
        return line({ kind = "session", format = "universal-inspector-journal-v1", sessionId = sessionId,
            placeId = finite(ctx.placeId) and ctx.placeId or nil, version = safeText(ctx.version or "unknown", 80),
            createdAtUTC = createdAt, mode = mode, part = part, partsPattern = partsPattern,
            note = mode == "parts" and "Send this file and every matching numbered part; events are saved in immutable batches."
                or "Automatic JSON-lines diagnostics; large sessions rotate into matching numbered parts." })
    end
    local function fail(message)
        if not failed then
            sequence += 1; counts.total += 1; counts.error += 1
            local value = entry("error", "diagnostics.storage", message,
                { pending = #queue + #inFlight, saved = saved, file = lastAttemptedFile })
            value.kind, value.sequence = "storage-error", sequence
            remember(value)
        end
        failed, errorMessage = true, message
        return false, message
    end
    local function writeFile(name, payload, append)
        lastAttemptedFile = name
        local ok, result = pcall(append and appender or writer, name, payload)
        if not ok or result == false then return fail("Diagnostic file write failed; automatic saving is paused to preserve earlier logs. Inspection can continue.") end
        lastFile, lastSave = name, timestamp()
        return true
    end
    local function rememberFile(name)
        filesCount += 1; table.insert(recentFiles, name)
        if #recentFiles > 8 then table.remove(recentFiles, 1) end
    end
    local function openFile()
        fileIndex += 1
        local name = fileIndex == 1 and baseFile or stem .. string.format("-part%06d.log", fileIndex)
        local payload = header(fileIndex)
        if not payload then return fail("Diagnostic header encoding failed; logs remain in memory.") end
        if not writeFile(name, payload, false) then return false end
        rememberFile(name); baseWritten = true; fileBytes, fileRows = #payload, 0
        return true
    end
    local function persist(lines)
        if not baseWritten and not openFile() then return false, 0 end
        local at, committed = 1, 0
        while at <= #lines do
            local payloadHeader = mode == "parts" and header(fileIndex + 1) or ""
            if payloadHeader == nil then fail("Diagnostic header encoding failed; logs remain in memory."); return false, committed end
            local usedBytes, usedRows = mode == "parts" and #payloadHeader or fileBytes, mode == "parts" and 0 or fileRows
            local payload, count = {}, 0
            while at + count <= #lines and usedRows + count < maxFileEvents do
                local item = lines[at + count]
                if usedBytes + #item > maxFileBytes then break end
                table.insert(payload, item); usedBytes += #item; count += 1
            end
            if count == 0 then
                if mode == "parts" then fail("A diagnostic entry exceeds the file size limit; logs remain in memory."); return false, committed end
                if not openFile() then return false, committed end
            else
                local name
                if mode == "parts" then
                    fileIndex += 1; name = stem .. string.format("-part%06d.log", fileIndex)
                    if not writeFile(name, payloadHeader .. table.concat(payload), false) then return false, committed end
                    rememberFile(name)
                else
                    name = fileIndex == 1 and baseFile or stem .. string.format("-part%06d.log", fileIndex)
                    if not writeFile(name, table.concat(payload), true) then return false, committed end
                    fileBytes, fileRows = usedBytes, usedRows + count
                end
                committed += count; at += count
            end
        end
        return true, committed
    end
    function diagnostics:Flush(maxEntries)
        if busy then if closeRequested then return false, "Final diagnostic save is already in progress" end; return false, "Diagnostic save in progress" end
        if failed then return false, errorMessage end
        if mode == "memory" then return fail(errorMessage) end
        local budget = limit(maxEntries, 16, 1, 128)
        if #queue == 0 and not pendingDrop then return true end
        busy = true
        local processed, success = 0, true
        while (#queue > 0 or pendingDrop) and (processed < budget or closeRequested) do
            inFlight, inFlightDrop = {}, pendingDrop; pendingDrop = nil
            local batchSize = math.min(16, budget - processed, #queue)
            if closeRequested then batchSize = math.min(16, #queue) end
            for _ = 1, batchSize do table.insert(inFlight, table.remove(queue, 1)) end
            local values = {}
            if inFlightDrop then
                local summary = entry("warning", "diagnostics.buffer", tostring(inFlightDrop.count) .. " diagnostic events dropped while waiting to save",
                    { dropped = inFlightDrop.count, firstSequence = inFlightDrop.first, lastSequence = inFlightDrop.last, capacity = capacity })
                summary.kind, summary.sequence = "drop-summary", inFlightDrop.last
                table.insert(values, summary)
            end
            for _, value in ipairs(inFlight) do table.insert(values, value) end
            local lines = {}
            for _, value in ipairs(values) do
                local encoded = line(value)
                if not encoded then fail("Diagnostic entry encoding failed; saving is paused and logs remain in memory."); success = false; break end
                table.insert(lines, encoded)
            end
            local committed = 0
            if success then success, committed = persist(lines) end
            local normalCommitted = committed
            if inFlightDrop then
                if committed > 0 then normalCommitted -= 1; dropSummaries += 1
                else pendingDrop = mergeDrops(inFlightDrop, pendingDrop) end
            end
            saved += normalCommitted; processed += normalCommitted
            for index = #inFlight, normalCommitted + 1, -1 do table.insert(queue, 1, inFlight[index]) end
            inFlight, inFlightDrop = {}, nil
            if not success then break end
        end
        busy = false
        return success, success and nil or errorMessage
    end
    function diagnostics:Tick()
        if closed or not autosave or failed or time() < nextSave then return end
        nextSave = time() + 2
        return self:Flush(16)
    end
    function diagnostics:Close()
        closed, closeRequested = true, true
        if busy then return false, "Final diagnostic save will finish with the current write" end
        return self:Flush(128)
    end
    function diagnostics:SetEnabled(value)
        if type(value) ~= "boolean" then return false end
        if value and not enabled then taskStates, taskOrder = {}, {} end
        enabled = value; return true
    end
    function diagnostics:SetNotifications(value)
        if type(value) ~= "boolean" then return false end
        notifications = value; return true
    end
    function diagnostics:ClearView() table.clear(history) end
    function diagnostics:ShowFile()
        if not lastFile and not lastAttemptedFile then return "No diagnostic log file has been written yet." end
        local message = table.concat(recentFiles, "\n")
        if message == "" then message = lastAttemptedFile end
        if mode == "parts" or filesCount > 1 then message ..= "\nInclude " .. baseFile .. " and every file matching " .. partsPattern end
        return message
    end
    function diagnostics:State()
        local totals = copy(counts); totals.saved, totals.dropped, totals.dropSummaries = saved, dropped, dropSummaries
        return { enabled = enabled, autosave = autosave and mode ~= "memory" and not failed, notifications = notifications,
            mode = mode, baseFile = baseFile, partsPattern = partsPattern, files = table.clone(recentFiles), filesCount = filesCount,
            lastFile = lastFile, saved = saved, pending = #queue + #inFlight, dropped = dropped, lastSave = lastSave,
            error = errorMessage, failed = failed, events = copy(history), latest = history[#history] and copy(history[#history]) or nil,
            counts = totals, closed = closed, saving = busy }
    end
    return diagnostics
end

return createInspectorJournal

end)()

local createInspectorCapture = (function()
-- The hook only snapshots Lua arguments and forwards the original call directly.
-- Instance methods, filtering, context and observers run later in Flush(). A
-- nested Instance namecall must never replace the game's pending method name.
-- Start observes outbound calls; SetIncludeIncoming(true) permits an incoming-
-- only fallback when hooking is unsupported. StartIncoming never installs a hook.
-- Drive Tick from the caller's update loop for bounded discovery and delivery.
-- Nothing starts automatically and no script source or return values are read.
local function createInspectorCapture(ctx)
    local BUS_KEY, VERSION = "__UniversalClientInspectorHook", "client-inspector-v1"
    -- Settings may reduce these ceilings; invalid/unbounded values use defaults.
    local ceilings = { records = 100, pending = 64, nodes = 128, strings = 4096, depth = 4, entries = 24, arguments = 32 }
    local limits = {}
    for name, maximum in pairs(ceilings) do
        local value = type(ctx.limits) == "table" and rawget(ctx.limits, name) or nil
        limits[name] = type(value) == "number" and value == value and value >= 1 and value < math.huge
            and math.min(maximum, math.floor(value)) or maximum
    end
    local MAX_RECORDS, MAX_NODES, MAX_STRINGS = limits.records, limits.nodes, limits.strings
    local MAX_DEPTH, MAX_ENTRIES, MAX_ARGUMENTS = limits.depth, limits.entries, limits.arguments
    local MAX_PENDING = limits.pending
    local env, gameObject = ctx.env or {}, ctx.game or game
    local clock = ctx.clock or os.clock
    local createdAt = clock()
    local buffer, head, count, sequence = {}, 1, 0, 0
    local dropped, total, outgoing, incoming, interactions, returns, errors = 0, 0, 0, 0, 0, 0, 0
    local recording, destroyed, generation = false, false, 0
    local queue, queueHead, queueCount, queueDropped, flushing = {}, 1, 0, 0, false
    local includeIncoming, filter, label = false, "", ""
    local attachedBus, addedConnection, removedConnection
    local incomingConnections = {}
    local recorder, sink = {}, {}

    local function copy(value)
        if type(value) ~= "table" then return value end
        local result = {}
        for key, item in next, value do result[key] = copy(item) end
        return result
    end
    local function safeTime()
        local value = clock() - createdAt
        return value == value and value >= 0 and value < math.huge and value or 0
    end
    local function number(value)
        if value ~= value then return { type = "number", value = "NaN" } end
        if value == math.huge then return { type = "number", value = "+Infinity" } end
        if value == -math.huge then return { type = "number", value = "-Infinity" } end
        return value
    end

    -- Only pure Lua operations and typeof are allowed here. Engine values are
    -- immutable references, enriched outside the game's __namecall stack. Lua
    -- tables are copied now so later gameplay mutations cannot rewrite the log.
    local function snapshotArguments(...)
        -- Reserve identity space so a large argument cannot hide its remote.
        local reservedNodes = math.min(16, math.floor(MAX_NODES / 4))
        local reservedStrings = math.min(512, math.floor(MAX_STRINGS / 4))
        local remainingNodes, remainingStrings = MAX_NODES - reservedNodes, MAX_STRINGS - reservedStrings
        local seen, deferred, nextId = {}, {}, 0
        local encode
        encode = function(value, depth)
            if remainingNodes <= 0 then return { type = "truncated", reason = "node budget" } end
            remainingNodes -= 1
            local kind = typeof(value)
            if kind == "nil" then return { type = "nil" }
            elseif kind == "boolean" then return value
            elseif kind == "number" then return number(value)
            elseif kind == "string" then
                local size = #value
                local limit = math.min(size, remainingStrings, 4096)
                remainingStrings -= limit
                if limit == size and utf8.len(value) ~= nil then return value end
                local bytes = table.create(limit)
                for index = 1, limit do bytes[index] = string.format("%02x", string.byte(value, index)) end
                return { type = "string", encoding = "hex", value = table.concat(bytes), byteLength = size, truncated = limit < size }
            elseif kind == "table" then
                if seen[value] then return { type = "reference", id = seen[value] } end
                if depth >= MAX_DEPTH then return { type = "table", truncated = true, reason = "depth limit" } end
                nextId += 1
                -- Deferred metadata uses positive table IDs; keep call-time Lua
                -- tables in a distinct namespace within the same event.
                local result = { type = "table", id = -nextId, entries = {} }
