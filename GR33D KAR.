    for _, d in ipairs(PlayerGui:GetDescendants()) do if d:IsA("TextLabel") then local tn, sn = d.Text:match("^%s*(Table%d+)%s*%(Seat%s*(%d+)%)%s*$") if tn then found = true local avail = false if d.Parent then for _, s in ipairs(d.Parent:GetChildren()) do if s:IsA("TextLabel") and s.Text:lower():match("^%s*available%s*$") then avail = true break end end end res[tn .. "|" .. sn] = avail end end end
