        S.drinksDone += 1
        M.serve.status = "gave " .. tostring(drinkName)
        log("serve", "gave " .. tostring(drinkName), THEME.green)
        return 0.4
    end
    if hd and waitFor(function() return heldDrinkName() == nil end, 1.0) then
        S.drinksDone += 1
        M.serve.status = "gave " .. tostring(drinkName)
        log("serve", "gave " .. tostring(drinkName), THEME.green)
        return 0.4
    end
    S.drinkFailAt = now + 3
    M.serve.status = "drink give refused, retrying soon"
    return 0.5
end
local function dishKey(s)
    local base = normName(s)
    local k = base:gsub("cooked", ""):gsub("inihaw", ""):gsub("ihaw", "")
    if #k == 0 then return base end
    return k
end
local function dishMatch(a, b)
    if a == b then return true end
    if #a >= 4 and #b >= 4 and (a:find(b, 1, true) or b:find(a, 1, true)) then return true end
    return false
end
local function servePromptsIn(inst)
    local out = {}
    for _, d in ipairs(inst:GetDescendants()) do
        if d:IsA("ProximityPrompt") and normName(d.ActionText):sub(1, 5) == "serve" then table.insert(out, d) end
    end
    return out
end
local function dishOfPrompt(p)
    return dishKey((p.ActionText:gsub("^%s*[Ss]erve%s*", "")))
end
local function ihawSections()
    local out, plot = {}, plotGet()
    if not plot then return out end
    for _, d in ipairs(plot:GetDescendants()) do
        if not d:IsA("ProximityPrompt") and not d.Name:match("^Cooked_") and normName(d.Name):find("ihaw", 1, true) then
            table.insert(out, d)
        end
    end
    return out
end
local function findServeFor(acc)
    local key = dishKey(acc:GetAttribute("OrderKey") or acc.Name)
    local target = nil
    local own = S.tableOf[acc]
    if own and own.Parent then target = own end
    local npc = acc:GetAttribute("TargetNPCId")
    if not target and type(npc) == "string" and SEATTBL[npc] and SEATTBL[npc].Parent then target = SEATTBL[npc] end
    local bestEnabled, bestEnabledS = nil, 0
    local bestDisabled, bestDisabledS = nil, 0
    local function scan(root, bonus)
        for _, p in ipairs(servePromptsIn(root)) do
            local dk = dishOfPrompt(p)
            local s = 0
            if dk == key then s = 2 elseif dishMatch(key, dk) then s = 1 end
            if s > 0 then
                s = s + bonus
                if p.Enabled then
                    if s > bestEnabledS then bestEnabled, bestEnabledS = p, s end
                else
                    if s > bestDisabledS then bestDisabled, bestDisabledS = p, s end
                end
            end
        end
    end
    if target then scan(target, 3) end
    for _, t in ipairs(tablesOfPlot(plotGet())) do scan(t, 0) end
    for _, sec in ipairs(ihawSections()) do scan(sec, 0.5) end
    return bestEnabled or bestDisabled
end
local function presentInHand(acc)
    if acc.Parent == nil then return false end
    local bp = Me:FindFirstChild("Backpack")
    return acc.Parent == Me.Character or (bp ~= nil and acc.Parent == bp)
end
local function serveFood(acc, p)
    local pos = promptAnchor(p)
    if not pos then return false, "no prompt anchor" end
    if not p.Enabled then
        waitFor(function() return p.Enabled and p.Parent ~= nil end, CFG.PROMPT_WAIT)
        if not (p.Parent and p.Enabled) then return false, "Serve prompt not enabled" end
    end
    local maxR = p.MaxActivationDistance
    if maxR <= 0 then maxR = 10 end
    local reach = math.max(maxR - 1, 2)

    if not inReach(p) then
        local ok, why = safeTeleport(pos, maxR)
        if not ok then return false, "teleport: " .. tostring(why) end
        task.wait(math.random(10, 20) / 100)
    end

    local _, hrp2 = charParts()
    if hrp2 and (hrp2.Position - pos).Magnitude <= reach then
        for attempt = 1, 3 do
            if not (p.Parent and p.Enabled) then break end
            pressPromptFast(p, true)
            if waitFor(function() return not presentInHand(acc) end, CFG.CONFIRM) then
                return true, "served"
            end
            if attempt == 1 then fire(p) end
            task.wait(math.random(8, 15) / 100)
        end
    end
    return false, "could not serve"
end
local function heldFoodsWithServe()
    local now = os.clock()
    for _, acc in ipairs(heldFoods()) do
        if (S.retryAt[acc] or 0) <= now then
            local p = findServeFor(acc)
            if p then return acc, p end
        end
    end
    return nil, nil
end
local function foodStep()
    local acc, p = heldFoodsWithServe()
    if not acc then return nil end
    local dish = tostring(acc:GetAttribute("OrderKey") or acc.Name)
    wants("serve")
    local ok, res, why = withMove("serve", function() return serveFood(acc, p) end)
    if not ok then M.serve.status = tostring(res) return 0.5 end
    if res then
        S.served += 1
        counts.served += 1
        M.serve.status = "served " .. dish
        log("serve", "served " .. dish .. " (" .. tostring(why) .. ")", THEME.green)
        return 0.3
    end
    S.retryAt[acc] = os.clock() + 3
    M.serve.status = "serve failed " .. dish .. ": " .. tostring(why)
    log("serve", M.serve.status, THEME.orange)
    return 0.5
end
local function ihawPromptOf()
    if S.ihawAt and os.clock() - S.ihawAt < 1 then return S.ihawPrompt end
    S.ihawAt = os.clock()
    local _, hrp = charParts()
    local char = Me.Character
    local best, bestD = nil, math.huge
    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled and not (char and p:IsDescendantOf(char)) then
            local obj, act = normName(p.ObjectText), normName(p.ActionText)
            local inIhaw, cur = false, p.Parent
            while cur and cur ~= Workspace do
                if normName(cur.Name):find("ihaw", 1, true) then inIhaw = true break end
                cur = cur.Parent
            end
            local isCook = obj == "ihaw" or act == "cookhotdog"
                or (inIhaw and (act:find("cook", 1, true) ~= nil or act:find("hotdog", 1, true) ~= nil))
            if isCook then
                local pos = promptAnchor(p)
                local d = (hrp and pos) and (hrp.Position - pos).Magnitude or math.huge
                if d < bestD then best, bestD = p, d end
            end
        end
    end
    S.ihawPrompt = best
    return best
end
local function ihawStep()
    if (S.ihawFailAt or 0) > os.clock() then return nil end
    local p = ihawPromptOf()
    if not p or not p.Parent or not p.Enabled then return nil end
    wants("ihaw")
    local ok, res, why = withMove("ihaw", function()
        if not goToPrompt(p) then return false, "could not reach the IHAW" end
        pressPromptFast(p, false)
        return true, "cooked"
    end)
    if not ok then M.serve.status = tostring(res) return 0.5 end
    if not res then
        S.ihawFailAt = os.clock() + 5
        M.serve.status = "IHAW: " .. tostring(why)
        return 0.5
    end
    M.serve.status = "IHAW: cooking"
    return 0.8
end
local function serveTick()
    if not plotGet() then M.serve.status = "no plot found" return 2 end
    local r = drinkStep()
    if r then return r end
    r = foodStep()
    if r then return r end
    r = ihawStep()
    if r then return r end
