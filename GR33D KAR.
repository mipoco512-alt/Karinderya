local NAME_HIT = {}
local function apNameHit(name) local h = NAME_HIT[name] if h == nil then h = hasWord(normName(name), CFG.AP_PATTERNS) NAME_HIT[name] = h end return h end
local function apKey(pos) return string.format("%d,%d,%d", math.floor(pos.X), math.floor(pos.Y), math.floor(pos.Z)) end
local function addAP(pos, inst, src) if not pos or not finite(pos) then return end local now = os.clock() for _, k in ipairs(AP.known) do if (inst ~= nil and k.inst == inst) or (k.pos - pos).Magnitude < 2.5 then k.pos = pos if inst then k.inst = inst end k.seen, k.src = now, src return end end table.insert(AP.known, { pos = pos, inst = inst, seen = now, src = src }) end
local function removeAP(pos, inst) for i = #AP.known, 1, -1 do local k = AP.known[i] if (inst ~= nil and k.inst == inst) or (pos ~= nil and (k.pos - pos).Magnitude < 3) then table.remove(AP.known, i) end end end
local function pruneAP() local now = os.clock() for i = #AP.known, 1, -1 do local k = AP.known[i] if (k.inst and not k.inst.Parent) or now - k.seen > 60 then table.remove(AP.known, i) end end end
local function nearestAP() local _, hrp = charParts() if not hrp then return nil end local now, best, bestD = os.clock(), nil, nil for _, k in ipairs(AP.known) do if (AP.attempt[apKey(k.pos)] or 0) <= now then local d = (hrp.Position - k.pos).Magnitude if not bestD or d < bestD then best, bestD = k, d end end end return best, bestD end
local function scanAP() local char = Me.Character for _, obj in ipairs(Workspace:GetDescendants()) do if (obj:IsA("BasePart") or obj:IsA("Model")) and apNameHit(obj.Name) and not (char and obj:IsDescendantOf(char)) then local pos = anchorOf(obj) if pos and finite(pos) then addAP(pos, obj, "scan") end end end end
local function pollAP() local t0 = os.clock() local ok, res = invoke("GetAngpaos") if not ok then return false, tostring(res) end if not AP.polled then AP.polled = true print("[Karinderya][AngPao] GetAngpaos reply:", typeof(res), summarize(res)) end for _, f in ipairs(parseReply(res)) do addAP(f.pos, f.inst, "poll") end for i = #AP.known, 1, -1 do local k = AP.known[i] if k.src == "poll" and k.seen < t0 then table.remove(AP.known, i) end end return true end
local function debugNearby() local _, hrp = charParts() if not hrp then return end print("[Karinderya][AngPao] nothing found. Touch/prompt objects within 40 studs:") local shown = 0 for _, obj in ipairs(Workspace:GetDescendants()) do if shown >= 25 then break end if obj:IsA("BasePart") or obj:IsA("Model") then local pos = anchorOf(obj) if pos and finite(pos) and (pos - hrp.Position).Magnitude <= 40 then local touch = obj:FindFirstChildWhichIsA("TouchTransmitter", true) ~= nil local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true) ~= nil if touch or prompt then shown += 1 print(string.format("  %s [%s] %.0f studs touch=%s prompt=%s", obj:GetFullName(), obj.ClassName, (pos - hrp.Position).Magnitude, tostring(touch), tostring(prompt))) end end end end if shown == 0 then print("  (none) - the ang pao may not be a Part/Model with a touch or prompt") end end
local function collectAP(t)
    AP.attempt[apKey(t.pos)] = os.clock() + CFG.AP_RETRY
    local ok = safeTeleport(t.pos, 10)
    task.wait(0.1)
    if t.inst then
        local p = t.inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        if p and p.Enabled then
            if fireproximityprompt then pcall(fireproximityprompt, p) end
            pcall(function() p:InputHoldBegin() end)
            task.wait(0.01)
            pcall(function() p:InputHoldEnd() end)
        end
    end
    fireRemote("CollectAngpao", t.inst or t.pos)
    task.wait(CFG.AP_WAIT)
    removeAP(t.pos, t.inst)
    AP.collected += 1
    return true
end
local function apTick()
    if not charParts() then M.angpao.status = "no character" return 1 end
    local now = os.clock() if now - AP.lastScan >= CFG.AP_SCAN then AP.lastScan = now scanAP() end
    if now - AP.lastPoll >= CFG.AP_POLL then AP.lastPoll = now pollAP() end
    pruneAP() local best, d = nearestAP()
    if not best then if #AP.known > 0 then M.angpao.status = #AP.known .. " known, cooling down" else M.angpao.status = "none found (see console)" if not AP.idle then AP.idle = true debugNearby() end end return 1 end
    AP.idle = false local ok, res = withMove("angpao", function() return collectAP(best) end)
    if not ok then M.angpao.status = tostring(res) return 0.6 end
    M.angpao.status = string.format("collected (%d total, %.0f studs)", AP.collected, d or 0) return 0.1
end

