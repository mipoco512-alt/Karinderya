-- Karinderya Gameplay Recorder v3.1 (automatic logging; lightweight Show Log File). Read RECORDER.md.

local createGameplayRecorder = (function()
-- The hook only snapshots Lua arguments and forwards the original call directly.
-- Instance methods, filtering, context and observers run later in Flush(). A
-- nested Instance namecall must never replace the game's pending method name.
local function createGameplayRecorder(ctx)
    local BUS_KEY, VERSION = "__KarinderyaGameplayRecorderHook", "gameplay-recorder-v3"
    local compatible = { [VERSION] = true, ["gameplay-recorder-v2"] = true, ["gameplay-recorder-v1"] = true }
    -- Settings may reduce these ceilings; invalid/unbounded values use defaults.
    local ceilings = { records = 100, pending = 64, nodes = 128, strings = 4096, depth = 4, entries = 24, arguments = 32 }
    local limits = {}
    for name, maximum in pairs(ceilings) do
        local value = type(ctx.limits) == "table" and rawget(ctx.limits, name) or nil
        limits[name] = type(value) == "number" and value == value and value >= 1 and value < math.huge
            and math.min(maximum, math.floor(value)) or maximum
    end
    local MAX_RECORDS, MAX_NODES, MAX_STRINGS = limits.records, limits.nodes, limits.strings
    local MAX_DEPTH, MAX_ENTRIES, MAX_ARGUMENTS = limits.depth, limits.entries, limits.arguments
    local MAX_PENDING = limits.pending
    local env, gameObject, storage = ctx.env, ctx.game, ctx.storage
    local clock = ctx.clock or os.clock
    local createdAt = clock()
    local buffer, head, count, sequence = {}, 1, 0, 0
    local dropped, total, outgoing, incoming, interactions, returns, errors = 0, 0, 0, 0, 0, 0, 0
    local recording, destroyed, generation = false, false, 0
    local queue, queueHead, queueCount, queueDropped, flushing = {}, 1, 0, 0, false
    local includeIncoming, allReplicated, filter, label = false, false, "", ""
    local attachedBus, addedConnection, removedConnection
    local incomingConnections = {}
    local recorder, sink = {}, {}

    local function copy(value)
        if type(value) ~= "table" then return value end
        local result = {}
        for key, item in next, value do result[key] = copy(item) end
        return result
    end
    local function safeTime()
        local value = clock() - createdAt
        return value == value and value >= 0 and value < math.huge and value or 0
    end
    local function number(value)
        if value ~= value then return { type = "number", value = "NaN" } end
        if value == math.huge then return { type = "number", value = "+Infinity" } end
        if value == -math.huge then return { type = "number", value = "-Infinity" } end
        return value
    end

    -- Only pure Lua operations and typeof are allowed here. Engine values are
    -- immutable references, enriched outside the game's __namecall stack. Lua
    -- tables are copied now so later gameplay mutations cannot rewrite the log.
    local function snapshotArguments(...)
        -- Reserve identity space so a large argument cannot hide its remote.
        local reservedNodes = math.min(16, math.floor(MAX_NODES / 4))
        local reservedStrings = math.min(512, math.floor(MAX_STRINGS / 4))
        local remainingNodes, remainingStrings = MAX_NODES - reservedNodes, MAX_STRINGS - reservedStrings
        local seen, deferred, nextId = {}, {}, 0
        local encode
        encode = function(value, depth)
            if remainingNodes <= 0 then return { type = "truncated", reason = "node budget" } end
            remainingNodes -= 1
            local kind = typeof(value)
            if kind == "nil" then return { type = "nil" }
            elseif kind == "boolean" then return value
            elseif kind == "number" then return number(value)
            elseif kind == "string" then
                local size = #value
                local limit = math.min(size, remainingStrings, 4096)
                remainingStrings -= limit
                if limit == size and utf8.len(value) ~= nil then return value end
                local bytes = table.create(limit)
                for index = 1, limit do bytes[index] = string.format("%02x", string.byte(value, index)) end
                return { type = "string", encoding = "hex", value = table.concat(bytes), byteLength = size, truncated = limit < size }
            elseif kind == "table" then
                if seen[value] then return { type = "reference", id = seen[value] } end
                if depth >= MAX_DEPTH then return { type = "table", truncated = true, reason = "depth limit" } end
                nextId += 1
                -- Deferred metadata uses positive table IDs; keep call-time Lua
                -- tables in a distinct namespace within the same event.
                local result = { type = "table", id = -nextId, entries = {} }
                seen[value] = -nextId
                local key, item = next(value)
                while key ~= nil do
                    if #result.entries >= MAX_ENTRIES or remainingNodes < 2 then
                        result.truncated, result.reason = true, #result.entries >= MAX_ENTRIES and "entry limit" or "node budget"
                        break
                    end
                    table.insert(result.entries, { key = encode(key, depth + 1), value = encode(item, depth + 1) })
                    key, item = next(value, key)
                end
                return result
            elseif kind == "Instance" or kind == "Vector3" or kind == "Vector2" or kind == "CFrame"
                or kind == "Color3" or kind == "UDim" or kind == "UDim2" or kind == "NumberRange"
                or kind == "Rect" or kind == "Ray" or kind == "DateTime" or kind == "EnumItem"
                or kind == "BrickColor" or kind == "Axes" or kind == "Faces" or kind == "Font"
                or kind == "ColorSequence" or kind == "ColorSequenceKeypoint" or kind == "NumberSequence"
                or kind == "NumberSequenceKeypoint" or kind == "PhysicalProperties" or kind == "Region3"
                or kind == "Region3int16" or kind == "Vector2int16" or kind == "Vector3int16" then
                local token = {}
                deferred[token] = value
                return token
            end
            return { type = kind, unsupported = true }
        end
        local n = select("#", ...)
        local result = { n = n, values = {} }
        for index = 1, math.min(n, MAX_ARGUMENTS) do result.values[index] = encode(select(index, ...), 0) end
        if n > MAX_ARGUMENTS then result.truncated = true end
        return result, deferred, { nodes = remainingNodes + reservedNodes, strings = remainingStrings + reservedStrings }
    end

    -- Each event has its own combined node and string budget. Tables use entries
    -- so numeric/non-string keys, holes, nil arguments and references survive JSON.
    local function serializer(budget)
        local remainingNodes = budget and budget.nodes or MAX_NODES
        local remainingStrings = budget and budget.strings or MAX_STRINGS
        local seen, nextId = {}, 0
        local encode
        local function text(value)
            local size = #value
            local limit = math.min(size, remainingStrings, 4096)
            remainingStrings -= limit
            if limit == size and utf8.len(value) ~= nil then return value end
            local bytes = table.create(limit)
            for index = 1, limit do bytes[index] = string.format("%02x", string.byte(value, index)) end
            return { type = "string", encoding = "hex", value = table.concat(bytes), byteLength = size, truncated = limit < size }
        end
        local function instance(value, depth)
            local segments, cursor, truncated = {}, value, false
            -- Identity fields get priority over the optional hierarchy segments.
            local result = { type = "Instance", path = encode(value:GetFullName(), depth + 1),
                segments = segments, class = encode(value.ClassName, depth + 1) }
            for _ = 1, 32 do
                if not cursor or cursor == gameObject then break end
                if remainingNodes <= 0 then truncated = true; break end
                table.insert(segments, 1, encode(cursor.Name, depth + 1))
                cursor = cursor.Parent
            end
            if truncated or (cursor and cursor ~= gameObject) then result.pathTruncated = true end
            return result
        end
        local knownStringTypes = {
            Axes = true, Faces = true, Font = true, ColorSequence = true, ColorSequenceKeypoint = true,
            NumberSequence = true, NumberSequenceKeypoint = true, PhysicalProperties = true,
            Region3 = true, Region3int16 = true, Vector2int16 = true, Vector3int16 = true,
        }
        encode = function(value, depth)
            if remainingNodes <= 0 then return { type = "truncated", reason = "node budget" } end
            remainingNodes -= 1
            local kind = typeof(value)
            if kind == "nil" then return { type = "nil" }
            elseif kind == "boolean" then return value
            elseif kind == "number" then return number(value)
            elseif kind == "string" then return text(value)
            elseif kind == "Instance" then return instance(value, depth)
            elseif kind == "table" then
                if seen[value] then return { type = "reference", id = seen[value] } end
                if depth >= MAX_DEPTH then return { type = "table", truncated = true, reason = "depth limit" } end
                nextId += 1
                local result = { type = "table", id = nextId, entries = {} }
                seen[value] = nextId
                local key, item = next(value)
                while key ~= nil do
                    if #result.entries >= MAX_ENTRIES or remainingNodes < 2 then
                        result.truncated, result.reason = true, (#result.entries >= MAX_ENTRIES and "entry limit" or "node budget")
                        break
                    end
                    table.insert(result.entries, { key = encode(key, depth + 1), value = encode(item, depth + 1) })
                    key, item = next(value, key)
                end
                return result
            elseif kind == "Vector3" then
                return { type = kind, components = { number(value.X), number(value.Y), number(value.Z) } }
            elseif kind == "Vector2" then
                return { type = kind, components = { number(value.X), number(value.Y) } }
            elseif kind == "CFrame" then
                local components = { value:GetComponents() }
                for index, component in ipairs(components) do components[index] = number(component) end
                return { type = kind, components = components }
            elseif kind == "Color3" then
                return { type = kind, components = { number(value.R), number(value.G), number(value.B) } }
            elseif kind == "UDim" then
                return { type = kind, components = { number(value.Scale), number(value.Offset) } }
            elseif kind == "UDim2" then
                return { type = kind, components = { number(value.X.Scale), number(value.X.Offset), number(value.Y.Scale), number(value.Y.Offset) } }
            elseif kind == "NumberRange" then
                return { type = kind, components = { number(value.Min), number(value.Max) } }
            elseif kind == "Rect" then
                return { type = kind, min = encode(value.Min, depth + 1), max = encode(value.Max, depth + 1) }
            elseif kind == "Ray" then
                return { type = kind, origin = encode(value.Origin, depth + 1), direction = encode(value.Direction, depth + 1) }
            elseif kind == "DateTime" then
                return { type = kind, unixTimestampMillis = number(value.UnixTimestampMillis) }
            elseif kind == "EnumItem" then
                return { type = kind, name = text(value.Name), value = number(value.Value), enum = text(tostring(value.EnumType)) }
            elseif kind == "BrickColor" then
                return { type = kind, name = text(value.Name), number = number(value.Number) }
            elseif knownStringTypes[kind] then return { type = kind, value = text(tostring(value)) }
            end
            return { type = kind, unsupported = true }
        end
        local function args(...)
            local n = select("#", ...)
            local result = { n = n, values = {} }
            for index = 1, math.min(n, MAX_ARGUMENTS) do result.values[index] = encode(select(index, ...), 0) end
            if n > MAX_ARGUMENTS then result.truncated = true end
            return result
        end
        return encode, args
    end

    local function push(entry)
        sequence += 1
        entry.sequence, entry.time = sequence, entry.time or safeTime()
        entry.elapsed = entry.time
        entry.label = entry.label or label
        if count == MAX_RECORDS then
            buffer[head] = entry
            head = head % MAX_RECORDS + 1
            dropped += 1
        else
            buffer[(head + count - 1) % MAX_RECORDS + 1] = entry
            count += 1
        end
        total += 1
        if type(ctx.onRecord) == "function" then pcall(ctx.onRecord, copy(entry)) end
        return entry.sequence
    end
    local function matches(target, method)
        if typeof(target) ~= "Instance" or not target:IsDescendantOf(storage) then return false end
        if method == "InvokeServer" then
            if not target:IsA("RemoteFunction") then return false end
        elseif not target:IsA("RemoteEvent") and not target:IsA("UnreliableRemoteEvent") then return false end
        if not allReplicated then
            local root = storage:FindFirstChild("Remotes")
            if not root or not target:IsDescendantOf(root) then return false end
        end
        return filter == "" or target:GetFullName():lower():find(filter, 1, true) ~= nil
    end
    local function enqueue(target, method, direction, ...)
        if queueCount >= MAX_PENDING then queueDropped += 1; return end
        local args, deferred, budget = snapshotArguments(...)
        queue[(queueHead + queueCount - 1) % MAX_PENDING + 1] = {
            target = target, method = method, direction = direction, args = args, deferred = deferred, budget = budget,
            generation = generation, label = label, time = safeTime(),
        }
        queueCount += 1
    end
    function sink.begin(target, method, ...)
        if not recording or destroyed or typeof(target) ~= "Instance"
            or (method ~= "FireServer" and method ~= "InvokeServer") then return nil end
        enqueue(target, method, "outgoing", ...)
        -- Older resident hooks also tail original when this is nil. Never issue
        -- response tickets: wrapping InvokeServer results changes its stack.
        return nil
    end

    function recorder:Flush(limit)
        if flushing or destroyed then return 0 end
        flushing = true
        local maximum = type(limit) == "number" and limit == limit and math.clamp(math.floor(limit), 0, MAX_PENDING) or MAX_PENDING
        local processed = 0
        for _ = 1, math.min(queueCount, maximum) do
            local raw = queue[queueHead]
            queue[queueHead] = nil
            queueHead, queueCount = queueHead % MAX_PENDING + 1, queueCount - 1
            processed += 1
            if raw.generation == generation then
                -- Metadata can disappear between the call and Flush. A failed
                -- snapshot discards only this entry, never a game call.
                pcall(function()
                    if not matches(raw.target, raw.method) then return end
                    local encode = serializer(raw.budget)
                    local function materialize(value)
                        if type(value) ~= "table" then return value end
                        local engineValue = raw.deferred[value]
                        if engineValue ~= nil then return encode(engineValue, 0) end
                        for key, item in next, value do value[key] = materialize(item) end
                        return value
                    end
                    local entry = { kind = "remote", direction = raw.direction, method = raw.method,
                        label = raw.label, time = raw.time, remote = encode(raw.target, 0),
                        args = materialize(raw.args), status = raw.direction == "incoming" and "received" or "observed", metadataTiming = "deferred" }
                    if type(ctx.context) == "function" then
                        local ok, value = pcall(ctx.context)
                        if ok and value ~= nil then entry.context = encode(value, 0) end
                    end
                    if raw.direction == "incoming" then incoming += 1 else outgoing += 1 end
                    push(entry)
                end)
            end
        end
        flushing = false
        return processed
    end

    local function disconnectIncoming()
        if addedConnection then addedConnection:Disconnect(); addedConnection = nil end
        if removedConnection then removedConnection:Disconnect(); removedConnection = nil end
        for instance, connection in pairs(incomingConnections) do connection:Disconnect(); incomingConnections[instance] = nil end
    end
    local function observeIncoming(instance)
        if incomingConnections[instance] or not (instance:IsA("RemoteEvent") or instance:IsA("UnreliableRemoteEvent")) then return end
        incomingConnections[instance] = instance.OnClientEvent:Connect(function(...)
            if not recording or not includeIncoming or not attachedBus or rawget(attachedBus, "sink") ~= sink then return end
            -- Incoming callbacks share the same bounded queue and deferred work.
            pcall(enqueue, instance, "OnClientEvent", "incoming", ...)
        end)
    end
    local function syncIncoming()
        disconnectIncoming()
        if not recording or not includeIncoming then return end
        addedConnection = storage.DescendantAdded:Connect(observeIncoming)
        removedConnection = storage.DescendantRemoving:Connect(function(instance)
            local connection = incomingConnections[instance]
            if connection then connection:Disconnect(); incomingConnections[instance] = nil end
        end)
        for _, instance in ipairs(storage:GetDescendants()) do observeIncoming(instance) end
    end

    function recorder:Start()
        if destroyed then return false, "Recorder has been destroyed." end
        if recording and attachedBus and rawget(attachedBus, "sink") == sink then return true end
        if type(env) ~= "table" then return false, "A persistent executor environment is required." end
        if typeof(storage) ~= "Instance" or not storage:IsA("ReplicatedStorage") then return false, "ReplicatedStorage is unavailable." end
        local bus = rawget(env, BUS_KEY)
        if bus ~= nil and (type(bus) ~= "table"
            or not compatible[rawget(bus, "version")]
            or rawget(bus, "installed") ~= true) then
            return false, "An incompatible gameplay recorder hook is already installed."
        end
        if bus == nil then
            local hook = rawget(env, "hookmetamethod") or hookmetamethod
            local getMethod = rawget(env, "getnamecallmethod") or getnamecallmethod
            local checkCaller = rawget(env, "checkcaller") or checkcaller
            local setMethod = rawget(env, "setnamecallmethod") or setnamecallmethod
            local makeClosure = rawget(env, "newcclosure") or newcclosure
            if type(hook) ~= "function" or type(getMethod) ~= "function" or type(checkCaller) ~= "function" then
                return false, "Needs hookmetamethod, getnamecallmethod and checkcaller."
            end
            bus = { version = VERSION, installed = false, sink = nil }
            local original
            local function intercept(target, ...)
                local observer = rawget(bus, "sink")
                if not observer then return original(target, ...) end
                local methodOK, method = pcall(getMethod)
                if observer and methodOK and (method == "FireServer" or method == "InvokeServer") then
                    local callerOK, caller = pcall(checkCaller)
                    if callerOK and caller == false then
                        pcall(observer.begin, target, method, ...)
                    end
                end
                if methodOK and type(method) == "string" and type(setMethod) == "function" then pcall(setMethod, method) end
                -- No result wrapper, post-call work, Instance methods or yields.
                -- Preserve the original return values, error object and yielding.
                return original(target, ...)
            end
            local callback = intercept
            if ctx.useCClosure == true then
                if type(makeClosure) ~= "function" then return false, "Requested C closure capability is unavailable." end
                local ok, closure = pcall(makeClosure, intercept)
                if not ok or type(closure) ~= "function" then return false, "Could not create the requested C closure." end
                callback = closure
            end
            local ok, previous = pcall(hook, gameObject, "__namecall", callback)
            if not ok then return false, "Could not install a pass-through hook: " .. tostring(previous) end
            original = previous
            rawset(env, BUS_KEY, bus)
            if type(original) ~= "function" then return false, "Executor hook did not return the original namecall function." end
            bus.installed = true
        end
        local previous = rawget(bus, "sink")
        if previous and previous ~= sink and type(previous.detach) == "function" then pcall(previous.detach) end
        generation += 1
        recording, attachedBus = true, bus
        rawset(bus, "sink", sink)
        syncIncoming()
        return true
    end
    function recorder:Stop()
        self:Flush()
        generation += 1
        recording = false
        if attachedBus and rawget(attachedBus, "sink") == sink then rawset(attachedBus, "sink", nil) end
        attachedBus = nil
        disconnectIncoming()
    end
    sink.detach = function() recorder:Stop() end
    function recorder:Destroy()
        self:Stop()
        destroyed = true
    end
    function recorder:Clear()
        generation += 1
        buffer, head, count = {}, 1, 0
        queue, queueHead, queueCount, queueDropped = {}, 1, 0, 0
        dropped, total, outgoing, incoming, interactions, returns, errors = 0, 0, 0, 0, 0, 0, 0
    end
    function recorder:SetLabel(value)
        if type(value) ~= "string" then return false end
        label = value:gsub("[%c]", " "):match("^%s*(.-)%s*$"):sub(1, 120)
        return true
    end
    function recorder:Mark(value)
        if not recording or destroyed or not attachedBus or rawget(attachedBus, "sink") ~= sink then return false end
        self:Flush()
        local encode = serializer()
        local detail = type(value) == "string" and value or label
        push({ kind = "marker", direction = "local", details = encode(detail, 0) })
        return true
    end
    function recorder:Note(kind, details)
        if type(kind) ~= "string" or not recording or destroyed or not attachedBus or rawget(attachedBus, "sink") ~= sink then return false end
        self:Flush()
        local encode = serializer()
        push({ kind = kind:gsub("[%c]", " "):sub(1, 64), direction = "local", details = encode(details, 0) })
        interactions += 1
        return true
    end
    function recorder:SetIncludeIncoming(value)
        includeIncoming = value == true
        syncIncoming()
    end
    function recorder:SetAllReplicated(value) allReplicated = value == true end
    function recorder:SetFilter(value)
        if type(value) ~= "string" then return false end
        filter = value:lower():sub(1, 250)
        return true
    end
    function recorder:Entries(afterSequence)
        local result = {}
        for offset = 0, count - 1 do
            local entry = buffer[(head + offset - 1) % MAX_RECORDS + 1]
            if type(afterSequence) ~= "number" or entry.sequence > afterSequence then table.insert(result, copy(entry)) end
        end
        return result
    end
    function recorder:Stats()
        return { recording = recording and attachedBus ~= nil and rawget(attachedBus, "sink") == sink,
            destroyed = destroyed, count = count, total = total, dropped = dropped, elapsed = safeTime(),
            outgoing = outgoing, incoming = incoming, interactions = interactions, returns = returns, errors = errors,
            queued = queueCount, queueDropped = queueDropped, captureMode = "arguments-only", limits = table.clone(limits),
            lastSequence = sequence, label = label, includeIncoming = includeIncoming, allReplicated = allReplicated, filter = filter }
    end
    return recorder
end

return createGameplayRecorder

end)()

local createRecorderJournal = (function()
-- Durable local JSON-lines journal. Call Start before enabling the recorder and
-- Append only from its deferred onRecord callback, never inside a namecall hook.
local function createRecorderJournal(ctx)
    local journal = {}
    local baseFile = tostring(ctx.baseName or "karinderya-gameplay") .. ".log"
    local chunked = type(ctx.appendfile) ~= "function"
    local initialized, failed, saved, lastFile, lastError = false, false, 0, nil, nil
    local metadata = type(ctx.metadata) == "table" and ctx.metadata or {}
    local sessionId = metadata.sessionId or metadata.session or ctx.baseName
    local limit = tonumber(ctx.maxLineBytes) or 24 * 1024
    if limit ~= limit or limit == math.huge or limit == -math.huge then limit = 24 * 1024 end
    limit = math.max(1024, math.floor(limit))

    local function fail(reason)
        failed, lastError = true, reason
        return false, reason
    end
    local function encode(value)
        local ok, result = pcall(ctx.encode, value)
        if not ok or type(result) ~= "string" or result:find("[\r\n]") then return nil end
        return result
    end
    local function boundedString(value, maximum)
        if type(value) ~= "string" then return nil end
        local result = value:sub(1, maximum)
        -- Keep the compact JSON payload valid even when a UTF-8 character straddles
        -- the size boundary. Captured recorder strings are already UTF-8-safe.
        while #result > 0 and utf8.len(result) == nil do result = result:sub(1, -2) end
        return result
    end
    local function finite(value)
        return type(value) == "number" and value == value and value > -math.huge and value < math.huge
    end
    local function compact(event, small)
        local remote = event.remote
        if type(remote) == "table" then
            remote = {
                type = boundedString(remote.type, 24),
                path = boundedString(remote.path, small and 32 or 256),
                class = boundedString(remote.class, 48),
            }
        else
            remote = boundedString(remote, small and 32 or 256)
        end
        return {
            sequence = finite(event.sequence) and event.sequence or saved + 1,
            time = finite(event.time) and event.time or nil,
            kind = boundedString(event.kind, 32),
            direction = boundedString(event.direction, 24),
            label = boundedString(event.label, small and 16 or 96),
            method = boundedString(event.method, 32),
            remote = remote,
            truncated = true, reason = "event too large",
            args = { type = "truncated", truncated = true, reason = "event too large" },
        }
    end
    local function envelope(event)
        return { kind = "event", sessionId = sessionId, event = event }
    end

    function journal:Start()
        if failed then return false, lastError end
        if initialized then return true end
        if type(ctx.writefile) ~= "function" then return fail("File writing is unavailable; recording was not started.") end
        if type(ctx.encode) ~= "function" then return fail("Log encoding is unavailable; recording was not started.") end
        -- The caller supplies a new session base name. If readfile is available,
        -- also refuse an accidental collision with an existing session log.
        if type(ctx.readfile) == "function" then
            local exists, contents = pcall(ctx.readfile, baseFile)
            if exists and type(contents) == "string" then return fail("A session log already exists; choose a new session filename.") end
        end
        local header = {
            format = "karinderya-gameplay-journal-v1", kind = "session",
            sessionId = sessionId, metadata = metadata, chunked = chunked,
        }
        if chunked then
            header.partsPattern = tostring(ctx.baseName) .. "-event*.log"
            header.note = "Each event is saved immediately in an immutable numbered part. Send this header and every matching event file."
        else
            header.note = "Events are appended immediately as JSON lines; no manual Save is required."
        end
        local payload = encode(header)
        if not payload then return fail("Could not encode the session log header; recording was not started.") end
        if #payload + 1 > limit then return fail("Session log metadata exceeds the line limit; recording was not started.") end
        local ok, result = pcall(ctx.writefile, baseFile, payload .. "\n")
        if not ok or result == false then return fail("Could not create the session log; recording was not started.") end
        initialized, lastFile = true, baseFile
        return true
    end

    function journal:Append(event)
        if failed then return false, lastError end
        if not initialized then return false, "Start the session log before recording." end
        if type(event) ~= "table" then return fail("Could not encode a recorded event; recording has been paused.") end
        local payload = encode(envelope(event))
        if not payload then return fail("Could not encode a recorded event; recording has been paused.") end
        if #payload + 1 > limit then
            payload = encode(envelope(compact(event, false)))
            if payload and #payload + 1 > limit then payload = encode(envelope(compact(event, true))) end
            if not payload or #payload + 1 > limit then
                return fail("Could not encode a bounded recorded event; recording has been paused.")
            end
        end
        local filename = chunked and (tostring(ctx.baseName) .. string.format("-event%06d.log", saved + 1)) or baseFile
        -- A failed append may have written a partial line. Latch the error rather
        -- than retrying and duplicating an event or overwriting a partial part.
        local ok, result
        if chunked then ok, result = pcall(ctx.writefile, filename, payload .. "\n")
        else ok, result = pcall(ctx.appendfile, filename, payload .. "\n") end
        if not ok or result == false then return fail("Could not save a recorded event; recording has been paused. Earlier saved logs remain on disk.") end
        saved, lastFile = saved + 1, filename
        return true
    end

    function journal:Stats()
        return { initialized = initialized, failed = failed, saved = saved, lastFile = lastFile,
            baseFile = baseFile, chunked = chunked, lastError = lastError }
    end

    function journal:GetLog()
        if not initialized then return nil, "No session log has been created." end
        if chunked then return nil, "This session uses numbered event files; send the header and all matching parts." end
        if type(ctx.readfile) ~= "function" then return nil, "Reading saved log files is unavailable in this executor." end
        local ok, result = pcall(ctx.readfile, baseFile)
        if not ok or type(result) ~= "string" then return nil, "Could not read the saved session log." end
        return result
    end

    function journal:Close() end -- Every successful Append is already on disk.
    return journal
end

return createRecorderJournal

end)()

