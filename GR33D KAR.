local BUY_SKIP = { buy = true, max = true, low = true, meats = true, frozen = true, drinks = true, others = true, grocery = true }
local BUY_KEYS = nil
local function buyKeys()
    if BUY_KEYS then return BUY_KEYS end
    BUY_KEYS = {}
    local mods = ReplicatedStorage:FindFirstChild("Modules")
    local cfg = mods and mods:FindFirstChild("IngredientsConfig")
    if cfg and cfg:IsA("ModuleScript") then
        local ok, data = pcall(require, cfg)
        if ok and type(data) == "table" then
            for k, v in pairs(data) do
                if type(k) == "string" then BUY_KEYS[normName(k)] = k end
                if type(v) == "table" and type(v.Name) == "string" then
                    BUY_KEYS[normName(v.Name)] = v.Name
                    if type(v.DisplayName) == "string" then BUY_KEYS[normName(v.DisplayName)] = v.Name end
                end
            end
        end
    end
    return BUY_KEYS
end
local function groceryTitle()
    for _, g in ipairs(PlayerGui:GetChildren()) do
        if g:IsA("ScreenGui") then
            for _, t in ipairs(g:GetDescendants()) do
                if t:IsA("TextLabel") and normName(t.Text) == "grocery" then return t end
            end
        end
    end
    return nil
end
local function guiVisible(inst)
    local o = inst
    while o and o ~= PlayerGui do
        if o:IsA("GuiObject") and not o.Visible then return false end
        if o:IsA("ScreenGui") and not o.Enabled then return false end
        o = o.Parent
    end
    return o == PlayerGui
end
local function groceryOpen() local t = groceryTitle() return t ~= nil and guiVisible(t) end
local function groceryGui() local o = groceryTitle() while o and not o:IsA("ScreenGui") do o = o.Parent end return o end
local function buyCount(c) local n = 0 for _, b in ipairs(c:GetDescendants()) do if b:IsA("TextButton") and normName(b.Text):sub(1, 3) == "buy" then n += 1 end end return n end
local function nameIn(c) for _, t in ipairs(c:GetDescendants()) do if t:IsA("TextLabel") and t.Text:match("^%s*%a[%a ]+%s*$") then local n = normName(t.Text) if #n >= 3 and not BUY_SKIP[n] then return (t.Text:match("^%s*(.-)%s*$")) end end end return nil end
local function groceryCards()
    local g = groceryGui() if not g or not groceryOpen() then return {} end
    local cards, seen = {}, {}
    for _, lbl in ipairs(g:GetDescendants()) do
        local pct = lbl:IsA("TextLabel") and lbl.Visible and tonumber(lbl.Text:match("^%s*(%d+)%%%s*$"))
        if pct then
            local card, name = lbl.Parent, nil
            for _ = 1, 4 do
                if not card or card == g then break end
                local nb = buyCount(card)
                if nb > 1 then break end
                if nb == 1 then name = nameIn(card) if name then break end end
                card = card.Parent
            end
            if name and card and card ~= g and not seen[card] then seen[card] = true table.insert(cards, { name = name, pct = pct, pctLabel = lbl }) end
        end
    end
    return cards
end
local function printGroceryTexts(g)
    if os.clock() - (BUY.dbgAt or -math.huge) < 20 then return end
    BUY.dbgAt = os.clock()
    print("[Karinderya][Buy] no item card read. Visible grocery texts (parent / name = text):")
    local n = 0
    for _, t in ipairs(g:GetDescendants()) do
        if n >= 40 then break end
        if (t:IsA("TextLabel") or t:IsA("TextButton")) and t.Visible and t.Text ~= "" then
            n += 1
            print(string.format("   %s / %s = '%s'", tostring(t.Parent and t.Parent.Name), t.Name, t.Text))
        end
    end
end
local function readPct(lbl)
    local ok, txt = pcall(function() return lbl.Text end)
    if not ok or type(txt) ~= "string" then return nil end
    local d = txt:match("(%d+)%%")
    return d and tonumber(d) or nil
end
local function restockItem(card, key)
    local bought, stall, last = 0, 0, card.pct
    while bought < CFG.BUY_MAX_UNITS do
        local ok, res = invoke("BuyIngredient", key, CFG.BUY_UNIT, "Cash")
        if not ok or res == false then return bought, "BuyIngredient refused: " .. summarize(res) end
        bought += CFG.BUY_UNIT
        task.wait(0.5)
        local now = readPct(card.pctLabel)
        if not now then break end
        if now == last then stall += 1 else stall = 0 end
        if stall >= CFG.BUY_STALL then return bought, "stock % did not move after " .. bought .. " units" end
        last = now
        card.pct = now
        if now >= CFG.BUY_TARGET then break end
    end
    return bought, nil
end
local function counterPrompt()
    local grocery = Workspace:FindFirstChild("Grocery")
    local inner = grocery and grocery:FindFirstChild("Grocery")
    local comp = inner and inner:FindFirstChild("Comp")
    local p = comp and comp:FindFirstChild("ProximityPrompt")
    if p and p:IsA("ProximityPrompt") then return p end
    return nil
end
local function buyTick()
    if not groceryOpen() then
        if CFG.BUY_USE_COUNTER_PROMPT and os.clock() - (BUY.openAt or -math.huge) > 20 then
            BUY.openAt = os.clock()
            local prompt = counterPrompt()
            if prompt then
                M.buy.status = "opening the Grocery"
                local ok, opened = withMove("buy", function()
                    goToPrompt(prompt) pressPromptFast(prompt, false)
                    return waitFor(groceryOpen, 2.0) ~= nil
                end)
                if not ok then M.buy.status = tostring(opened) return 1 end
                if opened then return 1 end
            end
        end
        M.buy.status = "Grocery closed: open it (or enable BUY_USE_COUNTER_PROMPT)"
        return 4
    end
    local cards = groceryCards()
    if #cards == 0 then
        local g = groceryGui()
        if g then printGroceryTexts(g) end
        M.buy.status = "Grocery open, no item card read (see console)"
        return 3
    end
    local keys = buyKeys()
    local now, low, bought = os.clock(), 0, 0
    for _, card in ipairs(cards) do
        if card.pct < CFG.BUY_LOW * 100 and (BUY.cd[card.name] or 0) <= now then
            low += 1
            BUY.cd[card.name] = now + CFG.BUY_COOLDOWN
            local key = keys[normName(card.name)] or card.name
            local n, err = restockItem(card, key)
            BUY.bought += n
            bought += n
            if n > 0 then log("buy", string.format("%s x%d (now %d%%)", key, n, card.pct), THEME.green) end
            if err then log("buy", key .. ": " .. err, THEME.orange) end
        end
    end
    M.buy.status = string.format("%d items read, %d low, %d units bought", #cards, low, bought)
    return CFG.BUY_EVERY
end

