-- AUTO DECOR
--==========================================================================
local function snapAcc() local set = {} local char = Me.Character if char then for _, c in ipairs(char:GetChildren()) do if c:IsA("Accessory") then set[c] = true end end end return set end
local function newAcc(before) local char = Me.Character if not char then return nil end for _, c in ipairs(char:GetChildren()) do if c:IsA("Accessory") and not before[c] then return c end end return nil end
local function holdingDecor() local char = Me.Character if not char then return false end if DC.held and DC.held.Parent == char then return true end for _, c in ipairs(char:GetChildren()) do if c:IsA("Accessory") then local n = normName(c.Name) for key in pairs(DC.keys) do if n:find(key, 1, true) then return true end end end end return false end
local function doPickup() local folder = Workspace:FindFirstChild("ChristmasTreePickups") if not folder then return false, "ChristmasTreePickups missing" end local now, list, total = os.clock(), {}, 0 for _, p in ipairs(folder:GetDescendants()) do if p:IsA("ProximityPrompt") and p.Enabled and normName(p.ActionText):find("pick", 1, true) then total += 1 local o = normName(p.ObjectText) if #o > 0 then DC.keys[o] = true end if (DC.skip[p] or 0) < now then table.insert(list, p) end end end DC.left = total if total == 0 then return false, "no decor left" end if #list == 0 then return false, "all " .. total .. " pickups cooling down" end local prompt = nearestOf(list) local label = (prompt.ObjectText ~= "" and prompt.ObjectText) or "decor" local before = snapAcc() local ok, why = goToPrompt(prompt) if not ok then DC.skip[prompt] = now + 15 return false, label .. ": " .. tostring(why) end local function got() return holdingDecor() or newAcc(before) ~= nil end for _ = 1, 3 do if not (prompt.Parent and prompt.Enabled) then break end press(prompt) if waitFor(got, 1.0) then DC.held = newAcc(before) or DC.held DC.picked += 1 return true, "picked " .. label end end local part = prompt.Parent and (prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart", true)) if part then fireRemote("PickUpDecor", part) if waitFor(got, 1.0) then DC.held = newAcc(before) or DC.held DC.picked += 1 return true, "picked " .. label .. " (remote)" end end DC.skip[prompt] = now + 20 return false, label .. ": not confirmed" end
local function doPlace() local live = Workspace:FindFirstChild("ChristmasTreeLive") local deposit = live and live:FindFirstChild("Deposit") local prompts = {} if deposit then for _, p in ipairs(deposit:GetDescendants()) do if p:IsA("ProximityPrompt") then local a = normName(p.ActionText) if a:find("add", 1, true) or a:find("tree", 1, true) then table.insert(prompts, p) end end end end if #prompts == 0 then return false, "no Add to Tree prompts" end local center, bottom if live and live:IsA("Model") then local ok, cf, size = pcall(function() return live:GetBoundingBox() end) if ok and cf then center = cf.Position bottom = cf.Position - Vector3.new(0, size.Y / 2, 0) end end local enabledN = 0 for _, p in ipairs(prompts) do if p.Enabled then enabledN += 1 end end table.sort(prompts, function(a, b) return a.Enabled and not b.Enabled end) local lastInfo = string.format("no open tree spot (%d prompts, %d enabled)", #prompts, enabledN) for i = 1, math.min(#prompts, 12) do local p = prompts[i] local anchor = promptAnchor(p) or bottom local cf, info = standSpot(anchor, p.MaxActivationDistance, center, nil) if cf then safeTeleport(anchor) if not p.Enabled then waitFor(function() return p.Enabled end, 1.0) end if p.Enabled and holdingDecor() then press(p) if waitFor(function() return not holdingDecor() end, 1.0) then DC.placed += 1 return true, "placed on tree" end fire(p) if waitFor(function() return not holdingDecor() end, 1.0) then DC.placed += 1 return true, "placed on tree (fire)" end end lastInfo = "spot did not accept decor" else lastInfo = tostring(info) end end return false, lastInfo end
local function decorTick()
    if not charParts() then M.decor.status = "no character" return 1 end
    if os.clock() < DC.cooldown then return 0.5 end
    local ok, placed, msg = withMove("decor", function() if holdingDecor() then return doPlace() end local picked, pmsg = doPickup() if not picked then return false, pmsg end local pl, pm = doPlace() return pl, pmsg .. " | " .. tostring(pm) end)
    if not ok then M.decor.status = tostring(placed) return 0.6 end
    M.decor.status = tostring(msg) if placed then log("decor", msg, THEME.green) return 0.2 end
    DC.cooldown = os.clock() + (holdingDecor() and 3 or 2) return 0.5
end

