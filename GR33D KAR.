local function counterCandidates()
    local tabs = tablesOfPlot(counterPlot()) local total = #tabs * CFG.SEATS local now, free, rest = os.clock(), {}, {}
    for k = 0, total - 1 do local slot = (C.cursor + k) % total local t = tabs[math.floor(slot / CFG.SEATS) + 1] local seat = slot % CFG.SEATS + 1 if t and t.Parent then local occ = C.occ[t:GetFullName() .. "|" .. seat] local busy = occ and (now - occ.t) < CFG.OCC_TTL local ui = C.ui and C.ui[t.Name .. "|" .. seat] local e = { slot = slot, tbl = t, seat = seat } if busy or ui == false then table.insert(rest, e) else table.insert(free, e) end end end
    for _, e in ipairs(rest) do table.insert(free, e) end
    return free, total
end
