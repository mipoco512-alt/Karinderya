local RCACHE = {}
local function remote(name)
    local r = RCACHE[name]
    if r and r.Parent then return r end
    local root = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage
    r = root:FindFirstChild(name, true)
    if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then RCACHE[name] = r return r end
    return nil
end
local function invoke(name, ...)
    local rf = remote(name) if not rf or not rf:IsA("RemoteFunction") then return false, "missing" end
    local args = table.pack(...) local done, ok, res = false, false, nil
    task.spawn(function() ok, res = pcall(function() return rf:InvokeServer(table.unpack(args, 1, args.n)) end) done = true end)
    local t0 = os.clock() while not done and os.clock() - t0 < CFG.REMOTE_TIMEOUT do task.wait(0.05) end
    if not done then return false, "timeout" end
    return ok, res
end
local function fireRemote(name, ...)
    local r = remote(name) if not r or not r:IsA("RemoteEvent") then return false, "missing" end
    local args = table.pack(...) return pcall(function() r:FireServer(table.unpack(args, 1, args.n)) end)
end
local HOOKS = {}
local function onEvent(name, fn)
    local r = remote(name) if r and r:IsA("RemoteEvent") then table.insert(HOOKS, r.OnClientEvent:Connect(function(...) local ok, err = pcall(fn, ...) if not ok then log("event", name .. ": " .. tostring(err), THEME.red) end end)) return true end
    return false
end

