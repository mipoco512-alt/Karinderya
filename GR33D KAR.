        inventory = objectObserver:State(filter), selected = selected and table.clone(selected) or nil,
        events = events, journal = state, capture = captureState, motion = motionState,
        capabilities = {
            outgoing = captureState.outgoingActive and "Active: game and executor namecalls" or (captureState.outgoingError or "Off; optional executor hook"),
            incoming = captureState.incomingActive and "Active: local OnClientEvent listeners" or "Off",
            source = "Selected readable Source only; no universal deobfuscation",
            errors = errorCapability,
