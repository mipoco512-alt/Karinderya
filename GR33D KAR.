--==========================================================================
-- MOVEMENT (TELEPORT v2)
--  Replaces the whole old MOVEMENT section: from its header down to, but not
--  including, the "PLOT and NIGHT" header. Every move now:
--    1. finds the nearest CLEAR standing spot around the target: a real floor,
--       room for the body, nothing solid inside the body box, not standing on
--       the prompt's own table or plate, and line of sight to the prompt when
--       the prompt needs it;
--    2. snaps the whole character ONCE with PivotTo (no walking, no bunny hops);
--    3. checks that it landed. If it was pushed back, it tries once more;
--       otherwise the caller gets false plus a reason.
--  Helpers live inside the TP table so the script stays under the 200-local limit.
--==========================================================================
local function containers()
    local out = {}
    if Me.Character then table.insert(out, Me.Character) end
    local bp = Me:FindFirstChild("Backpack")
    if bp then table.insert(out, bp) end
    return out
end

local function charParts()
    local char = Me.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hrp and hum and hum.Health > 0 then return char, hrp, hum end
    return nil, nil, nil
end

local MOVE = { owner = nil, saved = nil }

local function freezeWalk()
    local _, _, hum = charParts()
    if hum and not MOVE.saved then
        MOVE.saved = { hum.WalkSpeed, hum.JumpPower, hum.JumpHeight }
        hum.WalkSpeed, hum.JumpPower, hum.JumpHeight = 0, 0, 0
    end
end

local function thawWalk()
    local hum = Me.Character and Me.Character:FindFirstChildOfClass("Humanoid")
    if MOVE.saved and hum then
        hum.WalkSpeed = MOVE.saved[1] > 0 and MOVE.saved[1] or 16
        hum.JumpPower = MOVE.saved[2] > 0 and MOVE.saved[2] or 50
        hum.JumpHeight = MOVE.saved[3] > 0 and MOVE.saved[3] or 7.2
    end
    MOVE.saved = nil
end

local PRIO = { runaway = false, want = {} }
local PRIO_ORDER = { runaway = 1, drink = 2, serve = 3, collect = 4, ihaw = 5, trash = 6, angpao = 7, decor = 8 }
local function wants(owner) PRIO.want[owner] = os.clock() end
local function isRunawayActive() return PRIO.runaway end

local function gateOK(owner)
    if PRIO.runaway and owner ~= "runaway" then return false, "runaway" end
    local rank, now = PRIO_ORDER[owner] or 99, os.clock()
    for o, t in pairs(PRIO.want) do
        local r = PRIO_ORDER[o]
        if o ~= owner and r and r < rank and now - t < 1.5 then return false, o end
    end
    return true
end

local function withMove(owner, fn)
    local allowed, blocker = gateOK(owner)
    if not allowed then return false, "waiting: " .. tostring(blocker) end
    if MOVE.owner and MOVE.owner ~= owner then return false, "busy: " .. MOVE.owner end
    MOVE.owner = owner
    freezeWalk()
    local ok, x, y = pcall(fn)
    thawWalk()
    MOVE.owner = nil
    if not ok then error(x, 0) end
    return true, x, y
end

local function pressPromptFast(prompt, isServing)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local oldDist = prompt.MaxActivationDistance
    pcall(function() prompt.MaxActivationDistance = isServing and 1000 or 50 end)
    local time = math.max((prompt.HoldDuration or 0) + 0.05, 0.1)
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(time)
    pcall(function() prompt:InputHoldEnd() end)
    task.wait(0.1)
    pcall(function() prompt.MaxActivationDistance = oldDist end)
    return true
end

-- kept for Auto Runaway (behindCF uses it)
local function floorUnder(x, z, fromY)
    local ex = {}
    if Me.Character then table.insert(ex, Me.Character) end
    local p = RaycastParams.new()
    p.FilterType = Enum.RaycastFilterType.Exclude
    p.FilterDescendantsInstances = ex
    local from = Vector3.new(x, fromY, z)
    for _ = 1, 5 do
        local r = Workspace:Raycast(from, Vector3.new(0, -80, 0), p)
        if not r then return nil end
        if r.Instance.CanCollide then return r.Position.Y end
        table.insert(ex, r.Instance)
        p.FilterDescendantsInstances = ex
    end
    return nil
end

--------------------------------------------------------------------------------
-- TELEPORT v2: settings and helpers (all stored in TP)
--------------------------------------------------------------------------------
local TP = {
    RINGS      = { 2.0, 3.0, 4.0 },      -- distances from the target to try for a standing spot
    ANGLES     = 16,                     -- directions tried on each ring
    MAX_CHECKS = 24,                     -- spots checked per search (keeps it fast)
    MIN_GAP    = 0.12,                   -- shortest time between two snaps
    PAUSE_MIN  = 0.12, PAUSE_MAX = 0.22, -- human-like pause after a snap
    FLOOR_UP   = 3, FLOOR_DOWN = 7,      -- a floor may be this far above / below the target
    BODY_W     = 1.6, BODY_H = 4.6,      -- the box the body must fit in
    REACH_PAD  = 1.5,                    -- stay this far inside the prompt's distance
    LAND_TOL   = 2.5,                    -- how far from the chosen spot we may land
    lastSnap   = -math.huge,
}

-- height from the floor to the HumanoidRootPart centre
function TP.rootHeight(hum, hrp)
    return math.max(3, ((hum and hum.HipHeight) or 2) + hrp.Size.Y / 2)
end

-- a seated character cannot be moved, so stand it up first
function TP.unseat(hum)
    if hum and hum.Sit then
        pcall(function() hum.Sit = false end)
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        task.wait(0.15)
    end
end

-- real walkable floor under (x, z) close to nearY: returns its Y and the part, or nil
function TP.floorAt(x, z, nearY)
    local ex = {}
    if Me.Character then table.insert(ex, Me.Character) end
    local top = nearY + TP.FLOOR_UP + 3
    local len = TP.FLOOR_UP + TP.FLOOR_DOWN + 6
    for _ = 1, 6 do
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        p.FilterDescendantsInstances = ex
        local r = Workspace:Raycast(Vector3.new(x, top, z), Vector3.new(0, -len, 0), p)
        if not r then return nil end
        if r.Instance.CanCollide and r.Normal.Y >= 0.6 then
            local y = r.Position.Y
            if y >= nearY - TP.FLOOR_DOWN and y <= nearY + TP.FLOOR_UP then
                return y, r.Instance
            end
            return nil
        end
        table.insert(ex, r.Instance)
    end
    return nil
end

-- true when a character standing with its feet on floorY fits at (x, z)
function TP.bodyFits(x, z, floorY)
    local ex = {}
    if Me.Character then table.insert(ex, Me.Character) end
    local op = OverlapParams.new()
    op.FilterType = Enum.RaycastFilterType.Exclude
    op.FilterDescendantsInstances = ex
    local center = CFrame.new(x, floorY + 0.3 + TP.BODY_H / 2, z)
    local size = Vector3.new(TP.BODY_W, TP.BODY_H, TP.BODY_W)
    for _, part in ipairs(Workspace:GetPartBoundsInBox(center, size, op)) do
        if part.CanCollide then return false end
    end
    return true
end

-- the parts a prompt is attached to (its own table or plate). Looks 6 levels up at most.
function TP.attachedTo(prompt)
    local set, cur, n = {}, prompt.Parent, 0
    while cur and cur ~= Workspace and n < 6 do
        set[cur] = true
        cur = cur.Parent
        n += 1
    end
    return set
end

function TP.ownsInstance(own, inst)
    local cur = inst
    while cur and cur ~= Workspace do
        if own[cur] then return true end
        cur = cur.Parent
    end
    return false
end

-- true when nothing solid blocks the line between two points,
-- except parts that belong to the prompt's own table or plate
function TP.lineClear(fromPos, toPos, own)
    local ex = {}
    if Me.Character then table.insert(ex, Me.Character) end
    local delta = toPos - fromPos
    local dist = delta.Magnitude
    if dist < 0.5 then return true end
    local dir = delta.Unit * dist
    for _ = 1, 8 do
        local p = RaycastParams.new()
        p.FilterType = Enum.RaycastFilterType.Exclude
        p.FilterDescendantsInstances = ex
        local r = Workspace:Raycast(fromPos, dir, p)
        if not r then return true end
        if r.Distance >= dist - 0.6 then return true end
        if r.Instance.CanCollide and not (own and TP.ownsInstance(own, r.Instance)) then return false end
        table.insert(ex, r.Instance)
    end
    return true
end

function TP.promptLineOK(prompt, fromPos)
    if not prompt or prompt.RequiresLineOfSight == false then return true end
    local pos = promptAnchor(prompt)
    if not pos then return false end
    return TP.lineClear(fromPos + Vector3.new(0, 1.2, 0), pos, TP.attachedTo(prompt))
end

-- the best clear standing spot near `target` (a Vector3): returns a CFrame for the
-- HumanoidRootPart, or nil plus a reason. prompt is optional; when given, the spot
-- must also see the prompt (unless the prompt does not need line of sight).
function TP.findStandCF(target, maxR, prompt)
    local _, hrp, hum = charParts()
    if not hrp or not target or not finite(target) then return nil, "no target" end
    maxR = (maxR and maxR > 0) and maxR or 10
    local limit = math.max(1.2, maxR - TP.REACH_PAD)
    local rootH = TP.rootHeight(hum, hrp)
    local here = hrp.Position
    local own = prompt and TP.attachedTo(prompt) or nil
    local needLOS = prompt ~= nil and prompt.RequiresLineOfSight ~= false

    local rings = {}
    for _, r in ipairs(TP.RINGS) do
        if r <= limit then table.insert(rings, r) end
    end
    if #rings == 0 then table.insert(rings, limit * 0.8) end

    -- candidates on the rings, nearest to where we stand now first (least travel)
    local cands = {}
    for _, r in ipairs(rings) do
        for i = 0, TP.ANGLES - 1 do
            local a = (i / TP.ANGLES) * math.pi * 2
            local x, z = target.X + math.cos(a) * r, target.Z + math.sin(a) * r
            table.insert(cands, { x = x, z = z, d = Vector3.new(x - here.X, 0, z - here.Z).Magnitude })
        end
    end
    table.sort(cands, function(p, q) return p.d < q.d end)

    -- pass 1 wants line of sight to the prompt; pass 2 accepts any clear spot
    local passes = needLOS and 2 or 1
    for pass = 1, passes do
        for i = 1, math.min(#cands, TP.MAX_CHECKS) do
            local c = cands[i]
            local fy, hitPart = TP.floorAt(c.x, c.z, target.Y)
            if fy and not (own and hitPart and TP.ownsInstance(own, hitPart)) then
                local spot = Vector3.new(c.x, fy + rootH, c.z)
                if (spot - target).Magnitude <= maxR - 0.5 and TP.bodyFits(c.x, c.z, fy) then
                    local los = (not needLOS) or pass == 2 or TP.lineClear(spot + Vector3.new(0, 1.2, 0), target, own)
                    if los then
                        return CFrame.lookAt(spot, Vector3.new(target.X, spot.Y, target.Z)), nil
                    end
                end
            end
        end
    end
    return nil, "no clear spot near the target"
end

-- snaps the whole character so its HumanoidRootPart lands on cf (one PivotTo call)
function TP.snapTo(cf)
    local char, hrp = charParts()
    if not char or not hrp then return false end
    local gap = os.clock() - TP.lastSnap
    if gap < TP.MIN_GAP then task.wait(TP.MIN_GAP - gap) end
    -- PivotTo moves the model's pivot, so convert the wanted HRP position into a pivot position
    local offset = char:GetPivot():Inverse() * hrp.CFrame
    char:PivotTo(cf * offset:Inverse())
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
    TP.lastSnap = os.clock()
    return true
end

function TP.pause()
    return TP.PAUSE_MIN + math.random() * (TP.PAUSE_MAX - TP.PAUSE_MIN)
end

--------------------------------------------------------------------------------
-- PUBLIC MOVEMENT FUNCTIONS (same names and return values as before)
--------------------------------------------------------------------------------

-- moves the character to cf in one snap and confirms it landed.
-- returns true, or false plus a reason
local function safeTeleportCF(cf)
    local _, hrp, hum = charParts()
    if not hrp then return false, "no character" end
    TP.unseat(hum)
    TP.snapTo(cf)
    task.wait() -- one frame: a server correction shows up here
    local _, hrp2 = charParts()
    if not hrp2 then return false, "character lost" end
    if (hrp2.Position - cf.Position).Magnitude > TP.LAND_TOL then
        -- pushed back: try the same spot once more
        TP.snapTo(cf)
        task.wait()
        _, hrp2 = charParts()
        if not hrp2 or (hrp2.Position - cf.Position).Magnitude > TP.LAND_TOL then
            return false, "did not land (moved back)"
        end
    end
    task.wait(TP.pause())
    return true
end

-- walks the character to a clear spot within reach of pos.
-- prompt is optional (adds the line-of-sight check). Returns true, or false plus a reason
local function safeTeleport(pos, maxRange, prompt)
    local _, hrp = charParts()
    if not hrp or not pos or not finite(pos) then return false, "no position" end
    local maxR = (maxRange and maxRange > 0) and maxRange or 10
    if (hrp.Position - pos).Magnitude <= maxR - TP.REACH_PAD and TP.promptLineOK(prompt, hrp.Position) then
        return true
    end
    local cf, why = TP.findStandCF(pos, maxR, prompt)
    if not cf then return false, why end
    return safeTeleportCF(cf)
end

local function press(prompt) return pressPromptFast(prompt, false) end
local function fire(prompt) if fireproximityprompt then pcall(fireproximityprompt, prompt) end end

local function inReach(prompt)
    local _, hrp = charParts()
    local pos = promptAnchor(prompt)
    if not hrp or not pos then return false end
    local maxR = prompt.MaxActivationDistance
    if maxR <= 0 then maxR = 10 end
    return (hrp.Position - pos).Magnitude <= math.max(maxR - 1.5, 1.5)
end

-- gets the character within use range of a prompt, with line of sight.
-- returns true, or false plus a reason
local function goToPrompt(prompt)
    local pos = promptAnchor(prompt)
    if not pos then return false, "no position" end
    local maxR = prompt.MaxActivationDistance
    if maxR <= 0 then maxR = 10 end
    local ok, why = safeTeleport(pos, maxR, prompt)
    if not ok then return false, why end
    return true
end

-- used by Auto Decor and older callers: a standing CFrame near pos, or nil
local function standNear(pos, dist)
    local cf = TP.findStandCF(pos, (dist or 2.5) + 2, nil)
    return cf
end

-- a standing CFrame for an anchor point, or nil plus a reason
local function standSpot(anchor, maxRange, awayFrom, dist)
    local cf, why = TP.findStandCF(anchor, maxRange or 10, nil)
    if cf then return cf end
    return nil, why or "no clear spot"
end
