local function counterSweep(npcId)
    local cands, total = counterCandidates() if #cands == 0 then return false, "no tables in plot" end
    for _, e in ipairs(cands) do if not M.counter.enabled then return false, "stopped" end if e.tbl.Parent then local res, why = assignSeat(npcId, e.tbl, e.seat) if res and res.Success then C.cursor = (e.slot + 1) % total return true, e.tbl.Name .. " S" .. e.seat end if res then C.lastReject = summarize(res) local wait_ = CFG.MIN_DELAY local retry = tonumber(res.RetryAfter) if retry then wait_ = math.max(wait_, retry + 0.03) end task.wait(wait_) else C.lastReject = tostring(why) task.wait(CFG.MIN_DELAY) end end end
    return false, "no seat accepted"
end
local REJECT_FORMS = {
    function(rf, id, uuid) rf:FireServer({ NpcId = id }, uuid) end,
    function(rf, id, uuid) rf:FireServer(id, uuid) end,
}
local function rejectOnCounter(npcId)
    local rf = remote("RejectNPC")
    if not rf or not rf:IsA("RemoteEvent") then return false, "RejectNPC not found" end
    local lastReply = nil
    for i, send in ipairs(REJECT_FORMS) do
        local uuid = HttpService:GenerateGUID(false)
        C.pending[uuid] = false
        send(rf, npcId, uuid)
        local t0 = os.clock()
        while C.pending[uuid] == false and os.clock() - t0 < CFG.RESULT_TIMEOUT do task.wait() end
        local res = C.pending[uuid]
        C.pending[uuid] = nil
        if type(res) == "table" then
            if res.Success then return true, "form " .. i end
            lastReply = summarize(res)
        else
            local ok2, info2 = invoke("GetCounterInfo")
            if ok2 and (type(info2) ~= "table" or info2.NpcId ~= npcId) then
                return true, "form " .. i .. " (counter moved on)"
            end
        end
    end
    return false, lastReply or "no answer from RejectNPC"
end
local function counterTick()
    scanUiSeats()
    local ok, info = invoke("GetCounterInfo")
    if not ok or type(info) ~= "table" or not info.NpcId then M.counter.status = "waiting for a customer" return 0.6 end
    if type(info.PlotName) == "string" then C.plotName = info.PlotName end
    local npcId, now = info.NpcId, os.clock()
    local label = tostring(info.TemplateName or "NPC")
    local rar = rarityOf(label)
    if (C.handled[npcId] or 0) > now then M.counter.status = "waiting (already handled)" return 0.6 end
    if rar and REJECT_LIST[rar] then
        M.counter.status = "rejecting " .. label .. " (" .. rar .. ")"
        local okR, how = rejectOnCounter(npcId)
        if okR then
            C.handled[npcId] = now + CFG.SEATED_BLOCK
            M.counter.status = "rejected " .. label .. " (" .. how .. ")"
            log("counter", "rejected " .. label .. " (" .. rar .. ") via " .. how, THEME.red)
        else
            C.handled[npcId] = now + CFG.FAIL_BLOCK
            M.counter.status = "reject failed: " .. tostring(how)
            log("counter", label .. " reject failed: " .. tostring(how), THEME.orange)
        end
        return 0.3
    end
    M.counter.status = "assigning " .. label
    local seated, what = counterSweep(npcId) C.handled[npcId] = now + (seated and CFG.SEATED_BLOCK or CFG.FAIL_BLOCK)
    if seated then M.counter.status = "seated " .. label .. " @ " .. tostring(what) log("counter", "seated " .. label .. " @ " .. tostring(what), THEME.green) return 0.3 end
    M.counter.status = "no seat: " .. tostring(what) log("counter", label .. ": " .. tostring(what) .. (C.lastReject and (" | " .. C.lastReject) or ""), THEME.orange) return 1
end

