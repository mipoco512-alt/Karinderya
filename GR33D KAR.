function api:Destroy()
    if not alive then return end
    self:Stop()
    capture:Destroy(); motion:Destroy(); objectObserver:Destroy()
    record("info", "session.unload", "Inspector unloaded")
    journal:Close(); alive = false
    if dashboard then dashboard:Destroy() end
