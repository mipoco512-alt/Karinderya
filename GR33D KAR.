local function heldFoods()
    local out = {}
    for _, c in ipairs(containers()) do
        for _, t in ipairs(c:GetChildren()) do
            if t:GetAttribute("IsFood") or t:GetAttribute("OrderKey") then table.insert(out, t) end
        end
    end
    return out
end
local function countHeldFoods() return #heldFoods() end
local function targetOf(cooked)
    local tv = cooked:FindFirstChild("TargetTableSlot", true)
    if tv and tv:IsA("ObjectValue") and tv.Value and tv.Value.Parent then return tv.Value end
    return nil
end
local function pressGet(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local orig = prompt.MaxActivationDistance
    pcall(function() prompt.MaxActivationDistance = math.max(orig, 50) end)
    if fireproximityprompt then pcall(fireproximityprompt, prompt) end
    pcall(function() prompt:InputHoldBegin() end)
    task.wait(math.random(1, 3) / 100)
    pcall(function() prompt:InputHoldEnd() end)
    pcall(function() prompt.MaxActivationDistance = orig) end)
    return true
end
local function collectOne(entry)
    local prompt = entry.prompt
    local pos = promptAnchor(prompt)
    if not pos then return false, "no anchor" end
    local before = countHeldFoods()
    local _, hrp = charParts()
    if not hrp then return false, "no character" end
    if not inReach(prompt) then
        local ok, why = safeTeleport(pos, prompt.MaxActivationDistance)
        if not ok then return false, why end
        task.wait(math.random(10, 20) / 100)
    end
    for _ = 1, 3 do
        if not (prompt.Parent and prompt.Enabled) then break end
        pressGet(prompt)
        if waitFor(function() return countHeldFoods() > before end, 0.35) then return true end
        if fireproximityprompt and prompt.Parent and prompt.Enabled then
            pcall(fireproximityprompt, prompt)
            if waitFor(function() return countHeldFoods() > before end, 0.35) then return true end
        end
    end
    return false, "Get not confirmed"
end
local function getReadyFoodList()
    local list, why = {}, nil
    local plot = plotGet()
    local serve = plot and plot:FindFirstChild("Serve")
    if not serve then return list, "no Serve folder" end
    local now = os.clock()
    for _, model in ipairs(serve:GetDescendants()) do
        if model:IsA("Model") and model.Name:match("^Cooked_") then
            COL.seen[model] = COL.seen[model] or now
            local dish = model.Name:gsub("^Cooked_", "")
            local key = normName(dish)
            for _, prompt in ipairs(model:GetDescendants()) do
                if prompt:IsA("ProximityPrompt") then
                    if not prompt.Enabled then
                        COL.since[prompt] = nil
                        if COL.missed[prompt] then COL.wentOff[prompt] = true end
                    else
                        COL.since[prompt] = COL.since[prompt] or now
                        if normName(prompt.ActionText) == key and prompt.ObjectText:match("^Table") then
                            local r
                            if (COL.skip[prompt] or 0) > now then r = "cooling down"
                            elseif now - COL.seen[model] < 0.6 then r = "plate just appeared"
                            elseif now - COL.since[prompt] < CFG.READY_SETTLE then r = "Get settling"
                            elseif COL.missed[prompt] and not COL.wentOff[prompt] and now - COL.missed[prompt] < CFG.MISS_RETRY then
                                r = "Get not available again yet"
                            end
                            if r then why = r
                            else table.insert(list, { model = model, prompt = prompt, dish = dish }) break end
                        end
                    end
                end
            end
        end
    end
    return list, why
end
local function collectTick()
    if countHeldFoods() >= CFG.MAX_CARRY then
        M.collect.status = "carry full (" .. CFG.MAX_CARRY .. ")"
        return 1
    end
    local ready, why = getReadyFoodList()
    if #ready == 0 then
        M.collect.status = why and ("waiting: " .. why) or "no food ready"
        return 1
    end
    local _, hrp = charParts()
    table.sort(ready, function(a, b)
        local pa, pb = promptAnchor(a.prompt), promptAnchor(b.prompt)
        local da = (hrp and pa) and (hrp.Position - pa).Magnitude or math.huge
        local db = (hrp and pb) and (hrp.Position - pb).Magnitude or math.huge
        return da < db
    end)
    local e = ready[1]
    wants("collect")
    local before = {}
    for _, f in ipairs(heldFoods()) do before[f] = true end
    local ok, res, reason = withMove("collect", function() return collectOne(e) end)
    if not ok then M.collect.status = tostring(res) return 0.5 end
    if res then
        counts.collected += 1
        local target = targetOf(e.model)
        for _, f in ipairs(heldFoods()) do
            if not before[f] then S.tableOf[f] = target end
        end
        COL.missed[e.prompt] = nil
        COL.wentOff[e.prompt] = nil
        M.collect.status = "got " .. tostring(e.dish) .. " (" .. countHeldFoods() .. " total)"
        log("collect", "got " .. tostring(e.dish), THEME.green)
        -- Random delay between 0.2s and 0.45s to avoid rapid-fire teleport flags
        return math.random(20, 45) / 100
    end
    COL.skip[e.prompt] = os.clock() + 2
    COL.missed[e.prompt] = os.clock()
    COL.wentOff[e.prompt] = false
    M.collect.status = "missed " .. tostring(e.dish) .. ": " .. tostring(reason)
    return 0.4
end

