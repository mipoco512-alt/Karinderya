            note("gui-click", { path = instance:GetFullName(), class = instance.ClassName,
                text = instance:IsA("TextButton") and instance.Text:sub(1, 160) or instance.Name })
        end, list)
    elseif instance:IsA("Tool") and (instance:IsDescendantOf(player.Backpack) or (player.Character and instance:IsDescendantOf(player.Character))) then
        local list = {}
        watched[instance] = list
        connect(instance.Activated, function() note("tool-activated", { path = instance:GetFullName(), name = instance.Name }) end, list)
    end
end
