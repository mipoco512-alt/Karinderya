-- Karinderya Operations v2. Read README.md for controls and live integration status.

local Policy = (function()
-- Pure prompt classification and scheduling policy; no Roblox or executor globals.
local Policy = {}

local categories = { accept = true, cook = true, serve = true, clean = true }

function Policy.normalize(value)
	if type(value) ~= "string" then
		return ""
	end
	local text = value:gsub("([a-z])([A-Z])", "%1 %2"):lower()
	text = text:gsub("[^%w]+", " "):gsub("%s+", " ")
	return text:match("^%s*(.-)%s*$")
end

local function contains(text, phrase)
	return string.find(" " .. text .. " ", " " .. phrase .. " ", 1, true) ~= nil
end

local function any(text, phrases)
	for _, phrase in ipairs(phrases) do
		if contains(text, phrase) then
			return true
		end
	end
	return false
end

local economy = {
	"purchase", "buy", "upgrade", "sell", "reject", "decline", "delete", "destroy",
	"hire", "repair", "expand", "expansion", "unlock", "shop", "storefront", "marketplace",
	"furnish", "decorate", "decoration", "restock", "donate", "tip", "robux", "gamepass",
}
local workers = { "worker", "workers", "employee", "employees", "staff", "waiter", "cashier", "chef" }
local customers = { "customer", "customers", "guest", "guests", "diner", "diners", "patron", "patrons" }
local food = {
	"food", "meal", "meals", "dish", "dishes", "rice", "soup", "fish", "pork", "chicken",
	"beef", "noodles", "egg", "eggs", "adobo", "sinigang", "pancit", "sisig", "tinola",
	"bulalo", "lumpia", "silog", "tocino", "longganisa", "tapa", "caldereta", "menudo",
	"shanghai", "prawn", "prawns", "alimango", "lobster", "ginisang ampalaya", "lechon kawali",
	"tuna", "squid", "crispy ulo",
}
local stoves = { "stove", "burner", "range", "grill", "wok", "pot", "pan", "cooker", "oven", "cooking station" }
local dirty = { "dirty", "soiled", "used dishes", "used plates", "trash", "garbage", "spill", "stain" }
local ready = { "cooked", "ready", "finished", "prepared" }
local cleanTargets = { "table", "tables", "dish", "dishes", "plate", "plates", "counter", "floor", "sink", "trash", "garbage", "spill" }
local furniture = { "furniture", "table", "chair", "stove", "counter", "sink", "decoration", "appliance", "wall", "floor" }
local pickupActions = { "take", "collect", "pickup", "pick up" }

function Policy.classify(actionText, objectText, ancestorContext, overrides)
	local action = Policy.normalize(actionText)
	local object = Policy.normalize(objectText)
	local context = Policy.normalize(ancestorContext)
	local target = object .. " " .. context
	local all = action .. " " .. target

	-- These vetoes precede overrides. An exact override must never authorize a purchase.
	if any(all, economy) then
		return nil, "economy or destructive action"
	end
	local placingFoodOnSurface = contains(action, "place") and any(action, food)
		and any(object, { "table", "counter" })
	if any(action, { "place", "move", "rotate", "build", "reposition" })
		and (any(action, furniture) or (any(object, furniture) and not placingFoodOnSurface)) then
		return nil, "furniture placement"
	end
	if any(all, workers) and any(action, { "assign", "unassign", "manage", "fire", "dismiss", "equip" }) then
		return nil, "worker management"
	end
	if any(action, { "equip", "unequip", "open", "close", "inspect", "view", "claim", "redeem" })
		or any(all, { "reward", "rewards", "daily bonus", "quest", "achievement", "inventory", "menu" }) then
		return nil, "outside gameplay loop"
	end
	if action == "" then
		return nil, "empty action"
	end

	local hasFood = any(all, food)
	local hasCustomer = any(all, customers)
	local hasDirty = any(all, dirty)
	local hasReady = any(all, ready)
	local hasCleanTarget = any(all, cleanTargets)
	local hasPickup = any(action, pickupActions)
	local candidate
	local source = "recognized prompt"
	local override = type(overrides) == "table" and overrides[action .. "|" .. object] or nil
	if categories[override] then
		candidate = override
		source = "exact override"
	else
		local matches = {}
		if (any(action, { "accept", "assign", "seat" }) and hasCustomer)
			or any(action, { "take order", "take orders", "accept order" }) then
			matches[#matches + 1] = "accept"
		end
		if any(action, { "cook", "cooking" }) and (hasFood or any(all, stoves) or contains(action, "start cooking")) then
			matches[#matches + 1] = "cook"
		end
		if (any(action, { "serve", "deliver" }) and (hasFood or hasCustomer))
			or (contains(action, "place") and hasFood
				and any(target, { "serve", "serving", "counter", "customer", "table" })
				and not any(object, stoves))
			or (hasPickup and hasReady and hasFood) then
			matches[#matches + 1] = "serve"
		end
		if (any(action, { "clean", "wash", "wipe", "mop", "sanitize" }) and hasCleanTarget)
			or (hasPickup and hasDirty and hasCleanTarget)
			or (any(action, { "throw away", "throw trash", "dispose", "drop bag", "empty bin" })
				and any(all, { "trash", "garbage", "rubbish", "trash bag", "trash bin" })) then
			matches[#matches + 1] = "clean"
		end
		if #matches > 1 then
			return nil, "conflicting action categories"
		end
		candidate = matches[1]
	end

	if not candidate then
		return nil, "unrecognized prompt"
	end
	if hasDirty and candidate ~= "clean" then
		return nil, "dirty target conflicts with action"
	end
	if hasReady and hasFood and (candidate == "cook" or candidate == "clean") then
		return nil, "prepared food conflicts with action"
	end
	if candidate == "accept" and any(object, workers) then
		return nil, "worker is not a customer"
	end
	if candidate == "accept" and any(object, food) and not any(object, customers) then
		return nil, "food target conflicts with customer action"
	end
	if candidate == "cook" and any(object, customers) then
		return nil, "customer conflicts with cooking"
	end
	if candidate == "clean" and any(object, customers) and not any(object, cleanTargets) then
		return nil, "customer conflicts with cleaning"
	end
	if candidate == "clean" and any(object, food) and not any(object, cleanTargets) then
		return nil, "food target conflicts with cleaning"
	end
	return candidate, source
end

local priority = { serve = 400, clean = 300, cook = 200, accept = 100 }

local function nonnegative(value, fallback)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return math.max(0, value)
end

function Policy.score(category, distance, waitingSeconds)
	local base = priority[category]
	if not base then
		return -math.huge
	end
	-- Equal-age tasks retain category order at every distance. After two minutes,
	-- an old customer can outrank new serving work, even at the distance penalty cap.
	local proximityPenalty = math.min(nonnegative(distance, 80), 80) * 0.5
	local ageBonus = math.min(nonnegative(waitingSeconds, 0), 120) * 3
	return base - proximityPenalty + ageBonus
end

return Policy

end)()

local RetryState = (function()
-- Pure retry accounting. Async work captures generation before it starts;
-- property changes invalidate its completion even if the prompt later looks identical.
local RetryState = {}

function RetryState.new(now)
	return {
		generation = 0,
		tries = 0,
		moveFailures = 0,
		nextAt = 0,
		seenAt = now,
	}
end

function RetryState.changed(state, now)
	state.generation += 1
	state.tries = 0
	state.moveFailures = 0
	state.nextAt = 0
	state.seenAt = now
end

function RetryState.attempted(state, capturedGeneration, now, cooldown)
	if state.generation ~= capturedGeneration then
		return false
	end
	state.tries += 1
	state.moveFailures = 0
	state.nextAt = now + cooldown * 2 ^ (state.tries - 1)
	state.seenAt = now
	return true
end

function RetryState.moveFailed(state, capturedGeneration, now)
	if state.generation ~= capturedGeneration then
		return false
	end
	state.moveFailures = math.min(6, state.moveFailures + 1)
	state.nextAt = now + math.min(30, 2 ^ state.moveFailures)
	state.seenAt = now
	return true
end

return RetryState

end)()

local Features = (function()
-- Conservative gameplay metadata helpers. Safe to load outside Roblox.
local Features = {}

function Features.normalize(value)
	if type(value) ~= "string" then return "" end
	return (value:lower():gsub("%s+", " "):match("^%s*(.-)%s*$"))
end

local function property(instance, key)
	local ok, value = pcall(function() return instance[key] end)
	if ok then return value end
	return nil
end

local function isA(instance, className)
	local ok, result = pcall(function() return instance:IsA(className) end)
	return ok and result == true
end

local function instanceLike(value)
	local kind = type(value)
	return (kind == "userdata" or kind == "table")
		and type(property(value, "IsA")) == "function"
		and type(property(value, "GetChildren")) == "function"
end

local function attribute(instance, name)
	local ok, value = pcall(function() return instance:GetAttribute(name) end)
	if ok then return value end
	return nil
end

local function children(instance, recursive)
	local ok, result = pcall(function()
		if recursive then return instance:GetDescendants() end
		return instance:GetChildren()
	end)
	return ok and type(result) == "table" and result or {}
end

local function plainText(value)
	if type(value) ~= "string" then return "" end
	return Features.normalize(value:gsub("<[^>]*>", ""))
end

local rarityKeys = { "Rarity", "CustomerRarity", "Tier" }
local rarityKeySet = { Rarity = true, CustomerRarity = true, Tier = true }

local function rarityText(value)
	local text = plainText(value)
	text = text:gsub("^customer%s+rarity%s*:%s*", "")
	text = text:gsub("^rarity%s*:%s*", ""):gsub("^tier%s*:%s*", "")
	if text == "" or text == "rarity" or text == "customer rarity" or text == "tier" then return nil end
	return text
end

local function insideBillboard(instance, npc)
	local cursor = property(instance, "Parent")
	while cursor and cursor ~= npc do
		if isA(cursor, "BillboardGui") then return true end
		cursor = property(cursor, "Parent")
	end
	return false
end

function Features.rarity(npc)
	if not instanceLike(npc) then return nil end
	for _, key in ipairs(rarityKeys) do
		local value = rarityText(attribute(npc, key))
		if value then return value end
	end
	local result
	for _, child in ipairs(children(npc, true)) do
		local value
		if isA(child, "StringValue") and rarityKeySet[property(child, "Name")] then
			value = rarityText(property(child, "Value"))
		elseif isA(child, "TextLabel")
			and Features.normalize(property(child, "Name")):find("rarity", 1, true)
			and insideBillboard(child, npc) then
			value = rarityText(property(child, "Text"))
		end
		-- Conflicting visible metadata cannot safely select a filter tier.
		if value then
			if result and result ~= value then return nil end
			result = value
		end
	end
	return result
end

function Features.rarityAllowed(rarity, filterEnabled, allowedMap, allowUnknown)
	if not filterEnabled then return true end
	local normalized = Features.normalize(rarity)
	if normalized == "" then return allowUnknown == true end
	if type(allowedMap) ~= "table" then return false end
	for name, allowed in pairs(allowedMap) do
		if allowed == true and Features.normalize(name) == normalized then return true end
	end
	return false
end

local npcIdKeys = { "NPCId", "NpcId", "UUID", "Id" }
local payloadKeys = { "npc", "NPC", "npcModel", "NPCModel", "npcId", "NPCId", "target" }

local function resolveScalar(value, npcFolder, visited)
	if instanceLike(value) then
		if visited[value] then return nil end
		visited[value] = true
		if isA(value, "ObjectValue") or isA(value, "StringValue") then
			return resolveScalar(property(value, "Value"), npcFolder, visited)
		end
		local cursor = value
		while cursor and cursor ~= npcFolder do
			if property(cursor, "Parent") == npcFolder then
				return isA(cursor, "Model") and cursor or nil
			end
			cursor = property(cursor, "Parent")
		end
		return nil
	end
	if type(value) ~= "string" or value == "" then return nil end
	local result
	for _, npc in ipairs(children(npcFolder, false)) do
		if isA(npc, "Model") then
			local matched = property(npc, "Name") == value
			for _, key in ipairs(npcIdKeys) do
				if attribute(npc, key) == value then matched = true end
			end
			if matched then
				if result and result ~= npc then return nil end
				result = npc
			end
		end
	end
	return result
end

function Features.resolveNPC(payload, npcFolder)
	if not isA(npcFolder, "Folder") or property(npcFolder, "Name") ~= "ClientNPCs" then return nil end
	if instanceLike(payload) or type(payload) ~= "table" then
		return resolveScalar(payload, npcFolder, {})
	end
	local result
	for _, key in ipairs(payloadKeys) do
		local value = rawget(payload, key)
		if value ~= nil then
			local candidate = resolveScalar(value, npcFolder, {})
			if not candidate or (result and candidate ~= result) then return nil end
			result = candidate
		end
	end
	return result
end

local runawayKeys = { "IsRunaway", "Runaway", "IsRunningAway" }
local runawayKeySet = { IsRunaway = true, Runaway = true, IsRunningAway = true }
local stateKeys = { "State", "Status" }
local stateKeySet = { State = true, Status = true }

function Features.runawayState(npc)
	if not instanceLike(npc) then return nil end
	local explicit
	for _, key in ipairs(runawayKeys) do
		local value = attribute(npc, key)
		if value == false then return false end
		if value == true then explicit = true end
	end
	for _, child in ipairs(children(npc, false)) do
		if isA(child, "BoolValue") and runawayKeySet[property(child, "Name")] then
			local value = property(child, "Value")
			if value == false then return false end
			if value == true then explicit = true end
		end
	end
	if explicit ~= nil then return explicit end
	local state
	local function readState(value)
		local text = Features.normalize(value):gsub("%s", "")
		if text == "" then return end
		local running = text == "runaway" or text == "runningaway"
		if state == nil then state = running elseif not running then state = false end
	end
	for _, key in ipairs(stateKeys) do readState(attribute(npc, key)) end
	for _, child in ipairs(children(npc, false)) do
		if isA(child, "StringValue") and stateKeySet[property(child, "Name")] then
			readState(property(child, "Value"))
		end
	end
	return state
end

function Features.isRunaway(npc)
	return Features.runawayState(npc) == true
end

local function finiteNonnegative(value)
	return type(value) == "number" and value == value and value >= 0 and value < math.huge
end

local function numericText(value)
	if type(value) ~= "string" then return nil end
	local whole, fraction = value:match("^(%d[%d,]*)%.(%d+)$")
	if not whole then whole = value:match("^(%d[%d,]*)$") end
	if not whole then return nil end
	if whole:find(",", 1, true) then
		local first = true
		for group in whole:gmatch("[^,]+") do
			if (first and (#group < 1 or #group > 3)) or (not first and #group ~= 3) then return nil end
			first = false
		end
		if whole:find(",,", 1, true) or whole:sub(-1) == "," then return nil end
	end
	local valueNumber = tonumber((whole:gsub(",", "")) .. (fraction and "." .. fraction or ""))
	return finiteNonnegative(valueNumber) and valueNumber or nil
end

function Features.stockText(text)
	local normalized = plainText(text)
	if normalized == "out of stock" or normalized == "sold out" then return 0 end
	local number = normalized:match("^stock%s*:%s*([%d%.,]+)$")
		or normalized:match("^([%d%.,]+)%s+in%s+stock$")
	return numericText(number)
end

local stockKeys = { "Stock", "StockAmount", "RemainingStock", "QuantityInStock" }

function Features.stockAmount(instance)
	if not instanceLike(instance) then return nil end
	for _, key in ipairs(stockKeys) do
		local value = attribute(instance, key)
		if value ~= nil then return finiteNonnegative(value) and value or nil end
	end
	local direct = children(instance, false)
	for _, key in ipairs(stockKeys) do
		for _, child in ipairs(direct) do
			if property(child, "Name") == key and isA(child, "ValueBase") then
				local value = property(child, "Value")
				if type(value) == "string" then value = numericText(value) end
				return finiteNonnegative(value) and value or nil
			end
		end
	end
	local result
	local labels = children(instance, true)
	table.insert(labels, instance)
	for _, label in ipairs(labels) do
		if isA(label, "TextLabel") or isA(label, "TextButton") or isA(label, "TextBox") then
			local value = Features.stockText(property(label, "Text"))
			if value ~= nil then
				if result ~= nil and result ~= value then return nil end
				result = value
			end
		end
	end
	return result
end

function Features.purchaseDecision(row, selected, used, limit)
	if type(row) ~= "table" or selected ~= true then return false end
	if row.supported == false or row.premium == true then return false end
	return finiteNonnegative(row.stock) and row.stock > 0
		and finiteNonnegative(used) and finiteNonnegative(limit) and used < limit
end

return Features

end)()

local createStockCatalog = (function()
-- Discovers observed shop stock. Never invokes remotes or GUI button signals.
local function createStockCatalog(ctx)
    local Features, Policy = ctx.Features, ctx.Policy
    local selected = ctx.selected or {}
    local catalog = {}
    local rows, indexed, states, captures = {}, {}, {}, {}
    local clock = ctx.now or os.clock
    local roots = ctx.roots or { "Grocery", "SHOP", "JunkShop", "HalloweenShop" }
    local stockAttributes = { "Stock", "StockAmount", "StockCount", "CurrentStock", "RemainingStock", "QuantityInStock" }
    local restockAttributes = { "RestockVersion", "RestockGeneration", "LastRestock", "LastRestockTime", "RestockedAt", "RestockTimestamp" }

    local function normalize(value)
        return Policy.normalize(tostring(value or ""))
    end

    local function word(text, target)
        return string.find(" " .. normalize(text) .. " ", " " .. target .. " ", 1, true) ~= nil
    end

    local function validNumber(value)
        return type(value) == "number" and value == value and value >= 0 and value < math.huge
    end

    local function attribute(instance, name)
        local ok, value = pcall(function() return instance:GetAttribute(name) end)
        return ok and value or nil
    end

    local function children(instance, deep)
        local ok, list = pcall(function()
            return deep and instance:GetDescendants() or instance:GetChildren()
        end)
        return ok and list or {}
    end

    local function fullName(instance)
        local ok, value = pcall(function() return instance:GetFullName() end)
        return ok and value or tostring(instance.Name)
    end

    local function inRoot(instance, root)
        return instance == root or instance:IsDescendantOf(root)
    end

    local function premium(instance, text, boundary)
        local normalized = normalize(text)
        for _, term in ipairs({ "robux", "gamepass", "game pass", "developer product", "premium currency" }) do
            if word(normalized, term) then return true end
        end
        if string.find(tostring(text), "R$", 1, true) or string.find(tostring(text), utf8.char(0xE002), 1, true) then return true end
        local current = instance
        for _ = 0, 4 do
            if not current then break end
            for _, name in ipairs({ "GamePassId", "GamepassId", "DeveloperProductId", "RobuxPrice" }) do
                local value = attribute(current, name)
                if value ~= nil and value ~= false and value ~= 0 and value ~= "0" then return true end
            end
            if attribute(current, "RequiresRobux") == true or attribute(current, "IsGamePass") == true then return true end
            local currency = normalize(attribute(current, "Currency"))
            if currency == "robux" or currency == "premium" then return true end
            if current == boundary then break end
            current = current.Parent
        end
        return false
    end

    local function buyAction(action)
        if not (word(action, "buy") or word(action, "purchase")) then return false end
        for _, term in ipairs({ "upgrade", "sell", "hire", "unlock", "expand", "expansion", "restock all", "buy all", "donate", "reroll" }) do
            if word(action, term) then return false end
        end
        return true
    end

    local function excludedItem(text)
        for _, term in ipairs({ "upgrade", "gamepass", "game pass", "robux", "expansion", "worker", "employee", "cash pack", "money pack" }) do
            if word(text, term) then return true end
        end
        return false
    end

    -- Strip only explicitly labelled stock clauses, retaining the actual item label.
    local function itemLabel(text)
        local value = tostring(text or "")
        value = value:gsub("<[bB][rR]%s*/?>", " "):gsub("<[^>]+>", "")
        value = value:gsub("[Ss][Tt][Oo][Cc][Kk]%s*[:=]?%s*%d+%s*/%s*%d+", "")
        value = value:gsub("[Ss][Tt][Oo][Cc][Kk]%s*[:=]?%s*%d+", "")
        value = value:gsub("%d+%s+[Ii][Nn]%s+[Ss][Tt][Oo][Cc][Kk]", "")
        value = value:gsub("[Oo][Uu][Tt]%s+[Oo][Ff]%s+[Ss][Tt][Oo][Cc][Kk]", "")
        value = value:gsub("[Ss][Oo][Ll][Dd]%s+[Oo][Uu][Tt]", "")
        value = value:gsub("[%[%]%(%)|]", " "):gsub("%s+", " ")
        return value:match("^%s*(.-)%s*$")
    end

    local function nearestName(prompt, root)
        local label = itemLabel(prompt.ObjectText)
        if #label > 0 then return label end
        local current = prompt.Parent
        for _ = 1, 4 do
            if not current or current == root then break end
            if current:IsA("Model") then return tostring(current.Name) end
            current = current.Parent
        end
        return nil
    end

    local function textStock(text)
        local ok, value = pcall(Features.stockText, tostring(text or ""))
        return ok and validNumber(value) and value or nil
    end

    local function itemNodes(prompt, root)
        local result, current = {}, prompt
        local label = normalize(itemLabel(prompt.ObjectText))
        for _ = 0, 4 do
            if not current or current == root then break end
            local shared = false
            if current ~= prompt then
                for _, descendant in ipairs(children(current, true)) do
                    if descendant ~= prompt and descendant:IsA("ProximityPrompt") and buyAction(descendant.ActionText) then
                        shared = true
                        break
                    end
                end
            end
            -- A shelf containing multiple products is never an item metadata source.
            if shared then break end
            table.insert(result, current)
            if current ~= prompt and (current:IsA("Model") or current:IsA("GuiObject")
                or (current:IsA("Folder") and label ~= "" and normalize(current.Name) == label)) then break end
            current = current.Parent
        end
        return result
    end

    local function stockAt(prompt, root)
        for _, current in ipairs(itemNodes(prompt, root)) do
            -- Descendant stock labels are confined to this actual item, never a shop/shelf.
            local ok, amount = pcall(Features.stockAmount, current)
            if ok and validNumber(amount) then return amount end
            for _, name in ipairs(stockAttributes) do
                amount = attribute(current, name)
                if validNumber(amount) then return amount end
            end
        end
        local objectStock = textStock(prompt.ObjectText)
        if objectStock ~= nil then return objectStock end
        return textStock(prompt.ActionText)
    end

    local function restockAt(prompt, root)
        for _, current in ipairs(itemNodes(prompt, root)) do
            for _, name in ipairs(restockAttributes) do
                local value = attribute(current, name)
                if validNumber(value) then return fullName(current) .. ":" .. name, value end
            end
        end
        return nil, nil
    end

    local function localValue(instance, name)
        local value = attribute(instance, name)
        if value ~= nil then return value end
        for _, child in ipairs(children(instance, false)) do
            if child.Name == name and child:IsA("ValueBase") then return child.Value end
        end
        return nil
    end

    local function priceFrom(nodes)
        local price, currency
        for _, current in ipairs(nodes) do
            if price == nil then
                for _, name in ipairs({ "Price", "Cost" }) do
                    local value = localValue(current, name)
                    if validNumber(value) then price = value; break end
                end
            end
            if currency == nil then
                local value = localValue(current, "Currency")
                if value ~= nil then currency = value end
            end
        end
        return price, type(currency) == "string" and normalize(currency) == "cash" and "Cash" or nil
    end

    local function priceAt(prompt, root)
        return priceFrom(itemNodes(prompt, root))
    end

    local function snapshot(prompt)
        return tostring(prompt.ObjectText or "") .. "\0" .. tostring(prompt.ActionText or "")
    end

    local function identity(key, name, action)
        return key .. "\0" .. name .. "\0" .. itemLabel(action)
    end

    local function observe(row)
        local state = states[row.key]
        if not state or state.fingerprint ~= row.fingerprint then
            state = { fingerprint = row.fingerprint, instance = row.prompt, generation = 1 }
            states[row.key] = state
        end
        state.instance = row.prompt
        if row.stock ~= nil then
            if state.knownStock ~= nil and state.knownStock ~= row.stock then state.generation += 1 end
            state.knownStock = row.stock
        end
        if row.restockValue ~= nil then
            if state.restockKey == row.restockKey and state.restockValue ~= nil and row.restockValue > state.restockValue then
                state.generation += 1
            end
            if state.restockKey ~= row.restockKey or state.restockValue == nil or row.restockValue > state.restockValue then
                state.restockKey, state.restockValue = row.restockKey, row.restockValue
            end
        end
        row.stockGeneration = state.generation
        if not selected[row.key] then
            captures[row.key] = nil
        elseif type(selected[row.key]) == "string" then
            captures[row.key] = selected[row.key]
        elseif captures[row.key] == nil then
            captures[row.key] = row.fingerprint
        end
        row.selected = selected[row.key] ~= nil and selected[row.key] ~= false
        row.selectionMatches = row.selected and captures[row.key] == row.fingerprint
        if row.selected and not row.selectionMatches then row.status = "Item changed — select again" end
    end

    local function promptRow(prompt, root)
        local action, object = tostring(prompt.ActionText or ""), tostring(prompt.ObjectText or "")
        if not buyAction(action) or excludedItem(action .. " " .. object) then return nil end
        local name = nearestName(prompt, root)
        if not name or excludedItem(name) or premium(prompt, action .. " " .. object .. " " .. name, root) then return nil end
        local key = fullName(prompt)
        local stock = stockAt(prompt, root)
        local price, currency = priceAt(prompt, root)
        local restockKey, restockValue = restockAt(prompt, root)
        local status = stock == nil and "Stock unknown" or (stock <= 0 and "Out of stock" or "In stock")
        if not prompt.Enabled then status = "Prompt unavailable" end
        return {
            key = key, name = name, stock = stock, price = price, currency = currency, prompt = prompt, root = root,
            supported = true, premium = false, enabled = prompt.Enabled == true,
            status = status, fingerprint = identity(key, name, action), snapshotFingerprint = snapshot(prompt),
            restockKey = restockKey, restockValue = restockValue,
        }
    end

    local function visible(instance)
        local current = instance
        while current and current ~= ctx.PlayerGui do
            if current:IsA("GuiObject") and current.Visible == false then return false end
            if current:IsA("ScreenGui") and current.Enabled == false then return false end
            current = current.Parent
        end
        return current == ctx.PlayerGui
    end

    local function recognizedShop(instance)
        local current = instance.Parent
        while current and current ~= ctx.PlayerGui do
            local name = normalize(current.Name)
            if word(name, "shop") or word(name, "grocery") or word(name, "store") or name == "junkshop" or name == "halloweenshop" then
                return current
            end
            current = current.Parent
        end
        return nil
    end

    local function guiRow(button)
        if not visible(button) then return nil end
        local action = button:IsA("TextButton") and tostring(button.Text or "") or tostring(button.Name or "")
        if not buyAction(action) then return nil end
        local shop = recognizedShop(button)
        local card = button.Parent
        if not shop or not card or card == shop then return nil end
        local stock, name
        local texts = { action }
        -- Only immediate siblings within this card qualify. No cross-product labels.
        for _, sibling in ipairs(children(card, false)) do
            if sibling:IsA("TextLabel") and visible(sibling) then
                local label = tostring(sibling.Text or "")
                table.insert(texts, label)
                local amount = textStock(label)
                if amount ~= nil then stock = amount end
                local normalized = normalize(sibling.Name)
                if normalized == "name" or normalized == "item name" or normalized == "product name" or normalized == "title" then
                    name = itemLabel(label)
                end
            end
        end
        if stock == nil then return nil end
        name = name and #name > 0 and name or tostring(card.Name)
        local allText = table.concat(texts, " ") .. " " .. name
        if excludedItem(allText) or premium(button, allText, card) then return nil end
        local key = "gui:" .. fullName(button)
        local price, currency = priceFrom({ button, card })
        return {
            key = key, name = name, stock = stock, price = price, currency = currency, supported = false, premium = false,
            status = "GUI only — manual purchase", fingerprint = identity(key, name, action),
            snapshotFingerprint = allText, enabled = true,
        }
    end

    function catalog:Refresh()
        rows, indexed = {}, {}
        local visited = {}
        for _, configured in ipairs(roots) do
            local root = configured
            if type(configured) == "string" then root = ctx.Workspace:FindFirstChild(configured) end
            if root and inRoot(root, ctx.Workspace) then
                for _, instance in ipairs(children(root, true)) do
                    if instance:IsA("ProximityPrompt") and not visited[instance] then
                        visited[instance] = true
                        local row = promptRow(instance, root)
                        if row then
                            observe(row)
                            if indexed[row.key] then
                                -- Duplicate instance names make a full-name selection ambiguous.
                                row.supported, row.status = false, "Duplicate shop path"
                                indexed[row.key].supported, indexed[row.key].status = false, "Duplicate shop path"
                            end
                            indexed[row.key] = row
                            table.insert(rows, row)
                        end
                    end
                end
            end
        end
        if ctx.PlayerGui then
            for _, instance in ipairs(children(ctx.PlayerGui, true)) do
                if instance:IsA("TextButton") or instance:IsA("ImageButton") then
                    local row = guiRow(instance)
                    if row then observe(row); indexed[row.key] = row; table.insert(rows, row) end
                end
            end
        end
        table.sort(rows, function(a, b)
            if a.name == b.name then return a.key < b.key end
            return a.name < b.name
        end)
        return rows
    end

    function catalog:Rows() return rows end
    function catalog:Get(key) return indexed[key] end

    function catalog:CanAttempt(row, time)
        time = time or clock()
        if not row or indexed[row.key] ~= row then return false, "Refresh stock catalog" end
        if not row.supported or not row.prompt then return false, "Unsupported purchase control" end
        if not selected[row.key] then return false, "Item not selected" end
        local capture = type(selected[row.key]) == "string" and selected[row.key] or captures[row.key]
        if capture ~= row.fingerprint then return false, "Item changed — select again" end
        local prompt = row.prompt
        if not prompt.Parent or not inRoot(prompt, row.root) or fullName(prompt) ~= row.key then return false, "Shop entry moved" end
        if not prompt.Enabled then return false, "Prompt unavailable" end
        if snapshot(prompt) ~= row.snapshotFingerprint then return false, "Shop item changed — refresh" end
        if premium(prompt, prompt.ActionText .. " " .. prompt.ObjectText, row.root) then return false, "Premium purchase excluded" end
        local currentStock = stockAt(prompt, row.root)
        if not validNumber(currentStock) then return false, "Stock unknown" end
        if currentStock <= 0 then return false, "Out of stock" end
        if currentStock ~= row.stock then return false, "Stock changed — refresh" end
        local price, currency = priceAt(prompt, row.root)
        if price ~= row.price or currency ~= row.currency then return false, "Price changed — refresh" end
        local state = states[row.key]
        if not state or state.fingerprint ~= row.fingerprint then return false, "Item changed — refresh" end
        if state.attemptAt and time - state.attemptAt < 10 then return false, "Purchase cooldown" end
        if state.attemptGeneration == row.stockGeneration then return false, "Waiting for stock change" end
        return true, "Ready"
    end

    function catalog:MarkAttempt(key, fingerprint, time)
        local row = indexed[key]
        if not row or row.fingerprint ~= fingerprint then return false end
        local state = states[key]
        if not state or state.fingerprint ~= fingerprint then return false end
        state.attemptAt, state.attemptGeneration = time or clock(), row.stockGeneration
        return true
    end

    return catalog
end

return createStockCatalog

end)()

local createRecorder = (function()
-- Passive recorder for game-origin calls beneath ReplicatedStorage.Remotes.
-- Start() -> success, reason?; Stop() detaches; Destroy() permanently detaches.
-- Entries() returns independent JSON-safe snapshots; Clear() empties the buffer.
-- The process-wide hook stays installed and inert when no recorder owns its sink.
local function createRecorder(env, remotesRoot, log)
    local BUS_KEY = "__KarinderyaRecorderHook"
    local BUS_VERSION = "karinderya-passive-recorder-v1"
    local MAX_RECORDS = 100
    local MAX_ARGUMENTS = 48
    local MAX_DEPTH = 5
    local MAX_TABLE_ENTRIES = 32
    local MAX_NODES = 256
    local MAX_STRING_BYTES = 2048

    local entries = {}
    local sequence = 0
    local destroyed = false
    local attachedBus = nil
    local replicatedStorage = nil
    local recorder = {}

    -- JSON cannot represent non-finite numbers. Tagged values also preserve nils.
    local function encodeNumber(value)
        if value ~= value then
            return { type = "number", value = "NaN" }
        elseif value == math.huge then
            return { type = "number", value = "+Infinity" }
        elseif value == -math.huge then
            return { type = "number", value = "-Infinity" }
        end
        return value
    end

    local function encodeString(value)
        -- Byte strings need an ASCII representation: raw Roblox strings may not
        -- contain valid UTF-8, and a byte limit can split a UTF-8 code point.
        local length = #value
        local limit = math.min(length, MAX_STRING_BYTES)
        if length <= MAX_STRING_BYTES and utf8.len(value) ~= nil then
            return value
        end
        local bytes = table.create(limit)
        for index = 1, limit do
            bytes[index] = string.format("%02x", string.byte(value, index))
        end
        return {
            type = "string",
            encoding = "hex",
            value = table.concat(bytes),
            byteLength = length,
            truncated = length > limit,
        }
    end

    local stringifiableTypes = {
        Axes = true,
        BrickColor = true,
        CFrame = true,
        Color3 = true,
        ColorSequence = true,
        ColorSequenceKeypoint = true,
        DateTime = true,
        EnumItem = true,
        Faces = true,
        Font = true,
        NumberRange = true,
        NumberSequence = true,
        NumberSequenceKeypoint = true,
        PhysicalProperties = true,
        Ray = true,
        Rect = true,
        Region3 = true,
        Region3int16 = true,
        UDim = true,
        UDim2 = true,
        Vector2 = true,
        Vector2int16 = true,
        Vector3 = true,
        Vector3int16 = true,
    }

    local function describeInstance(instance)
        return {
            type = "Instance",
            path = encodeString(instance:GetFullName()),
            class = instance.ClassName,
        }
    end

    local function snapshotArguments(...)
        local seen = {}
        local nextId = 0
        local remaining = MAX_NODES
        local encode

        encode = function(value, depth)
            if remaining <= 0 then
                return { type = "truncated", reason = "node budget" }
            end
            remaining -= 1

            local kind = typeof(value)
            if kind == "nil" then
                return { type = "nil" }
            elseif kind == "boolean" then
                return value
            elseif kind == "number" then
                return encodeNumber(value)
            elseif kind == "string" then
                return encodeString(value)
            elseif kind == "Instance" then
                return describeInstance(value)
            elseif kind == "table" then
                if seen[value] then
                    return { type = "reference", id = seen[value] }
                end
                if depth >= MAX_DEPTH then
                    return { type = "table", truncated = true, reason = "depth limit" }
                end

                nextId += 1
                local id = nextId
                seen[value] = id
                local result = { type = "table", id = id, entries = {} }
                local key, item = next(value)
                local count = 0
                -- next bypasses __pairs; do not run arbitrary table metamethods.
                while key ~= nil do
                    if count >= MAX_TABLE_ENTRIES or remaining < 2 then
                        result.truncated = true
                        result.reason = count >= MAX_TABLE_ENTRIES and "entry limit" or "node budget"
                        break
                    end
                    count += 1
                    result.entries[count] = {
                        key = encode(key, depth + 1),
                        value = encode(item, depth + 1),
                    }
                    key, item = next(value, key)
                end
                return result
            elseif stringifiableTypes[kind] then
                -- Only engine-owned value types are stringified. Unknown userdata,
                -- functions and threads are tagged without invoking metamethods.
                return { type = kind, value = encodeString(tostring(value)) }
            end
            return { type = kind, unsupported = true }
        end

        local count = select("#", ...)
        local result = { n = count, values = {} }
        for index = 1, math.min(count, MAX_ARGUMENTS) do
            result.values[index] = encode(select(index, ...), 0)
        end
        if count > MAX_ARGUMENTS then
            result.truncated = true
        end
        return result
    end

    local function capture(target, method, ...)
        if destroyed or typeof(target) ~= "Instance" then
            return
        end
        if remotesRoot.Parent ~= replicatedStorage or remotesRoot.Name ~= "Remotes" then
            return
        end
        if not target:IsDescendantOf(remotesRoot) then
            return
        end
        if method == "InvokeServer" then
            if not target:IsA("RemoteFunction") then
                return
            end
        elseif not target:IsA("RemoteEvent") and not target:IsA("UnreliableRemoteEvent") then
            return
        end

        local record = {
            sequence = sequence + 1,
            clock = os.clock(),
            method = method,
            remote = describeInstance(target),
            args = snapshotArguments(...),
        }
        sequence += 1
        if #entries >= MAX_RECORDS then
            table.remove(entries, 1)
        end
        entries[#entries + 1] = record
    end

    local function report(message)
        if type(log) == "function" then
            pcall(log, message)
        end
    end

    function recorder:Start()
        if destroyed then
            return false, "Recorder has been destroyed."
        end
        if type(env) ~= "table" then
            return false, "Recorder needs a persistent executor environment table."
        end

        local validRoot, rootError = pcall(function()
            replicatedStorage = game:GetService("ReplicatedStorage")
            assert(typeof(remotesRoot) == "Instance"
                and remotesRoot == replicatedStorage:FindFirstChild("Remotes"),
                "Recorder root must be ReplicatedStorage.Remotes.")
        end)
        if not validRoot then
            return false, tostring(rootError)
        end

        local bus = rawget(env, BUS_KEY)
        if bus ~= nil then
            if type(bus) ~= "table" or rawget(bus, "version") ~= BUS_VERSION
                or rawget(bus, "installed") ~= true then
                return false, "An incompatible recorder hook already occupies " .. BUS_KEY .. "."
            end
        else
            local hook = rawget(env, "hookmetamethod") or hookmetamethod
            local getMethod = rawget(env, "getnamecallmethod") or getnamecallmethod
            local isExecutorCaller = rawget(env, "checkcaller") or checkcaller
            local makeClosure = rawget(env, "newcclosure") or newcclosure
            if type(hook) ~= "function" or type(getMethod) ~= "function"
                or type(isExecutorCaller) ~= "function" then
                return false, "Outgoing recording needs hookmetamethod, getnamecallmethod and checkcaller."
            end

            bus = { version = BUS_VERSION, installed = false, sink = nil }
            local original
            local function intercept(target, ...)
                local sink = rawget(bus, "sink")
                if sink ~= nil then
                    local methodOk, method = pcall(getMethod)
                    if methodOk and (method == "FireServer" or method == "InvokeServer") then
                        local callerOk, caller = pcall(isExecutorCaller)
                        if callerOk and caller == false then
                            -- Snapshot failures never change the game's call.
                            -- capture performs no waits, logging, or network I/O.
                            pcall(sink, target, method, ...)
                        end
                    end
                end
                -- Do not protect this call: preserve original errors and all
                -- return values, including InvokeServer's ordinary yielding.
                return original(target, ...)
            end

            local callback = intercept
            if type(makeClosure) == "function" then
                local closureOk, closure = pcall(makeClosure, intercept)
                if not closureOk or type(closure) ~= "function" then
                    return false, "Executor could not create the recorder closure."
                end
                callback = closure
            end

            local hookOk, previous = pcall(hook, game, "__namecall", callback)
            if not hookOk then
                return false, "Executor could not install the recorder hook: " .. tostring(previous)
            end
            original = previous
            if type(original) ~= "function" then
                -- A broken executor hook cannot be safely restored here: another
                -- hook may already depend on it. Prevent repeated installations.
                rawset(env, BUS_KEY, bus)
                return false, "Executor hook did not return the original namecall function."
            end
            bus.installed = true
            rawset(env, BUS_KEY, bus)
        end

        rawset(bus, "sink", capture)
        attachedBus = bus
        report("Outgoing recorder started (game calls only; up to 100 records).")
        return true
    end

    function recorder:Stop()
        if attachedBus and rawget(attachedBus, "sink") == capture then
            rawset(attachedBus, "sink", nil)
        end
        attachedBus = nil
    end

    function recorder:Destroy()
        recorder:Stop()
        destroyed = true
    end

    function recorder:Clear()
        table.clear(entries)
    end

    function recorder:Entries()
        local function copy(value)
            if type(value) ~= "table" then
                return value
            end
            local result = {}
            for key, item in next, value do
                result[key] = copy(item)
            end
            return result
        end
        return copy(entries)
    end

    return recorder
end

return createRecorder

end)()

local createOperations = (function()
-- Prompt-backed operations only. Metadata comes from the control and its own item/person.
local function createOperations(ctx)
    local operations = {}
    local settings = {
        autoIngredients = false, restockBelow = 10, keepCash = 1000,
        autoSelectedItems = false, autoFurniture = false, autoUpgradeFurniture = false,
        autoUnlockMenus = false, keepMenusEnabled = false, autoCounter = false, autoTables = false,
        autoDrinks = true, autoIhaw = true, rejectMissing = false, trashPerTrip = 5,
        autoHire = false, rolesToFill = "", maxWage = 0, hireRarities = "",
        autoRoll = false, maxRollCost = 0, autoWake = false, autoApplicants = false,
        longRange = false, antiAFK = false, menuKey = "RightShift",
        webhookEnabled = false, webhookUrl = "", webhookInterval = 60,
    }
    operations.Settings = settings
    local selection = { ingredients = {}, shopItems = {}, applicants = {}, staff = {} }
    operations.Selection = selection
    local lists = { ingredients = {}, shopItems = {}, applicants = {}, staff = {} }
    local indexed = { ingredients = {}, shopItems = {}, applicants = {}, staff = {} }
    local observed, requests, completed, statuses, entryIndex = {}, {}, {}, {}, {}
    local selectionInstances = { ingredients = {}, shopItems = {}, applicants = {}, staff = {} }
    local selectedPlot
    local now = ctx.now or os.clock
    local automatic = {
        drinks = "autoDrinks", ihaw = "autoIhaw", wake = "autoWake", hire = "autoHire",
        rollCandidates = "autoRoll", acceptSelected = "autoApplicants", placeBest = "autoFurniture",
        upgradeFurniture = "autoUpgradeFurniture", unlockMenus = "autoUnlockMenus",
        enableMenus = "keepMenusEnabled", upgradeCounter = "autoCounter", buyTables = "autoTables", rejectCustomer = "rejectMissing",
    }
    local manualGroups = { acceptSelected = "applicants", rejectSelected = "applicants", fireSelected = "staff", hire = "applicants" }
    local manualActions = {
        acceptSelected = true, rejectSelected = true, fireSelected = true, placeBest = true,
        upgradeFurniture = true, unlockMenus = true, enableMenus = true,
        upgradeCounter = true, buyTables = true, rollCandidates = true, hire = true,
    }
    local spending = { hire = true, acceptSelected = true, rollCandidates = true, upgradeFurniture = true, unlockMenus = true, upgradeCounter = true, buyTables = true }

    local function property(item, key)
        local ok, value = pcall(function() return item[key] end)
        if ok then return value end
        return nil
    end
    local function isA(item, className)
        local ok, value = pcall(function() return item:IsA(className) end)
        return ok and value == true
    end
    local function children(item)
        local ok, value = pcall(function() return item:GetChildren() end)
        return ok and type(value) == "table" and value or {}
    end
    local function attribute(item, key)
        local ok, value = pcall(function() return item:GetAttribute(key) end)
        if ok then return value end
        return nil
    end
    local function below(item, ancestor)
        if not item or not ancestor then return false end
        local ok, value = pcall(function() return item:IsDescendantOf(ancestor) end)
        return ok and value == true
    end
    local function fullName(item)
        local ok, value = pcall(function() return item:GetFullName() end)
        return ok and type(value) == "string" and value or nil
    end
    local function normalize(value)
        if type(value) ~= "string" then return "" end
        if ctx.Policy and ctx.Policy.normalize then return ctx.Policy.normalize(value) end
        return (value:lower():gsub("[^%w]+", " "):gsub("%s+", " "):match("^%s*(.-)%s*$"))
    end
    local function word(text, term)
        return (" " .. normalize(text) .. " "):find(" " .. term .. " ", 1, true) ~= nil
    end
    local function finite(value)
        return type(value) == "number" and value == value and value >= 0 and value < math.huge
    end
    local function namedChild(item, name)
        local result
        for _, child in ipairs(children(item)) do
            if property(child, "Name") == name then
                if result then return nil end
                result = child
            end
        end
        return result
    end
    local function directValue(item, key)
        local value = attribute(item, key)
        if value ~= nil then return value end
        local child = namedChild(item, key)
        if child and isA(child, "ValueBase") then return property(child, "Value") end
        return nil
    end
    local function metadata(prompt, target, keys)
        for _, source in ipairs({ prompt, target }) do
            for _, key in ipairs(keys) do
                local value = directValue(source, key)
                if value ~= nil then return value end
            end
        end
        return nil
    end
    local function csvContains(csv, value)
        local expected = normalize(value)
        if expected == "" or type(csv) ~= "string" then return false end
        for entry in csv:gmatch("[^,;\n]+") do
            if normalize(entry) == expected then return true end
        end
        return false
    end

    function operations:Cash()
        local cash = attribute(ctx.Player, "Cash")
        if cash ~= nil then return finite(cash) and cash or nil end
        local leaderstats = namedChild(ctx.Player, "leaderstats")
        for _, name in ipairs({ "Cash", "Money", "Peso" }) do
            local value = directValue(leaderstats, name)
            if value ~= nil then return finite(value) and value or nil end
        end
        return nil
    end

    function operations:Holdings(itemName)
        if type(itemName) ~= "string" or itemName:match("^%s*$") then return nil end
        local found
        for _, containerName in ipairs({ "Inventory", "Ingredients", "IngredientInventory" }) do
            local container = namedChild(ctx.Player, containerName)
            local amount = directValue(container, itemName)
            if amount == nil then
                local item = namedChild(container, itemName)
                if item then
                    for _, key in ipairs({ "Quantity", "Amount", "Count" }) do
                        amount = directValue(item, key)
                        if amount ~= nil then break end
                    end
                end
            end
            if amount ~= nil then
                if not finite(amount) or (found ~= nil and found ~= amount) then return nil end
                found = amount
            end
        end
        return found
    end

    function operations:SetSetting(key, value)
        if settings[key] == nil or type(value) ~= type(settings[key]) then return false end
        if type(value) == "number" then
            if not finite(value) then return false end
            if key == "trashPerTrip" and (value < 1 or value > 50 or value % 1 ~= 0) then return false end
            if key == "webhookInterval" and value < 15 then return false end
        elseif type(value) == "string" then
            if #value > (key == "webhookUrl" and 2048 or 500) then return false end
            if key == "menuKey" and not value:match("^%w+$") then return false end
        end
        settings[key] = value
        return true
    end

    function operations:IsSelected(group, key)
        local row = indexed[group] and indexed[group][key]
        return row ~= nil and not row.ambiguous and selection[group][key] == row.fingerprint
            and selectionInstances[group][key] == row.instance
    end

    function operations:SetSelection(group, key, enabled)
        if not selection[group] then return false end
        if enabled == false then selection[group][key] = nil; selectionInstances[group][key] = nil; return true end
        local row = indexed[group][key]
        if enabled ~= true or not row or row.ambiguous then return false end
        selection[group][key] = row.fingerprint
        selectionInstances[group][key] = row.instance
        return true
    end

    local function targetOf(prompt)
        local original = property(prompt, "Parent")
        if isA(original, "Attachment") then original = property(original, "Parent") end
        local cursor = original
        for _ = 1, 5 do
            if not cursor or cursor == selectedPlot or cursor == ctx.Workspace then break end
            if isA(cursor, "Model") then return cursor end
            cursor = property(cursor, "Parent")
        end
        return original ~= selectedPlot and original or nil
    end

    local function ownership(prompt, target)
        local explicit = false
        for _, source in ipairs({ prompt, target }) do
            for _, name in ipairs({ "OwnerUserId", "PlayerUserId" }) do
                local value = directValue(source, name)
                if value ~= nil then
                    if tostring(value) ~= tostring(property(ctx.Player, "UserId")) then return false end
                    explicit = true
                end
            end
            for _, name in ipairs({ "PlotName", "RestaurantName" }) do
                local value = directValue(source, name)
                if value ~= nil and (not selectedPlot or tostring(value) ~= property(selectedPlot, "Name")) then return false end
            end
        end
        if explicit or below(prompt, selectedPlot) then return true end
        if type(ctx.scope) == "function" then
            local ok, result = pcall(ctx.scope, prompt)
            return ok and result == true
        end
        return false
    end

    local function classify(action, text, role, applicant)
        if word(action, "sell") or word(action, "delete") or word(action, "donate") or word(action, "buy all") then return nil end
        local function exact(...)
            for _, candidate in ipairs({ ... }) do if action == candidate then return true end end
            return false
        end
        if exact("roll candidates", "reroll candidates", "roll applicants", "reroll applicants", "refresh applicants") then return "rollCandidates" end
        if applicant and role ~= "" then
            if exact("hire", "hire applicant", "hire worker", "hire employee") then return "hire" end
            if exact("accept", "accept applicant", "accept candidate") then return "acceptSelected" end
            if exact("reject", "reject applicant", "reject candidate", "decline applicant") then return "rejectSelected" end
        end
        if role ~= "" then
            if exact("fire", "fire worker", "fire employee", "dismiss", "dismiss worker") then return "fireSelected" end
            if exact("wake", "wake up", "wake worker", "wake staff", "wake employee") then return "wake" end
        end
        if (word(text, "drink") or word(text, "drinks") or word(text, "beverage"))
            and (exact("make", "prepare", "serve", "pour", "refill", "make drink", "prepare drink", "serve drink", "pour drink", "refill drinks")) then return "drinks" end
        if (word(text, "ihaw") or word(text, "barbecue") or word(text, "bbq"))
            and exact("cook", "grill", "start grilling", "cook ihaw", "grill ihaw", "serve ihaw", "cook barbecue", "serve barbecue") then return "ihaw" end
        if word(text, "menu") or word(text, "menus") then
            if exact("unlock", "unlock menu", "unlock recipe") then return "unlockMenus" end
            if exact("enable", "enable menu", "enable dish") then return "enableMenus" end
        end
        if word(text, "counter") and exact("upgrade", "upgrade counter") then return "upgradeCounter" end
        if (word(text, "table") or word(text, "tables")) and exact("buy", "purchase", "buy table", "buy tables", "purchase table") then return "buyTables" end
        local furniture = word(text, "furniture") or word(text, "table") or word(text, "chair") or word(text, "stove") or word(text, "counter")
        if furniture and exact("place", "place furniture", "place table", "place chair", "place stove", "place counter") then return "placeBest" end
        if furniture and exact("upgrade", "upgrade furniture", "upgrade table", "upgrade chair", "upgrade stove") then return "upgradeFurniture" end
        return nil
    end

    local function entryFor(prompt)
        if not isA(prompt, "ProximityPrompt") or not below(prompt, ctx.Workspace) then return nil end
        local target = targetOf(prompt)
        if not target then return nil end
        local actionText, objectText = property(prompt, "ActionText"), property(prompt, "ObjectText")
        local action = normalize(actionText)
        local name = property(target, "Name")
        if type(name) ~= "string" or name:match("^%s*$") then return nil end
        local role = normalize(metadata(prompt, target, { "Role", "JobRole", "WorkerRole", "Job" }))
        local applicantFlag = metadata(prompt, target, { "IsApplicant", "Applicant" })
        local text = tostring(objectText or "") .. " " .. name .. " " .. tostring(metadata(prompt, target, { "FurnitureType", "ItemType" }) or "")
        local applicant = applicantFlag == true or word(text, "applicant") or word(text, "candidate")
            or action == "hire" or action == "hire worker" or action == "hire employee" or action == "hire applicant"
        local category = classify(action, text, role, applicant)
        local missing = metadata(prompt, target, { "MissingIngredients" }) == true
            or metadata(prompt, target, { "IngredientsMissing" }) == true
            or metadata(prompt, target, { "HasIngredients" }) == false
        local parent = property(target, "Parent")
        if not category and property(parent, "Name") == "ClientNPCs"
            and (action == "reject" or action == "reject customer" or action == "decline customer") then category = "rejectCustomer" end
        if not category then return nil end
        local key, targetKey = fullName(prompt), fullName(target)
        if not key or not targetKey then return nil end
        local rarity = ctx.Features.rarity(target)
        local wage = metadata(prompt, target, { "Wage", "Salary", "DailyWage" })
        local priceKeys = category == "rollCandidates" and { "RollCost", "Price", "Cost" }
            or (category == "hire" or category == "acceptSelected") and { "HireCost", "Price", "Cost" }
            or (category == "upgradeFurniture" or category == "upgradeCounter") and { "UpgradeCost", "Price", "Cost" }
            or category == "unlockMenus" and { "UnlockCost", "MenuCost", "Price", "Cost" }
            or category == "buyTables" and { "PurchasePrice", "Price", "Cost" }
            or { "Price", "Cost" }
        local price = metadata(prompt, target, priceKeys)
        local quality = metadata(prompt, target, { "Quality", "Rating", "FurnitureRating" })
        local owned = metadata(prompt, target, { "Owned", "IsOwned" }) == true
        local currency = normalize(metadata(prompt, target, { "Currency" }))
        local combinedText = tostring(actionText) .. " " .. text
        local premium = metadata(prompt, target, { "RequiresRobux", "IsGamePass" }) == true
            or currency == "robux" or currency == "premium"
            or word(combinedText, "robux") or combinedText:find("R$", 1, true) ~= nil
            or combinedText:find(utf8.char(0xE002), 1, true) ~= nil
        for _, field in ipairs({ "GamePassId", "DeveloperProductId", "RobuxPrice" }) do
            local value = metadata(prompt, target, { field })
            if value ~= nil and value ~= false and value ~= 0 and value ~= "0" then premium = true end
        end
        local signature = table.concat({ key, tostring(actionText), tostring(objectText), name, role,
            tostring(rarity), tostring(wage), tostring(price), tostring(quality), tostring(owned), tostring(premium), tostring(missing), tostring(property(prompt, "Enabled")) }, "\0")
        return { prompt = prompt, target = target, action = category, key = key, targetKey = targetKey,
            name = name, role = role, wage = wage, rarity = rarity, price = price, quality = quality,
            owned = owned, premium = premium, missing = missing, signature = signature,
            personFingerprint = targetKey .. "\0" .. name .. "\0" .. role .. "\0" .. tostring(wage) .. "\0" .. tostring(rarity),
            group = applicant and "applicants" or (role ~= "" and "staff" or nil) }
    end

    local function roleFilled(role)
        for _, entry in ipairs(observed) do
            if entry.group == "staff" and below(entry.prompt, ctx.Workspace) and ownership(entry.prompt, entry.target) then
                local liveRole = normalize(metadata(entry.prompt, entry.target, { "Role", "JobRole", "WorkerRole", "Job" }))
                local employed = metadata(entry.prompt, entry.target, { "Employed", "IsEmployed" })
                local state = normalize(metadata(entry.prompt, entry.target, { "EmploymentStatus" }))
                if liveRole == role and employed ~= false and state ~= "fired" and state ~= "unemployed" then return true end
            end
        end
        -- Some employed staff have no interactive prompt. Only explicit staff markers
        -- within the selected plot can establish an already-filled role.
        local ok, descendants = pcall(function() return selectedPlot:GetDescendants() end)
        for _, staff in ipairs(ok and descendants or {}) do
            if isA(staff, "Model") and (attribute(staff, "IsStaff") == true or attribute(staff, "IsEmployee") == true)
                and ownership(staff, staff) and attribute(staff, "IsApplicant") ~= true then
                local liveRole = normalize(metadata(staff, staff, { "Role", "JobRole", "WorkerRole", "Job" }))
                if liveRole == role and attribute(staff, "IsEmployed") ~= false and attribute(staff, "Employed") ~= false then return true end
            end
        end
        return false
    end

    local function eligibility(entry, manual)
        if entry.ambiguous then return false, "Duplicate control path" end
        if not property(entry.prompt, "Enabled") then return false, "Prompt unavailable" end
        if not ownership(entry.prompt, entry.target) then return false, "Outside selected restaurant or owner mismatch" end
        if entry.premium then return false, "Premium control excluded" end
        if entry.action == "rejectCustomer" and not entry.missing then return false, "Missing ingredients not confirmed" end
        if entry.action == "placeBest" then
            if not entry.owned then return false, "Owned furniture metadata required" end
            if not finite(entry.quality) then return false, "Furniture quality or rating required" end
        end
        if entry.action == "hire" or (entry.action == "acceptSelected" and settings.autoApplicants) then
            if not csvContains(settings.rolesToFill, entry.role) then return false, "Choose matching roles to fill" end
            if not finite(entry.wage) then return false, "Applicant wage unknown" end
            if entry.wage > settings.maxWage then return false, "Applicant exceeds maximum wage" end
            if not csvContains(settings.hireRarities, entry.rarity) then return false, "Choose matching applicant rarities" end
            if not manual and roleFilled(entry.role) then return false, "Selected role already has owned staff" end
        end
        if spending[entry.action] then
            if not finite(entry.price) then return false, "Explicit price required" end
            local cash = operations:Cash()
            if not finite(cash) then return false, "Current cash unknown" end
            if cash - entry.price < settings.keepCash then return false, "Cash reserve would be exceeded" end
            if entry.action == "rollCandidates" and entry.price > settings.maxRollCost then return false, "Roll exceeds maximum cost" end
        end
        return true, "Ready"
    end

    local function addRow(group, row)
        local existing = indexed[group][row.key]
        if existing then
            if existing.instance ~= row.instance or existing.fingerprint ~= row.fingerprint then
                existing.ambiguous, existing.status = true, "Ambiguous target metadata"
            end
            return
        end
        indexed[group][row.key] = row
        table.insert(lists[group], row)
    end

    function operations:Observe(prompts, plot, catalogRows)
        selectedPlot, observed, statuses, entryIndex = plot, {}, {}, {}
        lists = { ingredients = {}, shopItems = {}, applicants = {}, staff = {} }
        indexed = { ingredients = {}, shopItems = {}, applicants = {}, staff = {} }
        for action in pairs(automatic) do statuses[action] = "No supported loaded prompt" end
        for action in pairs(manualActions) do statuses[action] = "No supported loaded prompt" end
        local seen = {}
        for prompt in pairs(prompts or {}) do
            local entry = entryFor(prompt)
            if entry then
                if seen[entry.key] then entry.ambiguous, seen[entry.key].ambiguous = true, true end
                seen[entry.key] = entry
                entryIndex[entry.key] = entry
                table.insert(observed, entry)
                local ready, reason = eligibility(entry)
                if statuses[entry.action] ~= "Ready" then statuses[entry.action] = ready and "Ready" or reason end
                if entry.group then
                    addRow(entry.group, { key = entry.targetKey, name = entry.name, role = entry.role,
                        wage = entry.wage, rarity = entry.rarity, status = reason, fingerprint = entry.personFingerprint, instance = entry.target })
                end
            end
        end
        for _, row in ipairs(catalogRows or {}) do
            if type(row.key) == "string" and type(row.fingerprint) == "string" and type(row.name) == "string" and normalize(row.name) ~= "" then
                local group = row.root and property(row.root, "Name") == "Grocery" and "ingredients" or "shopItems"
                addRow(group, { key = row.key, name = row.name, fingerprint = row.fingerprint,
                    status = row.status or "Observed", stock = row.stock, supported = row.supported, instance = row.prompt })
            end
        end
        for group, rows in pairs(lists) do
            for _, row in ipairs(rows) do
                -- An instance replacement never inherits an old person selection.
                if row.ambiguous then selection[group][row.key] = nil end
                row.selected = self:IsSelected(group, row.key)
            end
            table.sort(rows, function(a, b) if a.name == b.name then return a.key < b.key end return a.name < b.name end)
        end
        for prompt in pairs(completed) do if not below(prompt, ctx.Workspace) then completed[prompt] = nil end end
    end

    function operations:Lists()
        local result = {}
        for group, rows in pairs(lists) do
            result[group] = {}
            for _, row in ipairs(rows) do
                table.insert(result[group], { key = row.key, name = row.name, selected = self:IsSelected(group, row.key),
                    status = row.status, fingerprint = row.fingerprint, stock = row.stock, supported = row.supported,
                    role = row.role, wage = row.wage, rarity = row.rarity })
            end
        end
        return result
    end

    function operations:Status()
        local result = table.clone(statuses)
        for action, setting in pairs(automatic) do result[setting] = result[action] end
        return result
    end

    function operations:Request(action)
        if not manualActions[action] then return false end
        requests[action] = nil
        local capture, count = {}, 0
        local group = manualGroups[action]
        local unavailable
        for _, entry in ipairs(observed) do
            if entry.action == action and (not group or self:IsSelected(group, entry.targetKey)) then
                local live = entryFor(entry.prompt)
                local ready, reason = false, "Target changed; refresh discovery"
                if live and live.signature == entry.signature and not entry.ambiguous then ready, reason = eligibility(live, true) end
                if ready then
                    capture[entry.key] = { prompt = entry.prompt, signature = entry.signature }
                    count += 1
                else unavailable = reason end
            end
        end
        if count == 0 then
            statuses[action] = unavailable or (group and "Select matching loaded targets first" or "No supported loaded prompt")
            return false
        end
        requests[action] = capture
        return true
    end

    function operations:CancelRequests()
        table.clear(requests)
    end

    local function intent(entry)
        local pending = requests[entry.action] and requests[entry.action][entry.key]
        if pending and pending.prompt == entry.prompt and pending.signature == entry.signature then
            local group = manualGroups[entry.action]
            if not group or operations:IsSelected(group, entry.targetKey) then return true, true end
        end
        local setting = automatic[entry.action]
        if setting and settings[setting] then return true, false end
        return false, false
    end

    function operations:Candidates()
        local candidates, best = {}, nil
        for _, entry in ipairs(observed) do
            local wanted, manual = intent(entry)
            if wanted and entry.action == "placeBest" and eligibility(entry, manual)
                and (not best or entry.quality > best.quality or (entry.quality == best.quality and entry.key < best.key)) then best = entry end
        end
        for _, entry in ipairs(observed) do
            local wanted, manual = intent(entry)
            local ready, reason = eligibility(entry, manual)
            if wanted and not ready then statuses[entry.action] = reason end
            local last = completed[entry.prompt]
            local same = last and last.signature == entry.signature
            local cooled = manual or not same or (last.count < 3 and now() - last.at >= 10)
            if wanted and not cooled and same and last.count >= 3 then statuses[entry.action] = "Paused after three unchanged attempts" end
            if wanted and ready and cooled and (entry.action ~= "placeBest" or entry == best) then
                local candidate = { prompt = entry.prompt, action = entry.action, key = entry.key, manual = manual }
                candidate.guard = function()
                    local current = entryIndex[entry.key]
                    if not current or current.ambiguous or current.prompt ~= entry.prompt then return false end
                    local live = entryFor(entry.prompt)
                    if not live or live.target ~= entry.target or live.signature ~= entry.signature then return false end
                    local stillWanted, liveManual = intent(live)
                    if not stillWanted or not eligibility(live, liveManual) then return false end
                    if entry.action == "placeBest" then
                        for _, other in ipairs(observed) do
                            local otherLive = entryFor(other.prompt)
                            if otherLive and otherLive.action == "placeBest" and intent(otherLive) and eligibility(otherLive)
                                and otherLive.quality > live.quality then return false end
                        end
                    end
                    return true
                end
                candidate._entry = entry
                table.insert(candidates, candidate)
            end
        end
        table.sort(candidates, function(a, b)
            if a.manual ~= b.manual then return a.manual end
            if a.action == b.action then return a.key < b.key end
            return a.action < b.action
        end)
        return candidates
    end

    function operations:Complete(candidate)
        local entry = type(candidate) == "table" and candidate._entry
        if not entry then return false end
        local previous = completed[entry.prompt]
        local count = previous and previous.signature == entry.signature and previous.count + 1 or 1
        completed[entry.prompt] = { signature = entry.signature, at = now(), count = count }
        local pending = requests[entry.action]
        if pending then
            if entry.action == "placeBest" then requests[entry.action] = nil
            else pending[entry.key] = nil; if next(pending) == nil then requests[entry.action] = nil end end
        end
        statuses[entry.action] = "Input attempted; waiting for game state"
        return true
    end

    return operations
end

return createOperations

end)()

local createUtilities = (function()
-- Optional local utilities. Webhooks send only after a URL and toggle are supplied.
local function createUtilities(ctx)
    local util = {}
    local alive, posting, holding = true, false, false
    local heldCameraFrame
    local nextWebhook = 0
    local originalRanges = setmetatable({}, { __mode = "k" })
    local serviceAvailable, virtualUser = pcall(function() return game:GetService("VirtualUser") end)
    local function releaseInput()
        if holding then
            holding = false
            local frame = heldCameraFrame
            heldCameraFrame = nil
            pcall(function() virtualUser:Button2Up(Vector2.zero, frame) end)
        end
    end
    local idleConnection = ctx.Player.Idled:Connect(function()
        if not alive or not ctx.Settings.antiAFK or holding then return end
        if not serviceAvailable or not virtualUser then
            ctx.Log("Anti-AFK input is unavailable in this executor.")
            return
        end
        local camera = ctx.Workspace.CurrentCamera
        if not camera then return end
        local ok = pcall(function()
            virtualUser:CaptureController()
            heldCameraFrame = camera.CFrame
            holding = true
            virtualUser:Button2Down(Vector2.zero, heldCameraFrame)
        end)
        if ok then
            task.delay(0.15, releaseInput)
        else
            releaseInput()
            ctx.Log("Anti-AFK input is unavailable in this executor.")
        end
    end)
    function util:ActivationDistance(prompt)
        if originalRanges[prompt] ~= nil then return originalRanges[prompt] end
        local ok, distance = pcall(function() return prompt.MaxActivationDistance end)
        return ok and distance or 0
    end
    function util:UpdatePrompts(prompts)
        if not alive then return end
        -- Restore tracked objects even when streaming removed them from the registry.
        for prompt, distance in pairs(originalRanges) do
            local ok, attached = pcall(function() return prompt.Parent ~= nil end)
            if not ctx.Settings.longRange or not prompts[prompt] or not ok or not attached then
                pcall(function() prompt.MaxActivationDistance = distance end)
                originalRanges[prompt] = nil
            end
        end
        for prompt in pairs(prompts) do
            if ctx.Settings.longRange then
                pcall(function()
                    if not prompt.Parent then return end
                    if originalRanges[prompt] == nil then originalRanges[prompt] = prompt.MaxActivationDistance end
                    prompt.MaxActivationDistance = math.max(originalRanges[prompt], 80)
                end)
            end
        end
        if not ctx.Settings.antiAFK then releaseInput() end
    end
    function util:MenuKey()
        local ok, key = pcall(function() return Enum.KeyCode[ctx.Settings.menuKey] end)
        return ok and key or Enum.KeyCode.RightShift
    end
    local function requestCapability()
        local executor = ctx.Env or {}
        local candidates = table.pack(executor.request, executor.http_request,
            type(executor.syn) == "table" and executor.syn.request or nil,
            request, http_request, type(syn) == "table" and syn.request or nil,
            type(http) == "table" and http.request or nil)
        for index = 1, candidates.n do
            if type(candidates[index]) == "function" then return candidates[index] end
        end
        return nil
    end
    local function publicText(value, limit)
        if type(value) ~= "string" and type(value) ~= "number" then return "Unknown" end
        local text = tostring(value):gsub("[Hh][Tt][Tt][Pp][Ss]?://%S+", "[URL removed]")
        return text:sub(1, limit)
    end
    local function count(value)
        if type(value) ~= "number" or value ~= value or value < 0 or value == math.huge then return "0" end
        return tostring(math.floor(value))
    end
    function util:Tick()
        if not alive or not ctx.Settings.webhookEnabled or not ctx.IsRunning() or posting or os.clock() < nextWebhook then return end
        local url = ctx.Settings.webhookUrl
        if type(url) ~= "string" or not url:match("^https://[^/%s]+/%S+$") then return end
        local sender = requestCapability()
        if not sender then
            nextWebhook = os.clock() + 60
            ctx.Log("Webhook needs the executor's HTTP request capability.")
            return
        end
        posting = true
        nextWebhook = os.clock() + math.clamp(tonumber(ctx.Settings.webhookInterval) or 60, 30, 3600)
        local encoded, body = pcall(function()
            local snapshot = ctx.GetState()
            return ctx.HttpService:JSONEncode({ username = "Karinderya Operations", embeds = { {
                title = "Restaurant session", color = 3662001,
                description = publicText(snapshot.status, 1500),
                fields = {
                    { name = "Restaurant", value = publicText(snapshot.plotName, 150), inline = true },
                    { name = "Interactions", value = count(snapshot.attempts), inline = true },
                    { name = "Swing attempts", value = count(snapshot.swings), inline = true },
                    { name = "Buy attempts", value = count(snapshot.purchases), inline = true },
                },
            } } })
        end)
        if not encoded then
            posting = false
            if alive then ctx.Log("Webhook snapshot could not be prepared.") end
            return
        end
        task.spawn(function()
            -- Queued work may outlive its toggle, URL, active session, or controller.
            if not alive or not ctx.Settings.webhookEnabled or not ctx.IsRunning() or ctx.Settings.webhookUrl ~= url then
                posting = false
                return
            end
            -- Executor request APIs have no portable cancellation for an in-flight POST.
            local ok, response = pcall(sender, { Url = url, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body })
            posting = false
            if not alive then return end
            local code = ok and type(response) == "table" and tonumber(response.StatusCode or response.Status)
            if not code or code < 200 or code >= 300 then
                -- Never log the endpoint, token, request body, or raw exception.
                ctx.Log("Webhook delivery failed" .. (code and " (HTTP " .. code .. ")" or "") .. ".")
            end
        end)
    end
    function util:Destroy()
        if not alive then return end
        alive = false
        idleConnection:Disconnect()
        releaseInput()
        for prompt, distance in pairs(originalRanges) do pcall(function() prompt.MaxActivationDistance = distance end) end
        table.clear(originalRanges)
    end
    return util
end

return createUtilities

end)()

