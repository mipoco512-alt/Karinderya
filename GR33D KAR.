if type(env.UniversalRobloxInspector) == "table" and type(env.UniversalRobloxInspector.Destroy) == "function" then
    pcall(function() env.UniversalRobloxInspector:Destroy() end)
end
local api = {}
env.UniversalRobloxInspector = api
local alive, running, filter, selected, status = true, false, "", nil, "Ready. Start a baseline, then mark and perform the action to inspect."
local options = { outgoing = false, incoming = false, ui = true, replicated = true, scripts = true, errors = true,
    movement = true, interactions = true }
local session = HttpService:GenerateGUID(false):gsub("[^%w%-_]", "")
local journal = createInspectorJournal({ Env = env, HttpService = HttpService, sessionId = session,
    placeId = game.PlaceId, version = "1.0", writefile = env.writefile or writefile, appendfile = env.appendfile or appendfile })
local connections, dashboard, objectObserver, capture, motion = {}, nil, nil, nil, nil
local sourceExports, sourceSequence = {}, 0
local function record(level, action, message, details)
    if not alive then return end
    local entry = journal:Record(level, action, message, details)
    if entry then status = entry.message end
    return entry
end
local function remoteRecord(entry)
    local path = type(entry.remote) == "table" and entry.remote.path or "[unknown remote]"
    if type(path) ~= "string" then path = "[bounded remote identity; see log]" end
    record("info", "remote." .. tostring(entry.direction or "local"),
        tostring(entry.method or entry.kind) .. " / " .. path, entry)
