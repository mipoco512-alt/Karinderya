-- AUTO HIT RUNAWAY
--==========================================================================
local RUNW = { gone = {}, seat = {}, scanAt = -math.huge, flagAt = -math.huge, model = nil }
local function npcIdFrom(...)
    for i = 1, select("#", ...) do
        local v = select(i, ...)
        if type(v) == "string" and v:sub(1, 4) == "NPC_" then return v end
        if type(v) == "table" and type(v.NpcId) == "string" then return v.NpcId end
    end
    return nil
end
local function posFrom(...)
    local args = table.pack(...)
    for i = 1, args.n do
        local v = args[i]
        if typeof(v) == "Vector3" then return v end
        if typeof(v) == "CFrame" then return v.Position end
    end
    for i = 1, args.n - 2 do
        local a, b, c = args[i], args[i + 1], args[i + 2]
        if type(a) == "number" and type(b) == "number" and type(c) == "number" then return Vector3.new(a, b, c) end
    end
    return nil
end
local function recordNpcPos(...)
    local id = npcIdFrom(...)
    local p = id and posFrom(...)
    if id and p and finite(p) then NPCPOS[id] = { pos = p, t = os.clock() } end
end
local function queueRunaway(allowFallback, ...)
    local id = npcIdFrom(...)
    if not id and allowFallback then
        for i = 1, select("#", ...) do local v = select(i, ...) if type(v) == "string" then id = v end end
    end
    if id and not RUN.caught[id] then RUN.queue[id] = os.clock() end
end
local function nameMatches(obj, id)
    if obj.Name == id then return true end
    if obj:GetAttribute("NpcId") == id then return true end
    local v = obj:FindFirstChild("NpcId")
    return v ~= nil and v:IsA("StringValue") and v.Value == id
end
local function modelFor(id)
    local held = RUNW.model
    if held and held.Parent and nameMatches(held, id) then return held end
    local cn = Workspace:FindFirstChild("ClientNPCs")
    local m = cn and cn:FindFirstChild(id)
    if m and m:IsA("Model") then RUNW.model = m return m end
    if os.clock() - RUNW.scanAt < 1 then return nil end
    RUNW.scanAt = os.clock()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") and nameMatches(obj, id) then RUNW.model = obj return obj end
    end
    return nil
end
local function scanRunawayFlags()
    if os.clock() - RUNW.flagAt < 1.5 then return end
    RUNW.flagAt = os.clock()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") then
            local flagged = obj:GetAttribute("IsRunaway") == true or obj:GetAttribute("Runaway") == true
            if not flagged then
                local bv = obj:FindFirstChild("IsRunaway") or obj:FindFirstChild("Runaway")
                flagged = bv ~= nil and bv:IsA("BoolValue") and bv.Value == true
            end
            if flagged then
                local id = obj:GetAttribute("NpcId")
                if type(id) ~= "string" and obj.Name:sub(1, 4) == "NPC_" then id = obj.Name end
                if type(id) == "string" and not RUN.caught[id] and not RUN.queue[id] then RUN.queue[id] = os.clock() end
            end
        end
    end
end
local function destinationOf(id)
    local p = NPCPOS[id]
    if p and os.clock() - p.t < 30 then return p.pos end
    local tbl = RUNW.seat[id]
    if tbl and tbl.Parent then return anchorOf(tbl) end
    return nil
end
local function behindCF(root, hrp, hum)
    local look = root.CFrame.LookVector
    local flat = Vector3.new(look.X, 0, look.Z)
    if flat.Magnitude < 0.1 then flat = Vector3.new(0, 0, 1) end
    flat = flat.Unit
    local bx, bz = root.Position.X - flat.X, root.Position.Z - flat.Z
    local rootH = math.max(3, ((hum and hum.HipHeight) or 2) + hrp.Size.Y / 2)
    local fy = floorUnder(bx, bz, root.Position.Y + 3)
    local y = root.Position.Y
    if fy and math.abs(fy + rootH - root.Position.Y) <= 6 then y = fy + rootH end
    return CFrame.lookAt(Vector3.new(bx, y, bz), Vector3.new(root.Position.X, y, root.Position.Z))
end
local function panTool()
    for _, c in ipairs(containers()) do
        for _, t in ipairs(c:GetChildren()) do
            if t:IsA("Tool") and t.Name:lower() == "pan" then return t end
        end
    end
    return nil
end
local function swingPan(m, id, hum, pan)
    local char = Me.Character
    if pan.Parent ~= char then
        pcall(function() hum:EquipTool(pan) end)
        waitFor(function() return pan.Parent == char end, 0.6)
    end
    if pan.Parent ~= char then return false, "pan would not equip" end
    local r = remote("HitRunawayEvent")
    if r and r:IsA("RemoteEvent") then pcall(function() r:FireServer(id, "melee", "Pan") end) end
    pcall(function() pan:Activate() end)
    task.wait(0.05)
    pcall(function() pan:Activate() end)
    if fireclickdetector then
        for _, cd in ipairs(m:GetDescendants()) do
            if cd:IsA("ClickDetector") then pcall(fireclickdetector, cd) end
        end
    end
    return true
end
local function chaseRunaway(id)
    local t0, swings, lastWalk = os.clock(), 0, -math.huge
    while running and M.runaway.enabled and os.clock() - t0 < CFG.RUN_MAX do
        if RUN.caught[id] then return "caught (" .. swings .. " swings)" end
        local _, hrp, hum = charParts()
        if not hrp or not hum then return "no character" end
        local pan = panTool()
        if not pan then return "no Pan tool in backpack" end
        local m = modelFor(id)
        local root = m and (m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart or m:FindFirstChildWhichIsA("BasePart", true))
        if root then
            local want = behindCF(root, hrp, hum)
            if (hrp.Position - want.Position).Magnitude > 2.5 then
                safeTeleportCF(want)
            end
            local ok, why = swingPan(m, id, hum, pan)
            if ok then swings += 1 end
            M.runaway.status = string.format("hitting runaway (%d)%s", swings, ok and "" or (" - " .. tostring(why)))
            task.wait(CFG.RUN_HIT)
        else
            if RUNW.gone[id] and os.clock() - t0 > 2 then return "left after " .. swings .. " swings" end
            local dest = destinationOf(id)
            if dest and os.clock() - lastWalk > 1.5 then
                lastWalk = os.clock()
                M.runaway.status = string.format("going to runaway (%.0f studs)", (hrp.Position - dest).Magnitude)
                safeTeleport(dest, 20)
            end
            if not dest and os.clock() - t0 > 20 then return "runaway not found" end
            task.wait(0.3)
        end
    end
    return "stopped (" .. swings .. " swings)"
end
local function runawayTick()
    if not M.runaway.enabled then PRIO.runaway = false return 0.5 end
    scanRunawayFlags()
    local now, pick = os.clock(), nil
    for id, t in pairs(RUN.queue) do
        if RUN.caught[id] or now - t > 40 then RUN.queue[id] = nil
        elseif not pick then pick = id end
    end
    if not pick then PRIO.runaway = false M.runaway.status = "watching the whole map" return 0.4 end
    PRIO.runaway = true
    local okc, ok, res = pcall(withMove, "runaway", function() return chaseRunaway(pick) end)
    if not okc then
        PRIO.runaway = false
        M.runaway.status = "error: " .. tostring(ok)
        return 0.5
    end
    if not ok then M.runaway.status = "waiting for the bot to be free" return 0.15 end
    PRIO.runaway = false
    RUN.queue[pick] = nil
    if RUN.caught[pick] then RUN.done += 1 end
    M.runaway.status = tostring(res)
    log("runaway", tostring(res), THEME.gold)
    return 0.2
end

