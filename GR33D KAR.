capture = createInspectorCapture({ env = env, game = game, clock = os.clock, onRecord = remoteRecord })
local extraRoots = {}
local hiddenUI = env.gethui or gethui
if type(hiddenUI) == "function" then
    local ok, value = pcall(hiddenUI)
    if ok and typeof(value) == "Instance" then table.insert(extraRoots, value) end
end
objectObserver = createInspectorObjects({ game = game, storage = storage, options = options, record = record,
    extraRoots = extraRoots, flush = function() journal:Flush(16) end })
motion = createInspectorMotion({ Player = player, Workspace = game:GetService("Workspace"),
    ProximityPromptService = game:GetService("ProximityPromptService"), options = options, now = os.clock, record = record })
local function disconnectErrors()
    for _, connection in ipairs(connections) do pcall(function() connection:Disconnect() end) end
    table.clear(connections)
end
local errorCapability = "Not checked"
local function connectErrors()
    disconnectErrors()
    if not running or not options.errors then return end
    local ok = pcall(function()
        local context = game:GetService("ScriptContext")
        table.insert(connections, context.Error:Connect(function(message, trace, scriptObject)
            if not running or not options.errors or not alive then return end
            local pathOK, path = pcall(function() return scriptObject:GetFullName() end)
            record("error", "script.error", type(message) == "string" and message or "Script error",
                { scriptPath = pathOK and path or "Unavailable", trace = type(trace) == "string" and trace:sub(1, 4096) or nil })
