local storageError, lastQueueDropped = nil, 0
local clipboard = env.setclipboard or setclipboard
local sessionId = HttpService:GenerateGUID(false)
local baseName = "karinderya-gameplay-" .. sessionId
local metadata = { format = "karinderya-gameplay-recording", version = 3, sessionId = sessionId,
    placeId = game.PlaceId, playerUserId = player.UserId, capturedAtUTC = os.date("!%Y-%m-%dT%H:%M:%SZ"),
    captureMode = "minimal-arguments-only", persistence = "immediate writes outside remote hook" }
local api = {}
env.KarinderyaGameplayRecorder = api
local function message(value)
    status = tostring(value)
    print("[Karinderya Recorder] " .. status)
end
local journal = createRecorderJournal({ writefile = env.writefile or writefile,
    appendfile = env.appendfile or appendfile, readfile = env.readfile or readfile,
    encode = function(value) return HttpService:JSONEncode(value) end,
    metadata = metadata, baseName = baseName, maxLineBytes = 24 * 1024 })
local prepared, preparationError = journal:Start()
if prepared then
    message("Log ready: " .. journal:Stats().baseFile .. ". Start recording when ready.")
else
    storageError = preparationError or "Could not create a log file."
    message("Recording paused: " .. storageError)
end
engine = createGameplayRecorder({ env = env, game = game, storage = Storage, clock = os.clock,
    onRecord = function(event)
        if storageError then return end
        local ok, reason = journal:Append(event)
        if not ok then storageError = reason or "The log could not be written." end
    end })
engine:SetIncludeIncoming(false)
engine:SetLabel(label)

local function active()
    return alive and engine:Stats().recording
end
local function checkStorage()
    if storageError then
        engine:Stop()
        message("Recording stopped: " .. storageError .. ". Existing saved log data is retained.")
        return false
    end
    return true
end
function api:Start()
    if not alive or not checkStorage() then return false end
    local stats = journal:Stats()
    if not stats.initialized or stats.failed then message("A working file writer is required before recording."); return false end
    local ok, reason = engine:Start()
    if not ok then message("Recording unavailable: " .. tostring(reason)); return false end
    engine:Note("session-state", { action = "start", mode = "minimal" })
    if not checkStorage() then return false end
    message("Recording. Calls are saved automatically; Save Log shows the file to send.")
    return true
end
function api:Stop()
    if not alive then return end
    engine:Stop() -- drains the remaining queue into the journal
    if checkStorage() then message("Paused. Log saved: " .. journal:Stats().baseFile) end
end
function api:SetLabel(value)
    label = tostring(value or ""):gsub("[%c]", " "):sub(1, 120)
    if label == "" then label = "Gameplay" end
    engine:SetLabel(label)
end
function api:Mark(value)
    if value and value ~= "" then self:SetLabel(value) end
    if not active() then message("Start recording before adding a marker."); return false end
    engine:Flush()
    engine:Mark(label)
    return checkStorage()
end
function api:Clear()
    self:Stop()
    engine:Clear()
    table.clear(preview)
    previewCursor = engine:Stats().lastSequence
    lastQueueDropped = 0
    message("Live window cleared. Saved log records are retained.")
end
function api:SetIncludeIncoming(value)
    engine:SetIncludeIncoming(value == true)
end
function api:SetAllReplicated(value)
    engine:SetAllReplicated(value == true)
end
function api:SetFilter(value)
    engine:SetFilter(tostring(value or ""):sub(1, 160))
end
function api:SetAutosave()
    message("Automatic saving stays on in this recovery build.")
    return true
end
function api:Inspect(sequence)
    for _, event in ipairs(engine:Entries()) do
        if event.sequence == sequence then return HttpService:JSONEncode(event) end
    end
    return "This event left the small live window. Its saved copy remains in the log."
end
function api:CopyEvent(sequence)
    local text = self:Inspect(sequence)
    if type(clipboard) == "function" then pcall(clipboard, text) end
    return text
end
function api:SaveLog()
    local stats = journal:Stats()
    if not stats.initialized then
        message("No local log was created. " .. tostring(stats.lastError or storageError or "File writer unavailable."))
        return nil
    end
    -- Display only: no queue drain, encoding, clipboard, or file access on click.
    self.LastExport = stats.baseFile
    message(stats.chunked and ("Send " .. stats.baseFile .. " and all matching -event*.log files.")
        or ((stats.failed and "Partial log: " or "Log is already saved: ") .. stats.baseFile .. ". Send that file here."))
    return stats.baseFile
end
function api:Export() return self:SaveLog() end
function api:GetState()
    local stats = engine:Stats()
    for _, event in ipairs(engine:Entries(previewCursor)) do
        local name = event.remote and event.remote.path
        table.insert(preview, { sequence = event.sequence, time = event.time or 0, kind = event.kind,
            direction = event.direction, name = type(name) == "string" and name or event.kind,
            label = event.label, summary = event.status or event.kind })
        if #preview > 10 then table.remove(preview, 1) end
        previewCursor = math.max(previewCursor, event.sequence)
    end
    local disk = journal:Stats()
    return { recording = stats.recording, label = label, status = status, count = stats.count,
        dropped = stats.dropped + (stats.queueDropped or 0), elapsed = stats.elapsed,
        outgoing = stats.outgoing, incoming = stats.incoming, interactions = stats.interactions, returns = 0,
        includeIncoming = stats.includeIncoming, allReplicated = stats.allReplicated, filter = stats.filter,
        autosave = disk.initialized and not disk.failed, lastExport = disk.initialized and disk.baseFile or "",
        saved = disk.saved, events = table.clone(preview) }
end
function api:Destroy()
    if not alive then return end
    engine:Stop()
    alive = false
    engine:Destroy()
    if self.inputConnection then self.inputConnection:Disconnect() end
    if dashboard then dashboard:Destroy() end
    if env.KarinderyaGameplayRecorder == self then env.KarinderyaGameplayRecorder = nil end
end
api.inputConnection = Input.InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.KeyCode == Enum.KeyCode.F7 then if active() then api:Stop() else api:Start() end end
    if input.KeyCode == Enum.KeyCode.F8 and dashboard then dashboard:Toggle() end
    if input.KeyCode == Enum.KeyCode.F9 then api:Mark() end
end)
dashboard = createRecorderDashboard(api)
task.spawn(function()
    while alive do
        if active() then
            local ok, reason = pcall(function()
                engine:Flush(4) -- small batches, at most 0.1 seconds between drains
                if not checkStorage() then return end
                local stats = engine:Stats()
                if (stats.queueDropped or 0) > lastQueueDropped then
                    lastQueueDropped = stats.queueDropped
                    engine:Stop()
                    message("Capture paused after a traffic burst. Narrow the remote filter; saved records remain in the log.")
                end
            end)
            if not ok then engine:Stop(); message("Recorder paused: " .. tostring(reason):sub(1, 160)) end
        end
        task.wait(0.1)
    end
end)
task.spawn(function()
    while alive do
        if dashboard then
            local ok, reason = pcall(function() dashboard:Refresh(api:GetState()) end)
            if not ok then message("Display paused: " .. tostring(reason):sub(1, 160)); break end
        end
        task.wait(1)
    end
end)
return api
