            H.targetRarity = r
            for opt, b in pairs(targetOpts) do b.BackgroundColor3 = (opt == r) and THEME.head1 or THEME.panel end
            targetDrop.Visible = false
            H.blocked = {} HIRE.fullFail = {}
            log("hire", "target rarity -> " .. r, THEME.gold)
        end)
    end
    for i, r in ipairs(RARITY_ORDER) do
        local btn = mk("TextButton", { Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = REJECT_LIST[r] and THEME.red or THEME.panel, BorderSizePixel = 0, Text = r, Font = Enum.Font.Gotham, TextSize = 10, TextColor3 = THEME.text, LayoutOrder = i, ZIndex = 11 }, rejectDrop)
        rounded(btn, 4)
        btn.MouseButton1Click:Connect(function() REJECT_LIST[r] = not REJECT_LIST[r] btn.BackgroundColor3 = REJECT_LIST[r] and THEME.red or THEME.panel end)
    end
    hireRarityBtn.MouseButton1Click:Connect(function() targetDrop.Visible = not targetDrop.Visible rejectDrop.Visible = false end)
    rejectRarityBtn.MouseButton1Click:Connect(function() rejectDrop.Visible = not rejectDrop.Visible targetDrop.Visible = false end)
    panicBtn.MouseButton1Click:Connect(function() for _, m in ipairs(ORDER) do m.enabled = false end log("panic", "all modules stopped", THEME.red) end)

    local ROWS = {}
    local function buildRow(m, idx)
        local row = mk("Frame", { Size = UDim2.new(1, -6, 0, 44), BackgroundColor3 = THEME.panel, BorderSizePixel = 0, LayoutOrder = idx + 20 }, pMods)
        rounded(row, 10)
        local dot = mk("Frame", { Position = UDim2.fromOffset(12, 17), Size = UDim2.fromOffset(9, 9), BackgroundColor3 = THEME.gray, BorderSizePixel = 0 }, row)
        rounded(dot, 5)
        mk("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(28, 5), Size = UDim2.new(1, -110, 0, 18), Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = THEME.text, TextXAlignment = Enum.TextXAlignment.Left, Text = m.label }, row)
        local st = mk("TextLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(28, 23), Size = UDim2.new(1, -110, 0, 16), Font = Enum.Font.Gotham, TextSize = 9, TextColor3 = THEME.sub, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = "idle" }, row)
        local track = mk("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -10, 0.5, 0), Size = UDim2.fromOffset(40, 20), BackgroundColor3 = THEME.gray, BorderSizePixel = 0 }, row)
        rounded(track, 10)
        local knob = mk("Frame", { Position = UDim2.fromOffset(2, 2), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, track)
        rounded(knob, 8)
        local hit = mk("TextButton", { Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "" }, track)
        ROWS[m.key] = { dot = dot, status = st, track = track, knob = knob }
        hit.MouseButton1Click:Connect(function() m.enabled = not m.enabled m.errors = 0 log(m.key, m.enabled and "started" or "stopped", m.enabled and THEME.green or THEME.orange) end)
    end
    for i, m in ipairs(ORDER) do buildRow(m, i) end

    local function paintRow(m)
        local r = ROWS[m.key] if not r then return end
        r.track.BackgroundColor3 = m.enabled and THEME.green or THEME.gray
        r.knob.Position = m.enabled and UDim2.fromOffset(22, 2) or UDim2.fromOffset(2, 2)
        local s = m.status or "" local col = THEME.gray
        if m.errors > 0 then col = THEME.red elseif m.enabled and (s:find("wait", 1, true) or s:find("busy", 1, true) or s:find("no ", 1, true)) then col = THEME.orange elseif m.enabled then col = THEME.green end
        r.dot.BackgroundColor3 = col r.status.Text = s
    end
    uiRefresh = function() for _, m in ipairs(ORDER) do paintRow(m) end end

    local pill = mk("TextButton", { Size = UDim2.fromOffset(160, 28), Position = win.Position, BackgroundColor3 = THEME.head1, BorderSizePixel = 0, Visible = false, Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = THEME.text, Text = "▲ KARINDERYA MASTER", Active = true }, gui)
    rounded(pill, 14)
    minBtn.MouseButton1Click:Connect(function() pill.Position = win.Position win.Visible = false pill.Visible = true end)
    pill.MouseButton1Click:Connect(function() win.Position = pill.Position pill.Visible = false win.Visible = true end)
    draggable(win, head) draggable(pill, pill)
    closeBtn.MouseButton1Click:Connect(function() running = false for _, m in ipairs(ORDER) do m.enabled = false end for _, c in ipairs(HOOKS) do pcall(function() c:Disconnect() end) end table.clear(HOOKS) gui:Destroy() end)

    task.spawn(function()
        while running do
            uiRefresh()
            hireRarityBtn.Text = "HIRE: " .. string.upper(H.targetRarity) .. " ▼"
            task.wait(0.5)
        end
    end)
end

buildUI()
for _, m in ipairs(ORDER) do startModule(m) end
log("boot", "Karinderya Master " .. VERSION .. " ready.", THEME.green)
