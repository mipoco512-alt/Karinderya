local DRINK_WORDS = { "kola", "loyal", "drink", "soda", "cola", "juice", "sprite" }
local function heldDrinkName()
    for _, c in ipairs(containers()) do
        for _, t in ipairs(c:GetChildren()) do
            if (t:IsA("Tool") or t:IsA("Accessory")) and not t:GetAttribute("IsFood")
                and not t:GetAttribute("OrderKey") and hasWord(normName(t.Name), DRINK_WORDS) then
                return t.Name
            end
        end
    end
    return nil
end
local function drinkOrderWaiting()
    local now = os.clock()
    for npc in pairs(S.pendingDrinks) do
        if (S.drinkCD[npc] or 0) <= now then return npc end
    end
    return nil
end
local function drinkStep()
    local now = os.clock()
    if (S.drinkFailAt or 0) > now then return nil end
    local hd = heldDrinkName()
    local order = drinkOrderWaiting()
    if not hd and not order then return nil end
    local drinkName = hd
    if not drinkName and order then
        local v = S.pendingDrinks[order]
        if type(v) == "string" then drinkName = v end
    end
