local Storage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local Input = game:GetService("UserInputService")
local PromptService = game:GetService("ProximityPromptService")
local player = assert(Players.LocalPlayer, "Run this recorder in the Roblox client.")
local env = type(getgenv) == "function" and getgenv() or _G
local previous = env.KarinderyaGameplayRecorder
if type(previous) == "table" and type(previous.Destroy) == "function" then pcall(function() previous:Destroy() end) end
local automation = env.KarinderyaAutomation
if type(automation) == "table" then
    if type(automation.Record) == "function" then pcall(function() automation:Record(false) end) end
    if type(automation.Stop) == "function" then pcall(function() automation:Stop() end) end
end

local alive, engine, dashboard = true, nil, nil
local connections, watched = {}, setmetatable({}, { __mode = "k" })
local status, label = "Ready. Enter an action label, then Start recording.", "Gameplay"
local cachedContext, pending, pendingDropped = {}, {}, 0
local preview, previewCursor = {}, 0
local lastFlush, flushing, fileInitialized = 0, false, false
local savedEvents, part = 0, 0
local lastQueueDropped = 0
local fileWrite = env.writefile or writefile
local fileAppend = env.appendfile or appendfile
local fileRead = env.readfile or readfile
local clipboard = env.setclipboard or setclipboard
local autosave = type(fileWrite) == "function"
local sessionId = HttpService:GenerateGUID(false)
local baseName = "karinderya-gameplay-" .. sessionId
local lastExport = ""
local api = {}
env.KarinderyaGameplayRecorder = api

local function connect(signal, callback, bucket)
    local connection = signal:Connect(callback)
    table.insert(bucket or connections, connection)
    return connection
end
local function message(text)
    status = tostring(text)
    print("[Karinderya Recorder] " .. status)
end
local function active()
    return alive and engine and engine:Stats().recording
end
local function simpleAttributes(instance)
    local attributes, count = {}, 0
    for key, value in pairs(instance:GetAttributes()) do
        if count >= 32 then break end
        local kind = typeof(value)
        if kind == "string" then attributes[key] = value:sub(1, 256)
        elseif kind == "boolean" or kind == "number" then attributes[key] = value
        else attributes[key] = tostring(value):sub(1, 128) end
        count += 1
    end
    return attributes
end
local function sampleContext()
    local context = {}
    local model = player.Character
    local root = model and model:FindFirstChild("HumanoidRootPart")
    if model then
        local tool = model:FindFirstChildOfClass("Tool")
        context.equippedTool = tool and tool.Name or nil
    end
    if root then
        context.position = { x = root.Position.X, y = root.Position.Y, z = root.Position.Z }
        context.cframe = { root.CFrame:GetComponents() }
        local folder = Workspace:FindFirstChild("ClientNPCs")
        local nearest, distance = nil, 24
        if folder then
            for i, npc in ipairs(folder:GetChildren()) do
                if i > 80 then break end
                local part = npc:FindFirstChild("HumanoidRootPart")
                if part then
                    local current = (part.Position - root.Position).Magnitude
                    if current < distance then nearest, distance = npc, current end
                end
            end
        end
        if nearest then context.nearbyCustomer = { path = nearest:GetFullName(), attributes = simpleAttributes(nearest) } end
    end
    local stats = player:FindFirstChild("leaderstats")
    local cash = player:GetAttribute("Cash")
    if cash == nil and stats then
        local value = stats:FindFirstChild("Cash") or stats:FindFirstChild("Money")
        if value and value:IsA("ValueBase") then cash = value.Value end
    end
    if type(cash) == "number" then context.cash = cash end
    cachedContext = context
    return context
end
local function metadata()
    return { format = "karinderya-gameplay-recording", version = 1, sessionId = sessionId, placeId = game.PlaceId,
        playerUserId = player.UserId, capturedAtUTC = os.date("!%Y-%m-%dT%H:%M:%SZ"),
        captureMode = "arguments-only", purpose = "manual gameplay observation; no remote replay" }
end

local function flush()
    if flushing or not autosave or #pending == 0 or type(fileWrite) ~= "function" then return end
    flushing = true
    local batch = pending
    pending = {}
    local ok, reason = pcall(function()
        if type(fileAppend) == "function" then
            local lines = {}
            if not fileInitialized then
                fileWrite(baseName .. ".log", HttpService:JSONEncode({ kind = "session", metadata = metadata() }) .. "\n")
                fileInitialized = true
            end
            for _, event in ipairs(batch) do table.insert(lines, HttpService:JSONEncode(event)) end
            fileAppend(baseName .. ".log", table.concat(lines, "\n") .. "\n")
            lastExport = baseName .. ".log"
        else
            part += 1
            local filename = baseName .. string.format("-part%04d.log", part)
            fileWrite(filename, HttpService:JSONEncode({ metadata = metadata(), events = batch }))
            lastExport = filename
        end
        savedEvents += #batch
    end)
    if not ok then
        -- Keep the unflushed data for a retry; cap the queue instead of growing forever.
        local restored = {}
        for _, event in ipairs(batch) do if #restored < 1000 then table.insert(restored, event) else pendingDropped += 1 end end
        for _, event in ipairs(pending) do if #restored < 1000 then table.insert(restored, event) else pendingDropped += 1 end end
        pending = restored
        autosave = false
        message("Autosave failed. Data remains in memory; use Export. " .. tostring(reason):sub(1, 120))
    end
    flushing = false
    lastFlush = os.clock()
end

engine = createGameplayRecorder({ env = env, game = game, storage = Storage, clock = os.clock,
    context = function() return cachedContext end,
    onRecord = function(event)
        if autosave then
            if #pending < 1000 then table.insert(pending, event) else pendingDropped += 1 end
        end
    end })
engine:SetIncludeIncoming(false)
engine:SetLabel(label)

function api:Start()
    if not alive then return false end
    local ok, reason = engine:Start()
    if ok then
        sampleContext()
        engine:Note("session-state", { action = "start", context = cachedContext })
        message("Recording outgoing arguments in compatibility mode. Play normally, then Save Log.")
    else message("Recording unavailable: " .. tostring(reason)) end
    return ok
end
function api:Stop()
    if not alive then return end
    engine:Stop()
    flush()
    message("Paused. Export the session when finished.")
end
function api:SetLabel(value)
    label = tostring(value or ""):gsub("[%c]", " "):sub(1, 120)
    if label == "" then label = "Gameplay" end
    engine:SetLabel(label)
    message("Current action: " .. label)
end
function api:Mark(value)
    if value and value ~= "" then self:SetLabel(value) end
    if not active() then message("Start recording before adding a marker."); return false end
    sampleContext()
    engine:Flush()
    engine:Mark(label)
    engine:Note("checkpoint", { context = cachedContext })
    message("Marked: " .. label .. ". Perform that action now.")
    return true
end
function api:Clear()
    if active() then self:Stop() end
    flush()
    engine:Clear()
    table.clear(preview)
    previewCursor = engine:Stats().lastSequence
    message("Cleared the live window. Existing autosave files are retained.")
end
function api:SetIncludeIncoming(value)
    engine:SetIncludeIncoming(value == true)
end
function api:SetAllReplicated(value)
    engine:SetAllReplicated(value == true)
    message(value and "Capturing matching remotes throughout ReplicatedStorage." or "Capturing matching remotes under ReplicatedStorage.Remotes.")
end
function api:SetFilter(value)
    engine:SetFilter(tostring(value or ""):sub(1, 160))
end
function api:SetAutosave(value)
    if value and type(fileWrite) ~= "function" then message("This executor does not provide writefile."); return false end
    autosave = value == true
    if autosave then
        if #pending == 0 and savedEvents == 0 then
            for _, event in ipairs(engine:Entries()) do table.insert(pending, event) end
        end
        flush()
    end
    return autosave
end
local function eventBySequence(sequence)
    for _, event in ipairs(engine:Entries()) do if event.sequence == sequence then return event end end
    return nil
end
function api:Inspect(sequence)
    local event = eventBySequence(sequence)
    return event and HttpService:JSONEncode(event) or "This event has left the live window; check the autosave file."
end
function api:CopyEvent(sequence)
    local text = self:Inspect(sequence)
    if type(clipboard) == "function" then pcall(clipboard, text) end
    return text
end
function api:Export()
    engine:Flush()
    flush()
    local snapshot = { metadata = metadata(), stats = engine:Stats(), events = engine:Entries(),
        savedEvents = savedEvents, autosaveQueueDropped = pendingDropped, autosaveFile = fileInitialized and baseName .. ".log" or nil,
        note = "Events contains the retained live window. Autosave files preserve older events." }
    local json = HttpService:JSONEncode(snapshot)
    self.LastExport = json
    local copied, saved = false, false
    local completeFile = autosave and fileInitialized and #pending == 0 and pendingDropped == 0 and type(fileAppend) == "function"
    local clipboardText = json
    if completeFile and type(fileRead) == "function" then
        local readOK, fullLog = pcall(fileRead, baseName .. ".log")
        if readOK and type(fullLog) == "string" then clipboardText = fullLog end
    end
    if type(clipboard) == "function" then copied = pcall(clipboard, clipboardText) end
    if completeFile then
        saved = true
        lastExport = baseName .. ".log"
    elseif type(fileWrite) == "function" then
        local path = baseName .. "-window.log"
        saved = pcall(fileWrite, path, json)
        if saved then lastExport = path end
    end
    if not copied and not saved then print(json) end
    message(saved and ("Log saved: " .. lastExport .. ". Send that file here.")
        or ("Captured " .. #snapshot.events .. " events" .. (copied and " to clipboard." or " in the console.")))
    return json
end
function api:SaveLog()
    return self:Export()
end
function api:GetState()
    local stats = engine:Stats()
    local events = engine:Entries(previewCursor)
    for _, event in ipairs(events) do
        local remote = event.remote
        local name = remote and remote.path or event.kind
        if type(name) ~= "string" then name = event.kind end
        table.insert(preview, { sequence = event.sequence, time = event.time or event.elapsed or 0, kind = event.kind,
            direction = event.direction, name = name, label = event.label,
            summary = event.status or event.kind })
        if #preview > 30 then table.remove(preview, 1) end
        previewCursor = math.max(previewCursor, event.sequence)
    end
    return { recording = stats.recording, label = label, status = status, count = stats.count,
        dropped = stats.dropped + (stats.queueDropped or 0), elapsed = stats.elapsed, outgoing = stats.outgoing, incoming = stats.incoming,
        interactions = stats.interactions, returns = stats.returns, includeIncoming = stats.includeIncoming,
        allReplicated = stats.allReplicated, filter = stats.filter, autosave = autosave, lastExport = lastExport,
        events = table.clone(preview) }
end
function api:Destroy()
    if not alive then return end
    engine:Stop()
    flush()
    alive = false
    engine:Destroy()
    for _, connection in ipairs(connections) do connection:Disconnect() end
    for _, list in pairs(watched) do for _, connection in ipairs(list) do connection:Disconnect() end end
    table.clear(connections)
    table.clear(watched)
    if dashboard then dashboard:Destroy() end
    if env.KarinderyaGameplayRecorder == self then env.KarinderyaGameplayRecorder = nil end
end

