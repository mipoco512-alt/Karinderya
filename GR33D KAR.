local THROW_WORDS = { "throw", "dump", "toss", "deposit", "dispose" }
local function findGarbageTruck()
    local _, hrp = charParts()
    local best, bestD = nil, math.huge
    local function consider(inst)
        local pos = anchorOf(inst)
        local d = (hrp and pos) and (hrp.Position - pos).Magnitude or math.huge
        if d < bestD then best, bestD = inst, d end
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local cur, truckNamed = obj.Parent, nil
            while cur and cur ~= Workspace do
                if (cur:IsA("Model") or cur:IsA("Folder")) and normName(cur.Name):find("truck", 1, true) then truckNamed = cur break end
                cur = cur.Parent
            end
            if truckNamed then consider(truckNamed)
            elseif normName(obj.ObjectText):find("truck", 1, true) and obj.Parent and obj.Parent ~= Workspace then consider(obj.Parent) end
        elseif obj:IsA("Model") or obj:IsA("BasePart") then
            local n = normName(obj.Name)
            if n:find("garbagetruck", 1, true) or n:find("trashtruck", 1, true) or n:find("dumptruck", 1, true) then
                if obj:FindFirstChildWhichIsA("ProximityPrompt", true) or obj:FindFirstChildWhichIsA("ClickDetector", true) then consider(obj) end
            elseif n == "truck" then
                local p = obj.Parent
                while p and p ~= Workspace do
                    if normName(p.Name):find("garbagetruck", 1, true) then consider(obj) break end
                    p = p.Parent
                end
            end
        end
    end
    return best
end
local function printTruckDiagnostics()
    if os.clock() - (TRASH.dbgAt or -math.huge) < 20 then return end
    TRASH.dbgAt = os.clock()
    local throwCount, shown = 0, 0
    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and normName(p.ActionText):find("throw", 1, true) then throwCount += 1 end
    end
    print("[Karinderya][Trash] no truck found. Throw prompts in workspace: " .. throwCount)
    for _, o in ipairs(Workspace:GetDescendants()) do
        if shown >= 10 then break end
        if (o:IsA("Model") or o:IsA("Folder")) and normName(o.Name):find("truck", 1, true) then
            shown += 1
            print("   " .. o:GetFullName() .. " [" .. o.ClassName .. "]")
        end
    end
end
local BAG = { skip = setmetatable({}, { __mode = "k" }), item = nil }
local function isBagName(name)
    local n = tostring(name):lower():gsub("%s+", "")
    if n:find("hat", 1, true) or n:find("christmas", 1, true) or n:find("elf", 1, true) or n:find("backpack", 1, true) then return false end
    return n:match("^bag%d*$") ~= nil or n:find("garbagebag", 1, true) ~= nil or n:find("trashbag", 1, true) ~= nil
end
local function inventorySet()
    local set = {}
    for _, c in ipairs(containers()) do
        for _, t in ipairs(c:GetChildren()) do
            if (t:IsA("Tool") or t:IsA("Accessory") or t:IsA("Model")) and not t:GetAttribute("IsFood") then set[t] = true end
        end
    end
    return set
end
local function heldBag()
    local item = BAG.item
    if item and item.Parent and (item.Parent == Me.Character or item.Parent == Me:FindFirstChild("Backpack")) then return item end
    BAG.item = nil
    for _, c in ipairs(containers()) do
        for _, t in ipairs(c:GetChildren()) do
            if (t:IsA("Tool") or t:IsA("Accessory")) and isBagName(t.Name) and not t:GetAttribute("IsFood") and not t:GetAttribute("OrderKey") then
                BAG.item = t
                return t
            end
        end
    end
    return nil
end
local function worldBagPrompt()
    local _, hrp = charParts()
    local now, best, bestD = os.clock(), nil, math.huge
    for _, p in ipairs(Workspace:GetDescendants()) do
        if p:IsA("ProximityPrompt") and p.Enabled and (BAG.skip[p] or 0) < now
            and normName(p.ActionText):find("pick", 1, true) and isBagName(p.ObjectText)
            and not (Me.Character and p:IsDescendantOf(Me.Character)) then
            local pos = promptAnchor(p)
            local d = (hrp and pos) and (hrp.Position - pos).Magnitude or math.huge
            if d < bestD then best, bestD = p, d end
        end
    end
    return best
end
local function findWorldBag()
    local _, hrp = charParts()
    local now, best, bestD = os.clock(), nil, math.huge
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and isBagName(obj.Name) and not (Me.Character and obj:IsDescendantOf(Me.Character)) then
            local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
            if prompt and prompt.Enabled and (BAG.skip[prompt] or 0) < now then
                local pos = anchorOf(obj)
                local d = (hrp and pos) and (hrp.Position - pos).Magnitude or math.huge
                if d < bestD then best, bestD = prompt, d end
            end
        end
    end
    return best
end
local function countWorldBags()
    local n = 0
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if (obj:IsA("Model") or obj:IsA("BasePart")) and isBagName(obj.Name)
            and not (Me.Character and obj:IsDescendantOf(Me.Character)) then
            n += 1
        end
    end
    return n
end
local function useTrashPrompt(targetObj)
    local prompt = targetObj:FindFirstChildWhichIsA("ProximityPrompt", true)
    local click  = targetObj:FindFirstChildWhichIsA("ClickDetector", true)
    local teleportTarget = targetObj
    if prompt and prompt.Parent and prompt.Parent:IsA("BasePart") then teleportTarget = prompt.Parent end
    safeTeleport(anchorOf(teleportTarget))
    task.wait(0.3)
    if prompt then
        pcall(function() prompt.MaxActivationDistance = 20 end)
        pressPromptFast(prompt, false)
        pcall(fireproximityprompt, prompt)
    end
    if click then pcall(fireclickdetector, click) end
    task.wait(0.5)
end
local function isRegularTrash(obj)
    if not obj or not obj.Parent or not (obj:IsA("Model") or obj:IsA("BasePart")) then return false end
    if isBagName(obj.Name) then return false end
    local prompt = obj:FindFirstChildWhichIsA("ProximityPrompt", true)
    local click  = obj:FindFirstChildWhichIsA("ClickDetector", true)
    if not prompt and not click then return false end
    local parent = obj.Parent
    while parent do if parent.Name == "GlobalTrashSpawner" then return true end parent = parent.Parent end
    local name = obj.Name:lower()
    return name:find("trash") or name:find("dirt") or name:find("plastic")
end
local function throwPromptOf(truck)
    local firstThrow, firstEnabled, fallback
    for _, p in ipairs(truck:GetDescendants()) do
        if p:IsA("ProximityPrompt") then
            if hasWord(normName(p.ActionText), THROW_WORDS) then
                if p.Enabled then firstEnabled = firstEnabled or p end
                firstThrow = firstThrow or p
            end
            fallback = fallback or p
        end
    end
    return firstEnabled or firstThrow or fallback
end
local function throwBagToTruck(truck, bag)
    local char, hrp, hum = charParts()
    if not char or not hrp then return false, "no character" end
    if bag.Parent ~= char and bag:IsA("Tool") and hum then
        for _, t in ipairs(char:GetChildren()) do
            if t:IsA("Tool") and t ~= bag then
                pcall(function() hum:UnequipTools() end)
                break
            end
        end
        pcall(function() hum:EquipTool(bag) end)
        waitFor(function() return bag.Parent == char end, 0.8)
    end
    local function gone() return heldBag() == nil end
    if gone() then return true, "already gone" end
    local prompts = {}
    for _, p in ipairs(truck:GetDescendants()) do
        if p:IsA("ProximityPrompt") and hasWord(normName(p.ActionText), THROW_WORDS) then
            if p.Enabled then table.insert(prompts, 1, p) else table.insert(prompts, p) end
        end
    end
    for _, tp in ipairs(prompts) do
        if gone() then return true, "threw" end
        if tp.Parent and tp.Enabled then
            local tpPos = promptAnchor(tp)
            if tpPos then
                if not inReach(tp) then
                    safeTeleport(tpPos, tp.MaxActivationDistance)
                    task.wait(0.1)
                end
                for _ = 1, 3 do
                    if gone() then return true, "threw" end
                    if not (tp.Parent and tp.Enabled) then break end
                    pressPromptFast(tp, false)
                    if waitFor(gone, 1.0) then return true, "threw (" .. tostring(tp.ActionText) .. ")" end
                    fire(tp)
                    if waitFor(gone, 0.5) then return true, "threw fire" end
                    task.wait(0.1)
                end
            end
        end
    end
    local cd = truck:FindFirstChildWhichIsA("ClickDetector", true)
    if cd then
        pcall(fireclickdetector, cd)
        if waitFor(gone, 1.0) then return true, "threw (click)" end
    end
    if remote("BagThrown") then
        fireRemote("BagThrown", truck)
        if waitFor(gone, 1.5) then return true, "threw (remote)" end
    end
    if #prompts == 0 then return false, "truck has no throw prompt" end
    return false, "throw not confirmed"
end
local function pickBagOnce(prompt)
    local pos = promptAnchor(prompt)
    if not pos then
        BAG.skip[prompt] = os.clock() + 3
        return false, "no anchor"
    end
    if not inReach(prompt) then
        local ok, why = safeTeleport(pos, prompt.MaxActivationDistance)
        if not ok then
            BAG.skip[prompt] = os.clock() + 3
            return false, "teleport: " .. tostring(why)
        end
        task.wait(0.1)
    end
    local before = inventorySet()
    local function picked()
        if not prompt.Parent then return true end
        for t in pairs(inventorySet()) do if not before[t] then BAG.item = t return true end end
        return false
    end
    for _ = 1, 3 do
        if not (prompt.Parent and prompt.Enabled) then break end
        pressPromptFast(prompt, false)
        if waitFor(picked, 1.5) then return true, "picked up" end
        fire(prompt)
        if waitFor(picked, 1.0) then return true, "picked up (fire)" end
    end
    BAG.skip[prompt] = os.clock() + 2
    return false, "pickup not confirmed"
end
local function truckPresent()
    local truck = findGarbageTruck()
    if truck then
        T.truck = truck
        if not T.truckArrivalTime then T.truckArrivalTime = os.clock() end
        T.truckLastSeen = os.clock()
        return true
    end
    if T.truckLastSeen and os.clock() - T.truckLastSeen <= 2 then
        return T.truck ~= nil and T.truck.Parent ~= nil
    end
    T.truck = nil
    T.truckArrivalTime = nil
    return false
end
local function trashTick()
    if isRunawayActive() then return 0.5 end
    local char, hrp, hum = charParts()
    if not hrp then M.trash.status = "no character" return 1 end
    local truckOk = truckPresent()
    local truck = T.truck
    local isNight = nightNow()
    if truckOk and truck then
        local settled = os.clock() - (T.truckArrivalTime or os.clock()) >= CFG.TRUCK_SETTLE_TIME
        if not settled then
            M.trash.status = string.format("truck settling... %.1fs", CFG.TRUCK_SETTLE_TIME - (os.clock() - (T.truckArrivalTime or os.clock())))
            return 0.3
        end
    else
        printTruckDiagnostics()
        if not isNight and not heldBag() then
            M.trash.status = "waiting for the truck"
            return 2
        end
    end

    if truck and truck.Parent then
        local cycles, picks, throws, noProgress = 0, 0, 0, 0
        while cycles < 60 do
            if isRunawayActive() then
                M.trash.status = "paused (runaway) after " .. throws .. " throws"
                return 0.3
            end
            if not truck.Parent then T.truck = nil break end
            if os.clock() < TRASH.cooldownUntil then
                M.trash.status = string.format("failsafe cooldown %.0fs", TRASH.cooldownUntil - os.clock())
                return 0.5
            end

            local bag = heldBag()
            local progressed = false

            if bag then
                M.trash.status = "throwing bag #" .. (throws + 1)
                local ok, thrown, how = withMove("trash", function()
                    if isRunawayActive() then return false, "runaway" end
                    return throwBagToTruck(truck, bag)
                end)
                if ok and thrown then
                    TRASH.fails = 0
                    BAG.item = nil
                    throws += 1
                    progressed = true
                    M.trash.status = "threw bag #" .. throws .. " (" .. tostring(how) .. ")"
                    log("trash", "threw bag #" .. throws .. " (" .. tostring(how) .. ")", THEME.green)
                    task.wait(math.random(15, 30) / 100) -- Randomized throw delay
                elseif ok then
                    TRASH.fails += 1
                    M.trash.status = "throw failed " .. TRASH.fails .. "/3: " .. tostring(how)
                    log("trash", M.trash.status, THEME.orange)
                    if TRASH.fails >= 3 then
                        if hum then pcall(function() hum:UnequipTools() end) end
                        TRASH.fails = 0
                        TRASH.cooldownUntil = os.clock() + 8
                        log("trash", "failsafe: bag released, retry in 8s", THEME.red)
                        return 0.5
                    end
                    task.wait(0.2)
                else
                    M.trash.status = tostring(thrown)
                    task.wait(0.2)
                end
            else
                local bagPrompt = worldBagPrompt() or findWorldBag()
                if not bagPrompt then
                    local remaining = countWorldBags()
                    if remaining > 0 then
                        M.trash.status = string.format("%d bag(s) on ground, waiting for prompt", remaining)
                        task.wait(0.3)
                        bagPrompt = worldBagPrompt() or findWorldBag()
                    end
                    if not bagPrompt then break end
                end
                M.trash.status = "picking up bag #" .. (picks + 1)
                local ok, got = withMove("trash", function()
                    if isRunawayActive() then return false, "runaway" end
                    return pickBagOnce(bagPrompt)
                end)
                if ok and got then
                    picks += 1
                    progressed = true
                    M.trash.status = "picked bag #" .. picks
                    task.wait(math.random(10, 20) / 100)
                else
                    task.wait(0.15)
                end
            end

            if progressed then
                noProgress = 0
            else
                noProgress += 1
                if noProgress >= 5 then break end
            end
            cycles += 1
        end

        if heldBag() or worldBagPrompt() or findWorldBag() then
            M.trash.status = string.format("%d thrown, %d picked, more bags available", throws, picks)
            return 0.15
        end
    end

    local closestTrash, closestDist = nil, math.huge
    local searchArea = workspace:FindFirstChild("GlobalTrashSpawner") or workspace
    for _, obj in ipairs(searchArea:GetDescendants()) do
        if isRegularTrash(obj) then
            local pos = anchorOf(obj)
            if pos then
                local dist = (pos - hrp.Position).Magnitude
                if dist < closestDist then closestDist, closestTrash = dist, obj end
            end
        end
    end
    if closestTrash then
        M.trash.status = "cleaning " .. closestTrash.Name
        useTrashPrompt(closestTrash)
        return 0.5
    end
    M.trash.status = "nothing to clean"
    return 2
end

