local function configureCapture()
    capture:Stop()
    if not running then return end
    capture:SetIncludeIncoming(options.incoming)
    local ok, reason = true, nil
    if options.outgoing then ok, reason = capture:Start()
    elseif options.incoming then ok, reason = capture:StartIncoming() end
    if not ok then record("warning", "capability.remote", tostring(reason or "Remote capture unavailable")) end
    local state = capture:Stats()
    if options.outgoing and not state.outgoingActive then
        record("warning", "capability.outgoing", state.outgoingError or "Outbound hooks unavailable; object observation remains active")
    end
