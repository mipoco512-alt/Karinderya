local PLOT = { cache = nil, at = -math.huge, locked = nil }
local function ownedByMe(inst)
    local keys = { [Me.Name] = true, [Me.DisplayName] = true, [tostring(Me.UserId)] = true }
    if keys[inst.Name] then return true end
    for _, v in pairs(inst:GetAttributes()) do if keys[tostring(v)] then return true end end
    for _, ch in ipairs(inst:GetChildren()) do if ch:IsA("ValueBase") then local ok, val = pcall(function() return ch.Value end) if ok and (val == Me or keys[tostring(val)]) then return true end end end
    return false
end
local function plotGet()
    if PLOT.locked and PLOT.locked.Parent then return PLOT.locked end
    if PLOT.cache and PLOT.cache.Parent and os.clock() - PLOT.at < 5 then return PLOT.cache end
    PLOT.at = os.clock() local hrp = Me.Character and Me.Character:FindFirstChild("HumanoidRootPart") local best, bestOwned, bestD
    for _, c in ipairs(Workspace:GetChildren()) do
        if (c:IsA("Model") or c:IsA("Folder")) and c:FindFirstChild("Serve") and c:FindFirstChild("DiningPlot1") then
            local owned = ownedByMe(c) local p = anchorOf(c:FindFirstChild("Serve")) local d = (hrp and p) and (hrp.Position - p).Magnitude or math.huge
            if not best or (owned and not bestOwned) or (owned == bestOwned and d < bestD) then best, bestOwned, bestD = c, owned, d end
        end
    end
    if best ~= PLOT.cache then PLOT.cache = best if best then log("plot", "using " .. best.Name .. (bestOwned and " (owner match)" or " (nearest)"), THEME.blue) end end
    return best
end
local function tablesOfPlot(plot)
    local out = {} if not plot then return out end local folders = {} for _, f in ipairs(plot:GetChildren()) do if f.Name:match("^DiningPlot") then table.insert(folders, f) end end
    table.sort(folders, function(a, b) return a.Name < b.Name end)
    for _, f in ipairs(folders) do local list = {} for _, t in ipairs(f:GetChildren()) do local n = tonumber(t.Name:match("^Table(%d+)$")) if n then table.insert(list, { n = n, t = t }) end end table.sort(list, function(a, b) return a.n < b.n end) for _, e in ipairs(list) do table.insert(out, e.t) end end
    return out
end
local NIGHT = { value = false, source = "?", at = -math.huge }
local function nightNow()
    if os.clock() - NIGHT.at < 3 then return NIGHT.value, NIGHT.source end
    NIGHT.at = os.clock() local clock = Lighting.ClockTime local value, source = (clock >= 18 or clock < 6), string.format("clock %.1f", clock)
    local plot = PLOT.cache if plot then for _, p in ipairs(plot:GetDescendants()) do if p:IsA("ProximityPrompt") and p.Enabled and normName(p.ActionText):find("closednight", 1, true) then value, source = true, "store prompt" break end end end
    NIGHT.value, NIGHT.source = value, source return value, source
end

