function api:Start()
    if not alive then return false end
    if recording then log("Stop recording before starting automation."); return false end
    if not selectedPlot or not selectedPlot:IsDescendantOf(Workspace) then log("Select a restaurant first."); return false end
    if running then return true end
    running, revision = true, revision + 1
    stockSpent = 0
    log("Running in " .. selectedPlot.Name)
    return true
end

function api:SetCategory(category, enabled)
    assert(categories[category] ~= nil, "Unknown category")
    categories[category] = enabled == true
    if category == "stock" and operations then operations:SetSetting("autoSelectedItems", enabled == true) end
    revision += 1
    release()
end

local function changedSettings()
    revision += 1
    release()
end

function api:SetRarityFilter(value)
    filterEnabled = value == true
    changedSettings()
end

function api:SetRarity(name, value)
    local key = Features.normalize(name)
    if key ~= "" then allowedRarities[key] = value == true end
    changedSettings()
end

function api:SetAllowUnknown(value)
    allowUnknown = value == true
    changedSettings()
end

function api:SetTweenSpeed(value)
    if type(value) ~= "number" or value ~= value then return end
    CONFIG.TweenSpeed = math.clamp(value, 12, 100)
    changedSettings()
end

function api:SetStockSelected(key, value)
    local row = catalog:Get(key)
    selectedStock[key] = value == true and row and row.fingerprint or nil
    if row and operations then operations:SetSelection(row.root and row.root.Name == "Grocery" and "ingredients" or "shopItems", key, value) end
    changedSettings()
end

function api:SetSetting(key, value)
    if not operations:SetSetting(key, value) then return false end
    if key == "autoSelectedItems" then categories.stock = value == true end
    changedSettings()
    return true
end

function api:SetSelection(group, key, value)
    operations:SetSelection(group, key, value)
    if group == "ingredients" or group == "shopItems" then
        local row = catalog:Get(key)
        selectedStock[key] = value == true and row and row.fingerprint or nil
    end
    changedSettings()
end

function api:RunAction(action)
    if action == "restockAll" or action == "buySelected" then
        local pending = {}
        for _, row in ipairs(catalog:Rows()) do
            local ingredient = row.root and row.root.Name == "Grocery"
            local selected = operations:IsSelected("shopItems", row.key) or operations:IsSelected("ingredients", row.key)
            if row.supported and ((action == "restockAll" and ingredient) or (action == "buySelected" and selected)) then
                pending[row.key] = row.fingerprint
            end
        end
        if next(pending) == nil then log("No eligible items selected or discovered for this purchase."); return false end
        manualStock = { pending = pending, expires = os.clock() + 90, action = action }
    elseif not operations:Request(action) then
        log("No supported interaction is ready for " .. tostring(action) .. ". Use Diagnostics to record it.")
        return false
    end
    if not running then
        if not self:Start() then manualStock = nil; operations:CancelRequests(); return false end
    end
    changedSettings()
    log("Queued " .. action .. "; cash reserve and selection limits apply.")
    return true
end

function api:SetStockLimit(value)
    if type(value) ~= "number" or value ~= value then return end
    CONFIG.StockLimit = math.clamp(math.floor(value), 1, 100)
    changedSettings()
end

function api:Record(enabled)
    self:Stop()
    if enabled then
        local ok, err = recorder:Start()
        recording = ok == true
        log(recording and "Recording. Perform ONE service cycle manually, then stop recording." or tostring(err))
    else
        recorder:Stop()
        recording = false
        log("Recording stopped. Export includes observed remote calls.")
    end
    return recording
end

local function attributes(instance)
    local result = {}
    for key, value in pairs(instance:GetAttributes()) do
        local kind = typeof(value)
        result[key] = (kind == "string" or kind == "number" or kind == "boolean") and value or tostring(value)
    end
    return result
end

function api:Dump()
    local data = { version = 2, placeId = game.PlaceId, selectedPlot = selectedPlot and selectedPlot:GetFullName(),
        attempts = attempted, status = lastStatus, plots = {}, prompts = {}, npcs = {}, remotes = {}, buttons = {},
        recordedCalls = recorder:Entries(), history = history }
    for _, plot in ipairs(plots) do
        if plot.Parent then table.insert(data.plots, { path = plot:GetFullName(), attributes = attributes(plot) }) end
    end
    for prompt, state in pairs(prompts) do
        if prompt:IsDescendantOf(Workspace) and #data.prompts < 350 then
            local category, reason = classify(prompt)
            table.insert(data.prompts, { path = prompt:GetFullName(), action = prompt.ActionText, object = prompt.ObjectText,
                enabled = prompt.Enabled, inScope = inScope(prompt), category = category, reason = reason,
                holdDuration = prompt.HoldDuration, maxDistance = prompt.MaxActivationDistance,
                tries = state.tries, attributes = attributes(prompt) })
        end
    end
    local npcFolder = Workspace:FindFirstChild("ClientNPCs")
    if npcFolder then
        for i, npc in ipairs(npcFolder:GetChildren()) do
            if i > 60 then break end
            local children = {}
            for j, child in ipairs(npc:GetChildren()) do
                if j > 30 then break end
                table.insert(children, { name = child.Name, class = child.ClassName })
            end
            table.insert(data.npcs, { path = npc:GetFullName(), attributes = attributes(npc), children = children,
                rarity = Features.rarity(npc), runaway = Features.runawayState(npc) })
        end
    end
    local remotesRoot = ReplicatedStorage:FindFirstChild("Remotes")
    if remotesRoot then
        for _, instance in ipairs(remotesRoot:GetDescendants()) do
            if #data.remotes >= 200 then break end
            if instance:IsA("RemoteEvent") or instance:IsA("RemoteFunction") or instance:IsA("UnreliableRemoteEvent") then
                table.insert(data.remotes, { path = instance:GetFullName(), class = instance.ClassName })
            end
        end
    end
    for _, widget in ipairs(player.PlayerGui:GetDescendants()) do
        if #data.buttons >= 120 then break end
        if widget:IsA("GuiButton") and not widget:FindFirstAncestor("KarinderyaDashboard") then
            local label = widget:IsA("TextButton") and widget.Text or ""
            local category = Policy.classify(label, widget.Name, widget.Parent.Name, CONFIG.PromptOverrides)
            if category then
                local shown, ancestor = true, widget
                while ancestor and ancestor ~= player.PlayerGui do
                    if ancestor:IsA("GuiObject") and not ancestor.Visible then shown = false end
                    if ancestor:IsA("ScreenGui") and not ancestor.Enabled then shown = false end
                    ancestor = ancestor.Parent
                end
                table.insert(data.buttons, { path = widget:GetFullName(), text = label, shown = shown, category = category })
            end
        end
    end
    data.automation = self:GetState()
    if data.automation.settings then
        data.automation.settings.webhookUrl = data.automation.settings.webhookUrl ~= "" and "[configured]" or ""
    end
    return HttpService:JSONEncode(data)
end

function api:Export()
    local json = self:Dump()
    self.LastDump = json
    local copied, saved = false, false
    local clipboard = env.setclipboard or setclipboard
    local write = env.writefile or writefile
    if type(clipboard) == "function" then copied = pcall(clipboard, json) end
    if type(write) == "function" then saved = pcall(write, "karinderya-diagnostics.json", json) end
    if not copied and not saved then print(json) end
    log("Diagnostic export: " .. (copied and "clipboard " or "") .. (saved and "karinderya-diagnostics.json" or "")
        .. (not copied and not saved and "console / KarinderyaAutomation.LastDump" or ""))
    return json
end

function api:Destroy()
    if not alive then return end
    self:Stop()
    alive = false
    recorder:Destroy()
    if utilities then utilities:Destroy() end
    for instance in pairs(prompts) do unindex(instance) end
    for _, connection in ipairs(connections) do connection:Disconnect() end
    table.clear(connections)
    for _, list in pairs(npcObservers) do for _, connection in ipairs(list) do connection:Disconnect() end end
    table.clear(npcObservers)
    if dashboard then dashboard:Destroy() end
    if env.KarinderyaAutomation == self then env.KarinderyaAutomation = nil end
end

local function weapon()
    local model = player.Character
    local backpack = player:FindFirstChild("Backpack")
    for _, name in ipairs(CONFIG.WeaponNames) do
        local tool = model and model:FindFirstChild(name) or nil
        if not tool and backpack then tool = backpack:FindFirstChild(name) end
        if tool and tool:IsA("Tool") then return tool end
    end
    return nil
end

local function markRunaway(npc, source)
    if not npc or not npcOf(npc) or not ownershipMatches(npc) then return end
    local tracked = trackedNPCs[npc]
    if not npcInPlot(npc) and not (tracked and tracked.plot == selectedPlot and os.clock() - tracked.acceptedAt < 90) then return end
    if runaways[npc] then return end
    runaways[npc] = { expires = os.clock() + CONFIG.ChaseTimeout, swings = 0, nextAt = 0, source = source }
    if running and categories.chase then
        revision += 1
        release()
        log("Runaway customer detected. Prioritizing recovery.")
    end
end

local function watchNPC(npc)
    if npcObservers[npc] or not npcOf(npc) then return end
    local function update()
        if not alive or not npc.Parent then return end
        local rarity = Features.rarity(npc)
        if rarity then observedRarities[rarity] = true end
        local state = Features.runawayState(npc)
        if state == true then markRunaway(npc, "attribute")
        elseif state == false then runaways[npc] = nil end
    end
    npcObservers[npc] = { npc.AttributeChanged:Connect(update) }
    update()
end

local function refreshNPCs()
    local folder = Workspace:FindFirstChild("ClientNPCs")
    if folder then
        for _, npc in ipairs(folder:GetChildren()) do
            if npc:IsA("Model") then
                watchNPC(npc)
                local rarity = Features.rarity(npc)
                if rarity then observedRarities[rarity] = true end
                local state = Features.runawayState(npc)
                if state == true then markRunaway(npc, "attribute")
                elseif state == false then runaways[npc] = nil end
            end
        end
    end
    for npc, list in pairs(npcObservers) do
        if not folder or npc.Parent ~= folder then
            for _, connection in ipairs(list) do connection:Disconnect() end
            npcObservers[npc], trackedNPCs[npc], runaways[npc] = nil, nil, nil
        end
    end
end

local function findRunaway()
    if not categories.chase or not weapon() then return nil end
    local _, root = character()
    if not root then return nil end
    local best, distance = nil, CONFIG.ChaseDistance
    for npc, info in pairs(runaways) do
        if npcOf(npc) and ownershipMatches(npc) and info.expires > os.clock()
            and info.nextAt <= os.clock() and info.swings < CONFIG.MaxSwingsPerCustomer then
            local target = position(npc)
            local state = Features.runawayState(npc)
            if target and state ~= false and (target - root.Position).Magnitude < distance then
                best, distance = npc, (target - root.Position).Magnitude
            end
        end
    end
    return best
end

local function chase(npc, token)
    local model, root, humanoid = character()
    local tool, info = weapon(), runaways[npc]
    if not root or not tool or not info or humanoid.Sit then return end
    local function valid()
        return alive and running and revision == token and categories.chase and player.Character == model
            and humanoid.Health > 0 and npcOf(npc) ~= nil and ownershipMatches(npc)
            and runaways[npc] == info and os.clock() < info.expires
            and info.swings < CONFIG.MaxSwingsPerCustomer and Features.runawayState(npc) ~= false
    end
    weaponRestore = { model = model, humanoid = humanoid, weapon = tool, previous = model:FindFirstChildOfClass("Tool") }
    humanoid:EquipTool(tool)
    activeTool, activeHumanoid, savedAutoRotate = tool, humanoid, humanoid.AutoRotate
    humanoid.AutoRotate = false
    humanoid:MoveTo(root.Position)
    local lastSwing = -math.huge
    log("Chasing " .. npc.Name .. " with " .. tool.Name)
    while valid() do
        local target = position(npc)
        if not target then break end
        local delta = target - root.Position
        if delta.Magnitude > CONFIG.ChaseDistance then break end
        if delta.Magnitude <= CONFIG.HitDistance then
            local facing = Vector3.new(target.X, root.Position.Y, target.Z)
            if (facing - root.Position).Magnitude > 0.1 then root.CFrame = CFrame.lookAt(root.Position, facing) end
            if os.clock() - lastSwing >= CONFIG.SwingCooldown and tool.Parent == model and tool.Enabled then
                -- Activate the real equipped weapon; its own game code submits the hit.
                tool:Activate()
                swings += 1
                info.swings += 1
                lastSwing = os.clock()
                task.wait(0.1)
                tool:Deactivate()
            end
            task.wait(0.07)
        else
            local offset = delta.Unit * math.min(CONFIG.TweenSpeed * 0.25, math.max(0, delta.Magnitude - CONFIG.HitDistance * 0.65))
            local destination = root.Position + offset
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = { model, npc }
            if Workspace:Raycast(root.Position, offset, params) then
                local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true })
                local ok = pcall(function() path:ComputeAsync(root.Position, target) end)
                if not valid() then break end
                local points = ok and path.Status == Enum.PathStatus.Success and path:GetWaypoints() or {}
                local nextPoint = points[2]
                if not nextPoint then log("Recovery route blocked; retrying shortly."); break end
                destination = nextPoint.Position + Vector3.new(0, humanoid.HipHeight + root.Size.Y / 2, 0)
                local step = destination - root.Position
                if step.Magnitude > CONFIG.TweenSpeed * 0.25 then destination = root.Position + step.Unit * CONFIG.TweenSpeed * 0.25 end
            end
            local duration = math.max(0.05, (destination - root.Position).Magnitude / CONFIG.TweenSpeed)
            local facing = Vector3.new(target.X, destination.Y, target.Z)
            local goal = (facing - destination).Magnitude > 0.1 and CFrame.lookAt(destination, facing) or CFrame.new(destination)
            local tween = TweenService:Create(root, TweenInfo.new(duration, Enum.EasingStyle.Linear), { CFrame = goal })
            activeTween = tween
            root.AssemblyLinearVelocity = Vector3.zero
            tween:Play()
            local deadline = os.clock() + duration
            repeat task.wait(0.04) until not valid() or os.clock() >= deadline
            tween:Cancel()
            if activeTween == tween then activeTween = nil end
        end
    end
    info.nextAt = os.clock() + 3
    release()
end

local boundRemotes = setmetatable({}, { __mode = "k" })
local function bindRemote(instance)
    if boundRemotes[instance] or not instance:IsA("RemoteEvent") then return end
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes or not instance:IsDescendantOf(remotes) then return end
    if instance.Name == "CustomerRanAwayEvent" then
        boundRemotes[instance] = true
        chaseEventAvailable = true
        connect(instance.OnClientEvent, function(...)
            local folder = Workspace:FindFirstChild("ClientNPCs")
            if not folder then return end
            local resolved
            for i = 1, select("#", ...) do
                local candidate = Features.resolveNPC(select(i, ...), folder)
                if candidate and resolved and candidate ~= resolved then return end
                if candidate then resolved = candidate end
            end
            if resolved then markRunaway(resolved, "event") end
        end)
    elseif instance.Name == "ShopRestocked" then
        boundRemotes[instance] = true
        connect(instance.OnClientEvent, function() lastCatalogRefresh = -math.huge end)
    end
end

function api:GetState()
    local plotNames, rarityNames, rows, logs, allowed = {}, {}, {}, {}, {}
    for _, plot in ipairs(plots) do if plot:IsDescendantOf(Workspace) then table.insert(plotNames, plot.Name) end end
    for rarity in pairs(observedRarities) do table.insert(rarityNames, rarity) end
    for rarity, enabled in pairs(allowedRarities) do allowed[rarity] = enabled end
    table.sort(rarityNames)
    local supportedStock = 0
    for _, row in ipairs(catalog:Rows()) do
        local selected = selectedStock[row.key] == row.fingerprint
        if row.supported then supportedStock += 1 end
        table.insert(rows, { key = row.key, name = row.name, stock = row.stock, selected = selected, status = row.status })
    end
    for _, entry in ipairs(history) do table.insert(logs, entry.message) end
    local selectedRarities = 0
    for _, enabled in pairs(allowedRarities) do if enabled then selectedRarities += 1 end end
    local customerStatus = not filterEnabled and "Accepting all rarities" or (selectedRarities > 0 and selectedRarities .. " rarities selected" or "Choose customer rarities")
    if #rarityNames == 0 and filterEnabled then customerStatus = "Waiting for customer rarity data" end
    local operationStatus = operations:Status()
    operationStatus.longRange = operations.Settings.longRange and "Prompt display extended; movement uses actual interaction range" or "Normal prompt range"
    operationStatus.antiAFK = operations.Settings.antiAFK and "Idle input enabled" or "Off"
    operationStatus.webhook = not operations.Settings.webhookEnabled and "Off" or (operations.Settings.webhookUrl == "" and "Enter a webhook URL" or "Configured for session summaries")
    operationStatus.restockAll = supportedStock > 0 and "Loaded ingredients only; reserve applies" or "No stock purchase prompts discovered"
    operationStatus.buySelected = supportedStock > 0 and "Select items; stock and cash must be readable" or "No stock purchase prompts discovered"
    local lists = operations:Lists()
    for _, group in ipairs({ "ingredients", "shopItems" }) do
        for _, item in ipairs(lists[group] or {}) do
            local row = catalog:Get(item.key)
            if row and item.selected and row.supported then
                if operations.Settings.keepCash > 0 and row.price == nil then item.status = "Price data needed to preserve cash"
                elseif operations.Settings.keepCash > 0 and operations:Cash() == nil then item.status = "Current cash balance unavailable"
                elseif group == "ingredients" and operations:Holdings(row.name) == nil then item.status = "Inventory count needed for automatic restock" end
            end
        end
    end
    return { running = running, recording = recording, plotName = selectedPlot and selectedPlot.Name or "Choose restaurant",
        plots = plotNames, status = lastStatus, attempts = attempted, swings = swings, purchases = purchases,
        rarities = rarityNames, allowedRarities = allowed, filterEnabled = filterEnabled, allowUnknown = allowUnknown,
        categories = table.clone(categories), stocks = rows, speed = CONFIG.TweenSpeed, stockLimit = CONFIG.StockLimit, stockSpent = stockSpent,
        settings = table.clone(operations.Settings), lists = lists, operationStatus = operationStatus,
        features = { customers = customerStatus, chase = weapon() and (chaseEventAvailable and "Weapon ready / listening for runaways" or "Weapon ready / watching customer state") or "Pan or Trowel required",
            trash = "Trash this trip: " .. trashTrip .. " / " .. operations.Settings.trashPerTrip,
            stock = supportedStock > 0 and supportedStock .. " purchase prompts found" or "Open the shop to discover stock" }, logs = logs }
end

local function buyNext(token)
    if stockSpent >= CONFIG.StockLimit then return false end
    if manualStock and os.clock() > manualStock.expires then manualStock = nil end
    local _, root = character()
    if not root then return false end
    local function wanted(row)
        if manualStock and manualStock.pending[row.key] == row.fingerprint then return true end
        local ingredient = row.root and row.root.Name == "Grocery"
        local group = ingredient and "ingredients" or "shopItems"
        local selected = operations:IsSelected(group, row.key)
        if not selected then return false end
        if ingredient then
            local held = operations:Holdings(row.name)
            return operations.Settings.autoIngredients and held ~= nil and held < operations.Settings.restockBelow
        end
        return operations.Settings.autoSelectedItems
    end
    local function affordable(row)
        local reserve = operations.Settings.keepCash
        local cash = operations:Cash()
        if row.price == nil or cash == nil then return reserve == 0 end
        return cash - row.price >= reserve
    end
    for _, row in ipairs(catalog:Rows()) do
        local desired = wanted(row)
        catalogSelection[row.key] = desired and row.fingerprint or nil
        local canBuy = Features.purchaseDecision(row, desired, stockSpent, CONFIG.StockLimit) and affordable(row)
        local target = row.prompt and position(row.prompt.Parent)
        if canBuy and target and (stockBackoff[row.key] or 0) <= os.clock()
            and (target - root.Position).Magnitude <= CONFIG.MaxTravel and catalog:CanAttempt(row, os.clock()) then
            local prompt = row.prompt
            local signature, fingerprintAt = fingerprint(prompt), row.fingerprint
            local function guard()
                local live = catalog:Get(row.key)
                return live and live.fingerprint == fingerprintAt and wanted(live) and affordable(live)
                    and Features.purchaseDecision(live, true, stockSpent, CONFIG.StockLimit)
                    and catalog:CanAttempt(live, os.clock())
            end
            -- Catalog performs exact label and live-stock checks immediately before input.
            local reserved = false
            local function beforeInput()
                if not guard() then return false end
                if not catalog:MarkAttempt(row.key, fingerprintAt, os.clock()) then return false end
                stockSpent += 1
                purchases += 1
                reserved = true
                if manualStock then manualStock.pending[row.key] = nil end
                return true
            end
            local function travelGuard()
                if reserved then return true end
                return guard()
            end
            log("Restock: " .. row.name)
            local reached, reason = moveToPrompt(prompt, token, signature, travelGuard)
            if reached then reached, reason = trigger(prompt, token, signature, travelGuard, beforeInput) end
            if not reached and revision == token then log("Restock paused: " .. tostring(reason)) end
            stockBackoff[row.key] = os.clock() + (reached and 10 or 8)
            release()
            return true
        end
    end
    return false
end

local operationBackoff = {}
local function performOperation(token)
    for _, candidate in ipairs(operations:Candidates()) do
        local prompt = candidate.prompt
        local _, root = character()
        local target = prompt and position(prompt.Parent)
        if prompt and prompts[prompt] and root and target and (target - root.Position).Magnitude <= CONFIG.MaxTravel
            and (operationBackoff[candidate.key] or 0) <= os.clock() and candidate.guard() then
            local signature = fingerprint(prompt)
            log("Task: " .. tostring(candidate.action) .. " / " .. prompt.ObjectText)
            local reached, reason = moveToPrompt(prompt, token, signature, candidate.guard)
            if reached then reached, reason = trigger(prompt, token, signature, candidate.guard) end
            if reached then operations:Complete(candidate) end
            operationBackoff[candidate.key] = os.clock() + (reached and 5 or 8)
            if not reached and revision == token then log("Task paused: " .. tostring(reason)) end
            release()
            return true
        end
    end
    return false
end

connect(UserInputService.InputBegan, function(input, processed)
    if input.KeyCode == Enum.KeyCode.F6 then api:Stop(); log("Stopped with F6.") end
    local key = utilities and utilities:MenuKey() or Enum.KeyCode.RightShift
    if not processed and input.KeyCode == key and dashboard then dashboard:Toggle() end
end)
connect(Workspace.DescendantAdded, function(instance)
    index(instance)
    if instance:IsA("Model") and instance.Parent == Workspace:FindFirstChild("ClientNPCs") then watchNPC(instance) end
end)
connect(Workspace.DescendantRemoving, unindex)
connect(ReplicatedStorage.DescendantAdded, bindRemote)
for _, instance in ipairs(ReplicatedStorage:GetDescendants()) do bindRemote(instance) end
connect(player.CharacterRemoving, function() api:Stop(); log("Stopped for respawn. Press Start when ready.") end)

api:Rescan()
if not alive then return api end
refreshNPCs()
catalog:Refresh()
operations:Observe(prompts, selectedPlot, catalog:Rows())
utilities = createUtilities({ Settings = operations.Settings, Player = player, Workspace = Workspace, HttpService = HttpService,
    Env = env, Log = log, GetState = function() return api:GetState() end, IsRunning = function() return running and alive end })
dashboard = createDashboard(api)
task.spawn(function()
    while alive do
        local ok, err = pcall(function()
            refreshNPCs()
            if os.clock() - lastCatalogRefresh >= 2 then catalog:Refresh(); lastCatalogRefresh = os.clock() end
            operations:Observe(prompts, selectedPlot, catalog:Rows())
            utilities:UpdatePrompts(prompts)
            utilities:Tick()
            if dashboard then dashboard:Refresh(api:GetState()) end
        end)
        if not ok then log("Discovery: " .. tostring(err)) end
        task.wait(0.75)
    end
end)
task.spawn(function()
    while alive do
        task.wait(CONFIG.TickSeconds)
        if not alive then break end
        if running then
            local token = revision
            local ok, err = pcall(function()
                local runaway = findRunaway()
                if runaway then chase(runaway, token); return end
                if buyNext(token) then return end
                if performOperation(token) then return end
                local prompt, eligible = nextPrompt()
                if not prompt then
                    if os.clock() - lastRefresh > 10 then
                        lastRefresh = os.clock()
                        log(eligible > 0 and "Waiting for the next interaction state."
                            or "Waiting for enabled tasks. Check rarity selections and feature status.")
                    end
                    return
                end
                local state = prompts[prompt]
                local generation, signature = state.generation, fingerprint(prompt)
                log(tostring(classify(prompt)) .. ": " .. prompt.ActionText .. " " .. prompt.ObjectText)
                local reached, reason = moveToPrompt(prompt, token, signature)
                if reached then
                    if current(token, prompt, signature) then reached, reason = trigger(prompt, token, signature)
                    else reached, reason = false, "Prompt changed" end
                end
                if token ~= revision or not running then return end
                if not reached then release(); log(tostring(reason)) end
                if reached then
                    if classify(prompt) == "accept" then
                        local npc = npcOf(prompt)
                        if npc then trackedNPCs[npc] = { plot = selectedPlot, acceptedAt = os.clock() } end
                    elseif classify(prompt) == "trash" then
                        local action = Policy.normalize(prompt.ActionText)
                        if action:find("throw", 1, true) or action:find("dispose", 1, true) or action:find("empty", 1, true) or action:find("drop", 1, true) then trashTrip = 0
                        else trashTrip += 1 end
                    end
                    RetryState.attempted(state, generation, os.clock(), CONFIG.ActionCooldown)
                else RetryState.moveFailed(state, generation, os.clock()) end
            end)
            if not ok then api:Stop(); log("Stopped after error: " .. tostring(err)) end
        end
    end
end)
log("Ready. Select your restaurant and rarities, then Start. F6 stops all actions.")
return api
